@printUint@i16:
 Local variables
	arg 0: number (i16/2)
	; 2 pc
	cast r0(i32), r0(i16)
	call printUint@i32[r0]

@printIntLf@bool:
 Local variables
	arg 0: number (bool/1)

@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)

@printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	; 8 pc
	move r8, r0
	; 127:2 if number < 0
	const r10, 0
	lt r10, r8, r10
	branch r10, false, @if_1_end, @if_1_then
	const r0, 45
	call printChar@u8[r0]
	neg r8, r8
@if_1_end:
	move r0, r8
	call printUint@i16[r0]
	const r0, 13
	call printChar@u8[r0]

@main:
 Local variables
	var 0: d (i16/2)
	var 1: f (bool/1)
	; 129 pc
	const r0, [string-0]
	call printString@@u8[r0]
	const r8, 0
	const r10, 1
	const r12, 2
	const r2, 3
	addrof r14, d
	store [r14], r2
	const r14, 1
	const r2, 0
	addrof r14, f
	store [r14], r2
	move r0, r8
	and r0, r0, r8
	call printIntLf@i16[r0]
	move r0, r8
	and r0, r0, r10
	call printIntLf@i16[r0]
	move r0, r10
	and r0, r0, r8
	call printIntLf@i16[r0]
	move r0, r10
	and r0, r0, r10
	call printIntLf@i16[r0]
	const r0, [string-1]
	call printString@@u8[r0]
	move r0, r8
	or r0, r0, r8
	call printIntLf@i16[r0]
	move r0, r8
	or r0, r0, r10
	call printIntLf@i16[r0]
	move r0, r10
	or r0, r0, r8
	call printIntLf@i16[r0]
	move r0, r10
	or r0, r0, r10
	call printIntLf@i16[r0]
	const r0, [string-2]
	call printString@@u8[r0]
	move r0, r8
	xor r0, r0, r8
	call printIntLf@i16[r0]
	move r0, r8
	xor r0, r0, r12
	call printIntLf@i16[r0]
	move r0, r10
	xor r0, r0, r8
	call printIntLf@i16[r0]
	move r0, r10
	xor r0, r0, r12
	call printIntLf@i16[r0]
	const r0, [string-3]
	call printString@@u8[r0]
	; 26:15 logic and
	addrof r14, f
	load r8, [r14]
	move r0, r8
	branch r0, false, @and_next_2, @and_2nd_2
	move r0, r8
@and_next_2:
	call printIntLf@bool[r0]
	; 27:15 logic and
	move r0, r8
	branch r0, false, @and_next_3, @and_2nd_3
	move r0, r14
@and_next_3:
	call printIntLf@bool[r0]
	; 28:15 logic and
	move r0, r14
	branch r0, false, @and_next_4, @and_2nd_4
	move r0, r8
@and_next_4:
	call printIntLf@bool[r0]
	; 29:15 logic and
	move r0, r14
	branch r0, false, @and_next_5, @and_2nd_5
	move r0, r14
@and_next_5:
	call printIntLf@bool[r0]
	const r0, [string-4]
	call printString@@u8[r0]
	; 31:15 logic or
	move r0, r8
	branch r0, true, @or_next_6, @or_2nd_6
	move r0, r8
@or_next_6:
	call printIntLf@bool[r0]
	; 32:15 logic or
	move r0, r8
	branch r0, true, @or_next_7, @or_2nd_7
	move r0, r14
@or_next_7:
	call printIntLf@bool[r0]
	; 33:15 logic or
	move r0, r14
	branch r0, true, @or_next_8, @or_2nd_8
	move r0, r8
@or_next_8:
	call printIntLf@bool[r0]
	; 34:15 logic or
	move r0, r14
	branch r0, true, @or_next_9, @or_2nd_9
	move r0, r14
@or_next_9:
	call printIntLf@bool[r0]
	const r0, [string-5]
	call printString@@u8[r0]
	notlog r0, r8
	call printIntLf@bool[r0]
	notlog r0, r14
	call printIntLf@bool[r0]
	const r0, [string-6]
	call printString@@u8[r0]
	const r8, 10
	const r9, 6
	const r14, 1
	and r8, r8, r9
	move r0, r8
	or r0, r0, r14
	call printIntLf@u8[r0]
	; 43:20 logic or
	equals r0, r10, r12
	branch r0, false, @or_2nd_10, @no_critical_edge_30
	addrof r14, d
	load r8, [r14]
	jump @or_next_10
@or_2nd_10:
	addrof r14, d
	load r8, [r14]
	lt r0, r12, r8
@or_next_10:
	call printIntLf@bool[r0]
	; 44:20 logic and
	equals r0, r10, r12
	branch r0, false, @and_next_11, @and_2nd_11
	lt r0, r12, r8
@and_next_11:
	call printIntLf@bool[r0]
	const r0, -1
	call printIntLf@i16[r0]
	neg r0, r10
	call printIntLf@i16[r0]
	not r0, r14
	call printIntLf@u8[r0]

@printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

@printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

@printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

String literals
	string lit 0 "Bit-&:\n\0"
	string lit 1 "\nBit-|:\n\0"
	string lit 2 "\nBit-^:\n\0"
	string lit 3 "\nLogic-&&:\n\0"
	string lit 4 "\nLogic-||:\n\0"
	string lit 5 "\nLogic-!:\n\0"
	string lit 6 "\nmisc:\n\0"
