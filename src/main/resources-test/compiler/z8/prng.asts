i32 __random__;

void printIntLf@u8(u8 number) {
}

void initRandom@i32(i32 salt) {
	__random__ = salt;
}

i32 random() {
	i32 r;
	i32 b;
	i32 c;
	i32 d;
	i32 e;

	r = __random__;
	b = (r & 524287) * 48271;
	c = (r >> 15) * 48271;
	d = (c & 65535) << 15;
	e = ((c >> 16) + b) + d;
	__random__ = (e & 2147483647) + (e >> 31);
	return __random__;
}

u8 randomU8() {
	return (u8)(random());
}

void main() {
	u8 i;
	u8 r;

	initRandom@i32(7439742);
	i = 0;
	for (; i < 50; i = i + 1) {
		r = randomU8();
		printIntLf@u8(r);
	}
}
