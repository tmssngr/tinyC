i32 __random__;

void printChar@u8(u8 chr) asm {
}

void printUint@i16(i16 number) {
	printUint@i32(number as i32);
}

void printUint@i32(i32 number) asm {
}

void printIntLf@u8(u8 number) {
	printIntLf@i16(number as i16);
}

void printIntLf@i16(i16 number) {
	if (number < 0) {
		printChar@u8(45);
		number = -number;
	}
	printUint@i16(number);
	printChar@u8(13);
}

void initRandom@i32(i32 salt) {
	__random__ = salt;
}

i32 random() {
	i32 r;
	i32 b;
	i32 c;
	i32 d;
	i32 e;

	r = __random__;
	b = (r & 524287) * 48271;
	c = (r >> 15) * 48271;
	d = (c & 65535) << 15;
	e = ((c >> 16) + b) + d;
	__random__ = (e & 2147483647) + (e >> 31);
	return __random__;
}

u8 randomU8() {
	return (random()) as u8;
}

void main() {
	u8 i;
	u8 r;

	initRandom@i32(7439742);
	i = 0;
	for (; i < 50; i = i + 1) {
		r = randomU8();
		printIntLf@u8(r);
	}
}
