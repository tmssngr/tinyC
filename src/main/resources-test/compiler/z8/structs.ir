printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 0 pc
printIntLf@u8_ret:

main:
 Local variables
	var 0: pos (u8/2)
	var 1: x (u8*/2)
	var 2: t.2 (u8/1)
	var 3: t.3 (u8*/2)
	var 4: t.4 (u8/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8*/2)
	var 7: t.7 (u8*/2)
	var 8: t.8 (u8/1)
	var 9: t.9 (u8*/2)
	var 10: t.10 (u8/1)
	var 11: t.11 (u8*/2)
	var 12: t.12 (u8/1)
	; 92 pc
	const t.2, 1
	addrof t.3, pos
	store [t.3], t.2
	addrof t.6, pos
	load t.5, [t.6]
	add t.4, t.5, 1
	addrof t.7, pos
	add t.7, 1
	store [t.7], t.4
	addrof t.9, pos
	load t.8, [t.9]
	call printIntLf@u8[t.8]
	addrof t.11, pos
	add t.11, 1
	load t.10, [t.11]
	call printIntLf@u8[t.10]
	addrof x, pos
	load t.12, [x]
	call printIntLf@u8[t.12]
main_ret:

