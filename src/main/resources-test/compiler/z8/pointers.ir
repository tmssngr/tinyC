printUint@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (i32/4)
	; 8 pc
	cast t.1(i32), number(i16)
	call printUint@i32[t.1]
printUint@i16_ret:

printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 0 pc
printIntLf@u8_ret:

printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	; 13 pc
	; 127:2 if number < 0
	branch number gteq 0: if_1_end, if_1_then
if_1_then:
	call printChar@u8[45]
	neg number, number
if_1_end:
	call printUint@i16[number]
	call printChar@u8[13]
printIntLf@i16_ret:

testIf@u8:
 Local variables
	arg 0: a (u8/1)
	var 1: b (u8/1)
	var 2: b_ref (u8*/2)
	var 3: t.3 (u8/1)
	var 4: a.4 (u8*/2)
	var 5: t.5 (u8/1)
	var 6: a.6 (u8*/2)
	var 7: t.7 (u8/1)
	; 44 pc
	const t.3, 1
	addrof a.4, b
	store [a.4], t.3
	addrof b_ref, b
	; 6:2 if a == 0
	branch a notequals 0: if_2_end, if_2_then
if_2_then:
	load t.5, [b_ref]
	call printIntLf@u8[t.5]
if_2_end:
	addrof a.6, b
	load t.7, [a.6]
	call printIntLf@u8[t.7]
testIf@u8_ret:

main:
 Local variables
	var 0: a (i16/2)
	var 1: b (i16*/2)
	var 2: c (i16/2)
	var 3: d (i16*/2)
	var 4: t.4 (i16/2)
	var 5: a.5 (i16*/2)
	var 6: a.6 (i16*/2)
	var 7: t.7 (i16/2)
	var 8: t.8 (i16/2)
	var 9: t.9 (i16/2)
	var 10: a.10 (i16*/2)
	var 11: a.11 (i16*/2)
	var 12: t.12 (i16/2)
	var 13: t.13 (i16/2)
	var 14: t.14 (i16/2)
	var 15: a.15 (i16*/2)
	var 16: t.16 (i16/2)
	; 105 pc
	const t.4, 10
	addrof a.5, a
	store [a.5], t.4
	addrof a.6, a
	load t.7, [a.6]
	call printIntLf@i16[t.7]
	addrof b, a
	load t.9, [b]
	sub t.8, t.9, 1
	addrof a.10, c
	store [a.10], t.8
	addrof a.11, c
	load t.12, [a.11]
	call printIntLf@i16[t.12]
	addrof d, c
	load t.14, [d]
	sub t.13, t.14, 1
	store [d], t.13
	addrof a.15, c
	load t.16, [a.15]
	call printIntLf@i16[t.16]
	call testIf@u8[1]
main_ret:

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

