u8* board[30];

void printString@@u8(u8* str) asm {
}

void printChar@u8(u8 chr) asm {
}

void printBoard() {
	u8 i;

	printChar@u8(124);
	i = 0;
	for (; i < 30; i = i + 1) {
		if (board[(i16)i] == 0) {
			printChar@u8(32);
		}
		else {
			printChar@u8(42);
		}
	}
	printString@@u8("|\n");
}

void main() {
	u8 i;
	u8 i;
	u8 pattern;
	u8 j;

	i = 0;
	for (; i < 30; i = i + 1) {
		board[(i16)i] = 0;
	}
	board[(i16)(30 - 1)] = 1;
	printBoard();
	i = 0;
	for (; i < (30 - 2); i = i + 1) {
		pattern = (board[0] << 1) | board[1];
		j = 1;
		for (; j < (30 - 1); j = j + 1) {
			pattern = ((pattern << 1) & 7) | board[(i16)(j + 1)];
			board[(i16)j] = (110 >> pattern) & 1;
		}
		printBoard();
	}
}
