@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)

@initRandom@i32:
 Local variables
	arg 0: salt (i32/4)
	; 5 pc
	addrof r14, __random__
	store [r14], r0

@random:
 Local variables
	var 0: b (i32/4)
	; 36 pc
	addrof r14, __random__
	load r0, [r14]
	move r4, r0
	const r8, 524287
	move r0, r4
	and r0, r0, r8
	const r8, 48271
	mul r0, r0, r8
	const r8, 15
	shiftright r4, r4, r8
	const r8, 48271
	mul r4, r4, r8
	const r8, 65535
	addrof r14, b
	store [r14], r0
	move r0, r4
	and r0, r0, r8
	const r8, 15
	shiftleft r0, r0, r8
	const r8, 16
	shiftright r4, r4, r8
	addrof r14, b
	load r8, [r14]
	add r4, r4, r8
	add r4, r4, r0
	const r8, 2147483647
	move r0, r4
	and r0, r0, r8
	const r8, 31
	shiftright r4, r4, r8
	add r0, r0, r4
	; 15:9 return __random__
	addrof r14, __random__
	store [r14], r0

@randomU8:
	; 2 pc
	; 19:10 return (u8)
	call r0 = random[] -> i32
	cast r0(u8), r0(i32)

@main:
	; 12 pc
	; begin initialize global variables
	const r8, 0
	; end initialize global variables
	const r0, 7439742
	addrof r14, __random__
	store [r14], r8
	call initRandom@i32[r0]
	const r8, 0
	; 6:2 for i < 50
	jump @for_1
@for_1_body:
	call r0 = randomU8[] -> u8
	call printIntLf@u8[r0]
	const r0, 1
	add r8, r8, r0
@for_1:
	const r0, 50
	lt r0, r8, r0
	branch r0, true, @for_1_body, @main_ret

Global variables
	0: __random__ (i32/4)

