printIntLf@u8:
 Local variables
	arg 0: number (u8/1)

randomU8:
	; 2 pc
	; 60:10 return (u8)
	call t.1.1{r0} = random[] -> i32
	cast t.0.1{r0}(u8), t.1.1{r0}(i32)

main:
	; 8 pc
	const arg.0.0{r0}, 7439742
	call initRandom@i32[arg.0.0{r0}]
	const i.1{r8}, 0
	; 6:2 for i < 50
	jump for_1
for_1_body:
	call r.1{r0} = randomU8[] -> u8
	call printIntLf@u8[r.1{r0}]
	move i.3{r0}, i.2{r8}
	add i.3{r0}, 1
	move i.2{r8}, i.3{r0}
for_1:
	branch i.2{r8} lt 50: for_1_body

initRandom@i32:
	ld   %74, r0
	ld   %75, r1
	ld   %76, r2
	ld   %77, r3
	ld   r0, #%F7
	ld   r1, #%A8
	ld   r2, #%74
	ld   r3, #4
	.1:
	ldei @rr0, @r2
	djnz r3, .1
	ret

random:
	call %0836
	ld   r0, %74
	ld   r1, %75
	call %0836
	ld   r2, %74
	ld   r3, %75
	ret

