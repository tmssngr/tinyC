@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)

@randomU8:
	; 2 pc
	; 53:10 return (u8)
	call t.1{r0} = random[] -> i32
	cast t.0{r0}(u8), t.1{r0}(i32)

@main:
	; 7 pc
	const arg.0.0{r0}, 7439742
	call initRandom@i32[arg.0.0{r0}]
	const i{r8}, 0
	; 6:2 for i < 50
	jump @for_1
@for_1_body:
	call r{r0} = randomU8[] -> u8
	call printIntLf@u8[r{r0}]
	add i{r8}, i{r8}, 1
@for_1:
	lt t.2{r0}, i{r8}, 50
	branch t.2{r0}, true, @for_1_body, @main_ret

@initRandom@i32:
	ld   %70, r0
	ld   %71, r1
	ld   %72, r2
	ld   %73, r3
	ret

@random:
	call %0836
	ld   r0, %74
	ld   r1, %75
	call %0836
	ld   r2, %74
	ld   r3, %75
	ret

