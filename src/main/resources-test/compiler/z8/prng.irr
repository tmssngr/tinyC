@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)

@randomU8:
	; 2 pc
	; 53:10 return (u8)
	call r0 = random[] -> i32
	cast r0(u8), r0(i32)

@main:
	; 7 pc
	const r0, 7439742
	call initRandom@i32[r0]
	const r8, 0
	; 6:2 for i < 50
	jump @for_1
@for_1_body:
	call r0 = randomU8[] -> u8
	call printIntLf@u8[r0]
	const r0, 1
	add r8, r8, r0
@for_1:
	const r0, 50
	lt r0, r8, r0
	branch r0, true, @for_1_body, @main_ret

@initRandom@i32:
	ld   %70, r0
	ld   %71, r1
	ld   %72, r2
	ld   %73, r3
	ret

@random:
	call %0836
	ld   r0, %74
	ld   r1, %75
	call %0836
	ld   r2, %74
	ld   r3, %75
	ret

