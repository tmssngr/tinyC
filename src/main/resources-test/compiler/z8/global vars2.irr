@next:
	; 12 pc
	addrof memVarAddr{r14}, global
	load tmp.global{r1}, [memVarAddr{r14}]
	move copy{r0}, tmp.global{r1}
	add tmp.global{r1}, tmp.global{r1}, 1
	; 8:9 return copy
	addrof memVarAddr{r14}, global
	store [memVarAddr{r14}], tmp.global{r1}

@main:
	; 16 pc
	; begin initialize global variables
	const tmp.global{r8}, 0
	; end initialize global variables
	; 12:2 while true
	addrof memVarAddr{r14}, global
	store [memVarAddr{r14}], tmp.global{r8}
	jump @while_1
@if_2_end:
	; 19:3 if n < 2
	lt t.3{r8}, n{r8}, 2
	branch t.3{r8}, false, @while_1, @if_3_then
	const t.4{r0}, [string-1]
	call printString@@u8[t.4{r0}]
@while_1:
	const t.1{r0}, [string-0]
	call printString@@u8[t.1{r0}]
	call n{r0} = next[] -> u8
	move n{r8}, n{r0}
	; 15:3 if n == 3
	equals t.2{r0}, n{r8}, 3
	branch t.2{r0}, false, @if_2_end, @main_ret

@printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

Global variables
	0: global (u8/1)

String literals
	string lit 0 "loop\n\0"
	string lit 1 "<2\n\0"
