@next:
	; 12 pc
	addrof r14, global
	load r1, [r14]
	move r0, r1
	const r2, 1
	add r1, r1, r2
	; 8:9 return copy
	addrof r14, global
	store [r14], r1

@main:
	; 16 pc
	; begin initialize global variables
	const r8, 0
	; end initialize global variables
	; 12:2 while true
	addrof r14, global
	store [r14], r8
	jump @while_1
@if_2_end:
	; 19:3 if n < 2
	const r9, 2
	lt r8, r8, r9
	branch r8, false, @while_1, @if_3_then
	const r0, [string-1]
	call printString@@u8[r0]
@while_1:
	const r0, [string-0]
	call printString@@u8[r0]
	call r0 = next[] -> u8
	move r8, r0
	; 15:3 if n == 3
	const r0, 3
	equals r0, r8, r0
	branch r0, false, @if_2_end, @main_ret

@printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

Global variables
	0: global (u8/1)

String literals
	string lit 0 "loop\n\0"
	string lit 1 "<2\n\0"
