next:
	addrof a.1.1{r0}, global
	load copy.1{r2}, [a.1.1{r0}]
	move t.4.1{r3}, t.4.1{r2}
	move t.2.1{r0}, t.4.1{r3}
	add t.2.1{r0}, 1
	addrof a.5.1{r4}, global
	store [a.5.1{r4}], t.2.1{r0}
	move copy.1{r0}, copy.1{r2}

main:
	const t.1.1{r0}, 0
	addrof a.2.1{r2}, global
	store [a.2.1{r2}], t.1.1{r0}
	jump while_1
if_2_end:
	branch n.1{r8} gteq 2: while_1
	const t.4.1{r0}, [string-1]
	call printString_P_pu8[t.4.1{r0}]
while_1:
	const t.3.1{r0}, [string-0]
	call printString_P_pu8[t.3.1{r0}]
	call n.1{r0} = next[] -> u8
	move n.1{r8}, n.1{r0}
	branch n.1{r8} notequals 3: if_2_end

printString_P_pu8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

printChar_Pu8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

Global variables
	0: global (u8/1)

String literals
	string lit 0 "loop\n\0"
	string lit 1 "<2\n\0"
