next:
	; 9 pc
	addrof a.1.1{r2}, global
	load copy.1{r0}, [a.1.1{r2}]
	move t.4.1{r1}, t.4.1{r0}
	add t.2.1{r1}, 1
	store [a.5.1{r2}], t.2.1{r1}
	; 8:9 return copy

main:
	; 14 pc
	; begin initialize global variables
	const t.1.1{r8}, 0
	addrof a.2.1{r10}, global
	store [a.2.1{r10}], t.1.1{r8}
	; end initialize global variables
	; 12:2 while true
	jump while_1
if_2_end:
	branch n.1{r8} gteq 2: while_1
	const t.4.1{r0}, [string-1]
	call printString@@u8[t.4.1{r0}]
while_1:
	const t.3.1{r0}, [string-0]
	call printString@@u8[t.3.1{r0}]
	call n.1{r0} = next[] -> u8
	move n.1{r8}, n.1{r0}
	; 15:3 if n == 3
	branch n.1{r8} notequals 3: if_2_end

printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

Global variables
	0: global (u8/1)

String literals
	string lit 0 "loop\n\0"
	string lit 1 "<2\n\0"
