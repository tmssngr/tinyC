simple:
	const four.1{r0}, 4
	const three.1{r1}, 3
	sub one.1{r0}, three.1{r1}

registerHint_Pu8_Pu8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)

	add t.2.1{r0}, param.b{r1}

max_Pu8_Pu8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)

	branch param.a{r0} lt param.b{r1}: if_1_then
	jump max_Pu8_Pu8_ret
if_1_then:
	move param.b{r0}, param.b{r1}
max_Pu8_Pu8_ret:

fibonacci_Pu8:
 Local variables
	arg 0: i (u8/1)

	const a.1{r1}, 0
	const b.1{r3}, 1
	jump while_2
while_2_body:
	sub i.2{r0}, 1
	add c.1{r1}, b.2{r3}
	move b.3{r5}, c.1{r1}
	move a.2{r1}, a.3{r3}
	move b.2{r3}, b.3{r5}
while_2:
	branch i.1{r0} gt 0: while_2_body
	move a.2{r0}, a.2{r1}

main:
	call one.1{r0} = simple[] -> u8
	move one.1{r8}, one.1{r0}
	const two.1{r9}, 2
	move two.1{r1}, two.1{r9}
	call _ = registerHint_Pu8_Pu8[one.1{r0}, two.1{r1}] -> u8
	move one.1{r0}, one.1{r8}
	move two.1{r1}, two.1{r9}
	call _ = max_Pu8_Pu8[one.1{r0}, two.1{r1}] -> u8
	const arg.3.0{r0}, 5
	call _ = fibonacci_Pu8[arg.3.0{r0}] -> i16

