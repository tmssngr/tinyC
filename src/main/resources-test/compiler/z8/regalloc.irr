simple:
	; 2 pc
	const four.1{r1}, 4
	const three.1{r2}, 3
	move one.1{r0}, four.1{r1}
	sub one.1{r0}, three.1{r2}
	; 5:9 return one

registerHint@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)
	; 1 pc
	; 9:11 return a + b
	add t.2.1{r0}, param.b{r1}

max@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)
	; 5 pc
	move param.a{r2}, a{r0}
	branch param.a{r2} gteq param.b{r1}: if_1_end
	; 14:10 return b
	move param.b{r0}, param.b{r1}
	jump max@u8@u8_ret
if_1_end:
	; 16:9 return a
	move param.a{r0}, param.a{r2}
max@u8@u8_ret:

fibonacci@u8:
 Local variables
	arg 0: i (u8/1)
	; 13 pc
	const a.1{r2}, 0
	const b.1{r4}, 1
	; 22:2 while i > 0
	move i.1{r6}, param.i{r0}
	move a.2{r0}, a.1{r2}
	move b.2{r2}, b.1{r4}
	jump while_2
while_2_body:
	move i.2{r4}, i.1{r6}
	sub i.2{r4}, 1
	move c.1{r5}, a.2{r0}
	add c.1{r5}, b.2{r2}
	move b.3{r7}, c.1{r5}
	move i.1{r6}, i.2{r4}
	move a.2{r0}, a.3{r2}
	move b.2{r2}, b.3{r7}
while_2:
	branch i.1{r6} gt 0: while_2_body
	; 28:9 return a

main:
	; 8 pc
	call one.1{r0} = simple[] -> u8
	move one.1{r8}, one.1{r0}
	const two.1{r9}, 2
	move two.1{r1}, two.1{r9}
	call _ = registerHint@u8@u8[one.1{r0}, two.1{r1}] -> u8
	move one.1{r0}, one.1{r8}
	move two.1{r1}, two.1{r9}
	call _ = max@u8@u8[one.1{r0}, two.1{r1}] -> u8
	const arg.3.0{r0}, 5
	call _ = fibonacci@u8[arg.3.0{r0}] -> i16

