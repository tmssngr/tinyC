if_56_then:
	branch needsInitialize equals 0: if_57_end, if_57_then
if_57_then:
	const needsInitialize, 0
	call initField@u8@u8[curr_r, curr_c]
if_57_end:
	call index = rowColumnToCell@u8@u8[curr_r, curr_c] -> i16
	addrof t.13, field
	add t.13, index
	load cell, [t.13]
	and t.14, cell, 32
	branch t.14 notequals 0: if_58_end, if_58_then
if_58_then:
	or t.15, cell, 32
	addrof t.16, field
	add t.16, index
	store [t.16], t.15
if_58_end:
	and t.17, cell, 128
	branch t.17 equals 0: if_59_end, if_59_then
if_59_then:
	call printCellAt@u8@u8[curr_r, curr_c]
	const t.18, [string-3]
	call printString@@u8[t.18]
	jump main_ret
if_59_end:
	call maybeRevealAround@u8@u8[curr_r, curr_c]
	jump while_52
if_56_else:
	branch chr notequals 3: if_60_else, if_60_then
if_60_then:
	branch curr_r lteq 0: while_52, if_61_then
if_61_then:
	sub curr_r, 1
	jump while_52
if_60_else:
	branch chr notequals 4: if_62_else, if_62_then
if_62_then:
	branch curr_r gteq 19: while_52, if_63_then
if_63_then:
	add curr_r, 1
	jump while_52
if_62_else:
	branch chr notequals 1: if_64_else, if_64_then
if_64_then:
	branch curr_c lteq 0: while_52, if_65_then
if_65_then:
	sub curr_c, 1
	jump while_52
if_64_else:
	branch chr notequals 2: if_66_else, if_66_then
if_66_then:
	branch curr_c gteq 37: while_52, if_67_then
if_67_then:
	add curr_c, 1
	jump while_52
if_66_else:
	branch chr notequals 32: while_52, if_68_then
if_68_then:
	branch needsInitialize notequals 0: while_52, if_69_then
if_69_then:
	call index = rowColumnToCell@u8@u8[curr_r, curr_c] -> i16
	addrof t.19, field
	add t.19, index
	load cell, [t.19]
	and t.20, cell, 32
	branch t.20 notequals 0: while_52, if_70_then
if_70_then:
	xor cell, 64
	addrof t.21, field
	add t.21, index
	store [t.21], cell
	call printCellAt@u8@u8@u8[cell, curr_r, curr_c]
	jump while_52
main_ret:

printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

setCursor@i16@i16:
	ld   %5b, r3
	ld   %5c, r1
	ret

getChar:
	call %081e
	ld   r0, #0
	ld   r1, %13
	ret

initRandom@i32:
	ld   %74, r0
	ld   %75, r1
	ld   %76, r2
	ld   %77, r3
	ld   r0, #%F7
	ld   r1, #%A8
	ld   r2, #%74
	ld   r3, #4
	.1:
	ldei @rr0, @r2
	djnz r3, .1
	ret

random16:
	call %0836
	ld   r0, %74
	ld   r1, %75
	and  r0, #%7f
	ret

Global variables
	0: field[] (u8*/1520)

String literals
	string lit 0 " |\0"
	string lit 1 "Left:\0"
	string lit 2 " You've cleaned the field!\0"
	string lit 3 "boom! you've lost\0"
