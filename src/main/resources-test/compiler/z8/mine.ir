	move t.15, cell
	or t.15, t.15, 2
	addrof t.16, [field]
	add t.16, t.16, index
	store [t.16], t.15
if_46_end:
	; 276:4 if cell & 1 != 0
	move t.17, cell
	and t.17, t.17, 1
	branch t.17 equals 0: if_47_end, if_47_then
if_47_then:
	call printCellAt@u8@u8[curr_r, curr_c]
	const t.18, [string-3]
	call printString@@u8[t.18]
	jump main_ret
if_47_end:
	call maybeRevealAround@u8@u8[curr_r, curr_c]
	jump while_40
if_44_else:
	; 284:8 if chr == 3
	branch chr notequals 3: if_48_else, if_48_then
if_48_then:
	; 285:4 if curr_r > 0
	branch curr_r lteq 0: while_40, if_49_then
if_49_then:
	sub curr_r, curr_r, 1
	jump while_40
if_48_else:
	; 290:8 if chr == 4
	branch chr notequals 4: if_50_else, if_50_then
if_50_then:
	; 291:4 if curr_r < 19
	branch curr_r gteq 19: while_40, if_51_then
if_51_then:
	add curr_r, curr_r, 1
	jump while_40
if_50_else:
	; 296:8 if chr == 1
	branch chr notequals 1: if_52_else, if_52_then
if_52_then:
	; 297:4 if curr_c > 0
	branch curr_c lteq 0: while_40, if_53_then
if_53_then:
	sub curr_c, curr_c, 1
	jump while_40
if_52_else:
	; 302:8 if chr == 2
	branch chr notequals 2: if_54_else, if_54_then
if_54_then:
	; 303:4 if curr_c < 16
	branch curr_c gteq 16: while_40, if_55_then
if_55_then:
	add curr_c, curr_c, 1
	jump while_40
if_54_else:
	; 308:8 if chr == 32
	branch chr notequals 32: while_40, if_56_then
if_56_then:
	; 309:4 if !needsInitialize
	branch needsInitialize notequals 0: while_40, if_57_then
if_57_then:
	call index = rowColumnToCell@u8@u8[curr_r, curr_c] -> i16
	addrof t.19, [field]
	add t.19, t.19, index
	load cell, [t.19]
	; 312:5 if cell & 2 == 0
	move t.20, cell
	and t.20, t.20, 2
	branch t.20 notequals 0: while_40, if_58_then
if_58_then:
	xor cell, cell, 4
	addrof t.21, [field]
	add t.21, t.21, index
	store [t.21], cell
	call printCellAt@u8@u8@u8[cell, curr_r, curr_c]
	jump while_40
main_ret:

printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

setCursor@i16@i16:
	ld   %5b, r3
	ld   %5c, r1
	ret

getChar:
	call %081e
	ld   r0, #0
	ld   r1, %13
	ret

initRandom@i32:
	ld   %70, r0
	ld   %71, r1
	ld   %72, r2
	ld   %73, r3
	ret

random16:
	call %0836
	ld   r0, %74
	ld   r1, %75
	and  r0, #%7f
	ret

