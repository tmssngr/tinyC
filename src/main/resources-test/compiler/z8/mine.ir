	branch col lteq 0: while_55, if_67_then
if_67_then:
	sub col, 1
	jump while_55
if_66_else:
	branch chr notequals 2: if_68_else, if_68_then
if_68_then:
	branch col gteq 37: while_55, if_69_then
if_69_then:
	add col, 1
	jump while_55
if_68_else:
	branch chr notequals 32: while_55, if_70_then
if_70_then:
	branch bombsLeft lt 0: while_55, if_71_then
if_71_then:
	call index = rowColumnToCell@u8@u8[row, col] -> i16
	addrof t.17, field
	add t.17, index
	load cell, [t.17]
	and t.18, cell, 32
	branch t.18 notequals 0: while_55, if_72_then
if_72_then:
	xor cell, 64
	and t.19, cell, 128
	branch t.19 equals 0: if_73_end, if_73_then
if_73_then:
	and t.20, cell, 64
	branch t.20 equals 0: if_74_else, if_74_then
if_74_then:
	sub bombsLeft, 1
	jump if_73_end
if_74_else:
	add bombsLeft, 1
if_73_end:
	addrof t.21, field
	add t.21, index
	store [t.21], cell
	call printCellAt@u8@u8@u8[cell, row, col]
	jump while_55
main_ret:

printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

setCursor@i16@i16:
	ld   %5b, r3
	ld   %5c, r1
	ret

getChar:
	call %081e
	ld   r0, #0
	ld   r1, %13
	ret

initRandom@i32:
	ld   %74, r0
	ld   %75, r1
	ld   %76, r2
	ld   %77, r3
	ld   r0, #%F7
	ld   r1, #%A8
	ld   r2, #%74
	ld   r3, #4
	.1:
	ldei @rr0, @r2
	djnz r3, .1
	ret

random16:
	call %0836
	ld   r0, %74
	ld   r1, %75
	and  r0, #%7f
	ret

Global variables
	0: field[] (u8*/1520)

String literals
	string lit 0 " |\0"
	string lit 1 " You've cleaned the field!\0"
	string lit 2 "boom! you've lost\0"
