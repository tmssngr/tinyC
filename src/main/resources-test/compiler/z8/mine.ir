	jr   nz, .print
	ret

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

setCursor@i16@i16:
	ld   %5b, r3
	ld   %5c, r1
	ret

getChar:
	call %081e
	ld   r0, #0
	ld   r1, %13
	ret

initRandom@i32:
	ld   %74, r0
	ld   %75, r1
	ld   %76, r2
	ld   %77, r3
	ld   r0, #%F7
	ld   r1, #%A8
	ld   r2, #%74
	ld   r3, #4
	.1:
	ldei @rr0, @r2
	djnz r3, .1
	ret

random16:
	call %0836
	ld   r0, %74
	ld   r1, %75
	and  r0, #%7f
	ret

Global variables
	0: field[] (u8*/760)

String literals
	string lit 0 " |\0"
	string lit 1 " You've cleaned the field!\0"
	string lit 2 "boom! you've lost\0"
