@printUint@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (i32/4)
	; 8 pc
	cast t.1(i32), number(i16)
	call printUint@i32[t.1]
@printUint@i16_ret:

@printIntLf@bool:
 Local variables
	arg 0: number (bool/1)
	; 0 pc
@printIntLf@bool_ret:

@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 0 pc
@printIntLf@u8_ret:

@printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (bool/1)
	var 2: t.2 (i16/2)
	var 3: t.3 (u8/1)
	var 4: t.4 (u8/1)
	; 30 pc
	; 127:2 if number < 0
	const t.2, 0
	lt t.1, number, t.2
	branch t.1, false, @if_1_end, @if_1_then
@if_1_then:
	const t.3, 45
	call printChar@u8[t.3]
	neg number, number
@if_1_end:
	call printUint@i16[number]
	const t.4, 13
	call printChar@u8[t.4]
@printIntLf@i16_ret:

@main:
 Local variables
	var 0: a (i16/2)
	var 1: b (i16/2)
	var 2: c (i16/2)
	var 3: d (i16/2)
	var 4: t (bool/1)
	var 5: f (bool/1)
	var 6: b10 (u8/1)
	var 7: b6 (u8/1)
	var 8: b1 (u8/1)
	var 9: t.9 (u8*/2)
	var 10: t.10 (i16/2)
	var 11: t.11 (i16/2)
	var 12: t.12 (i16/2)
	var 13: t.13 (i16/2)
	var 14: t.14 (u8*/2)
	var 15: t.15 (i16/2)
	var 16: t.16 (i16/2)
	var 17: t.17 (i16/2)
	var 18: t.18 (i16/2)
	var 19: t.19 (u8*/2)
	var 20: t.20 (i16/2)
	var 21: t.21 (i16/2)
	var 22: t.22 (i16/2)
	var 23: t.23 (i16/2)
	var 24: t.24 (u8*/2)
	var 25: t.25 (bool/1)
	var 26: t.26 (bool/1)
	var 27: t.27 (bool/1)
	var 28: t.28 (bool/1)
	var 29: t.29 (u8*/2)
	var 30: t.30 (bool/1)
	var 31: t.31 (bool/1)
	var 32: t.32 (bool/1)
	var 33: t.33 (bool/1)
	var 34: t.34 (u8*/2)
	var 35: t.35 (bool/1)
	var 36: t.36 (bool/1)
	var 37: t.37 (u8*/2)
	var 38: t.38 (u8/1)
	var 39: t.39 (u8/1)
	var 40: t.40 (bool/1)
	var 41: t.41 (bool/1)
	var 42: t.42 (i16/2)
	var 43: t.43 (i16/2)
	var 44: t.44 (u8/1)
	; 472 pc
	const t.9, [string-0]
	call printString@@u8[t.9]
	const a, 0
	const b, 1
	const c, 2
	const d, 3
	const t, 1
	const f, 0
	move t.10, a
	and t.10, t.10, a
	call printIntLf@i16[t.10]
	move t.11, a
	and t.11, t.11, b
	call printIntLf@i16[t.11]
	move t.12, b
	and t.12, t.12, a
	call printIntLf@i16[t.12]
	move t.13, b
	and t.13, t.13, b
	call printIntLf@i16[t.13]
	const t.14, [string-1]
	call printString@@u8[t.14]
	move t.15, a
	or t.15, t.15, a
	call printIntLf@i16[t.15]
	move t.16, a
	or t.16, t.16, b
	call printIntLf@i16[t.16]
	move t.17, b
	or t.17, t.17, a
	call printIntLf@i16[t.17]
	move t.18, b
	or t.18, t.18, b
	call printIntLf@i16[t.18]
	const t.19, [string-2]
	call printString@@u8[t.19]
	move t.20, a
	xor t.20, t.20, a
	call printIntLf@i16[t.20]
	move t.21, a
	xor t.21, t.21, c
	call printIntLf@i16[t.21]
	move t.22, b
	xor t.22, t.22, a
	call printIntLf@i16[t.22]
	move t.23, b
	xor t.23, t.23, c
	call printIntLf@i16[t.23]
	const t.24, [string-3]
	call printString@@u8[t.24]
	; 26:15 logic and
	move t.25, f
	branch t.25, false, @and_next_2, @and_2nd_2
@and_2nd_2:
	move t.25, f
@and_next_2:
	call printIntLf@bool[t.25]
	; 27:15 logic and
	move t.26, f
	branch t.26, false, @and_next_3, @and_2nd_3
@and_2nd_3:
	move t.26, t
@and_next_3:
	call printIntLf@bool[t.26]
	; 28:15 logic and
	move t.27, t
	branch t.27, false, @and_next_4, @and_2nd_4
@and_2nd_4:
	move t.27, f
@and_next_4:
	call printIntLf@bool[t.27]
	; 29:15 logic and
	move t.28, t
	branch t.28, false, @and_next_5, @and_2nd_5
@and_2nd_5:
	move t.28, t
@and_next_5:
	call printIntLf@bool[t.28]
	const t.29, [string-4]
	call printString@@u8[t.29]
	; 31:15 logic or
	move t.30, f
	branch t.30, true, @or_next_6, @or_2nd_6
@or_2nd_6:
	move t.30, f
@or_next_6:
	call printIntLf@bool[t.30]
	; 32:15 logic or
	move t.31, f
	branch t.31, true, @or_next_7, @or_2nd_7
@or_2nd_7:
	move t.31, t
@or_next_7:
	call printIntLf@bool[t.31]
	; 33:15 logic or
	move t.32, t
	branch t.32, true, @or_next_8, @or_2nd_8
@or_2nd_8:
	move t.32, f
@or_next_8:
	call printIntLf@bool[t.32]
	; 34:15 logic or
	move t.33, t
	branch t.33, true, @or_next_9, @or_2nd_9
@or_2nd_9:
	move t.33, t
@or_next_9:
	call printIntLf@bool[t.33]
	const t.34, [string-5]
	call printString@@u8[t.34]
	notlog t.35, f
	call printIntLf@bool[t.35]
	notlog t.36, t
	call printIntLf@bool[t.36]
	const t.37, [string-6]
	call printString@@u8[t.37]
	const b10, 10
	const b6, 6
	const b1, 1
	move t.39, b10
	and t.39, t.39, b6
	move t.38, t.39
	or t.38, t.38, b1
	call printIntLf@u8[t.38]
	; 43:20 logic or
	equals t.40, b, c
	branch t.40, true, @or_next_10, @or_2nd_10
@or_2nd_10:
	lt t.40, c, d
@or_next_10:
	call printIntLf@bool[t.40]
	; 44:20 logic and
	equals t.41, b, c
	branch t.41, false, @and_next_11, @and_2nd_11
@and_2nd_11:
	lt t.41, c, d
@and_next_11:
	call printIntLf@bool[t.41]
	const t.42, -1
	call printIntLf@i16[t.42]
	neg t.43, b
	call printIntLf@i16[t.43]
	not t.44, b1
	call printIntLf@u8[t.44]
@main_ret:

@printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

@printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

@printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

String literals
	string lit 0 "Bit-&:\n\0"
	string lit 1 "\nBit-|:\n\0"
	string lit 2 "\nBit-^:\n\0"
	string lit 3 "\nLogic-&&:\n\0"
	string lit 4 "\nLogic-||:\n\0"
	string lit 5 "\nLogic-!:\n\0"
	string lit 6 "\nmisc:\n\0"
