	call printBoard[]
	move i.7{r0}, i.4{r8}
	add i.7{r0}, 1
	move i.4{r8}, i.7{r0}
for_4:
	branch i.4{r8} lt 28: for_4_body

printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

Global variables
	0: board[] (u8*/60)

String literals
	string lit 0 "|\n\0"
