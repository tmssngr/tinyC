printBoard:
	; 15 pc
	const arg.0.0{r0}, 124
	call printChar@u8[arg.0.0{r0}]
	const i{r8}, 0
	; 11:2 for i < 30
	jump for_1
for_1_body:
	; 12:3 if [...] == 0
	cast t.3{r9}(i16), i{r8}(u8)
	addrof t.2{r12}, [board]
	add t.2{r12}, t.2{r12}, t.3{r9}
	load t.1{r9}, [t.2{r12}]
	branch t.1{r9} equals 0: if_2_then, if_2_else
	const arg.2.0{r0}, 42
	call printChar@u8[arg.2.0{r0}]
