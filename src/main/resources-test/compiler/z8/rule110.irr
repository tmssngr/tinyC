printBoard:
	; 17 pc
	const arg.0.0{r0}, 124
	call printChar@u8[arg.0.0{r0}]
	const i.1{r8}, 0
	; 11:2 for i < 30
	jump for_1
for_1_body:
	; 12:3 if [...] == 0
	cast t.3.1{r9}(i16), i.2{r8}(u8)
	addrof t.2.1{r12}, board
	add t.2.2{r12}, t.3.1{r9}
	load t.1.1{r9}, [t.2.2{r12}]
	branch t.1.1{r9} notequals 0: if_2_else
	const arg.1.0{r0}, 32
	call printChar@u8[arg.1.0{r0}]
