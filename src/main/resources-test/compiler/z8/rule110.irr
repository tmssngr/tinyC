	const t.4{r0}, [string-0]
	call printString@@u8[t.4{r0}]

main:
	; 47 pc
	const i{r8}, 0
	; 23:2 for i < 30
	jump for_3
for_3_body:
	const t.4{r9}, 0
	cast t.6{r10}(i16), i{r8}(u8)
	addrof t.5{r12}, [board]
	add t.5{r12}, t.5{r12}, t.6{r10}
	store [t.5{r12}], t.4{r9}
	add i{r8}, i{r8}, 1
for_3:
