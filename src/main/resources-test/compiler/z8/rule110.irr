	const t.7{r8}, 1
	const t.9{r9}, 29
	addrof t.8{r12}, [board]
	add t.8{r12}, t.8{r12}, t.9{r9}
	store [t.8{r12}], t.7{r8}
	call printBoard[]
	const i{r8}, 0
	; 30:2 for i < 28
