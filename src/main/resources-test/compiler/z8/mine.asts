u8* field[800];

void printString_P_pu8(u8* str) asm {
}

void printChar_Pu8(u8 chr) asm {
}

void printUint_Pi16(i16 number) {
	printUint_Pi32(number as i32);
}

void printUint_Pi32(i32 number) asm {
}

void setCursor_Pi16_Pi16(i16 row, i16 column) asm {
}

i16 getChar() asm {
}

void initRandom_Pi32(i32 salt) asm {
}

i16 random16() asm {
}

i16 rowColumnToCell_Pi16_Pi16(i16 row, i16 column) {
	return (row * 40) + column;
}

u8 getCell_Pi16_Pi16(i16 row, i16 column) {
	return field[rowColumnToCell_Pi16_Pi16(row, column)];
}

bool isBomb_Pu8(u8 cell) {
	return (cell & 1) != 0;
}

bool isOpen_Pu8(u8 cell) {
	return (cell & 2) != 0;
}

bool isFlag_Pu8(u8 cell) {
	return (cell & 4) != 0;
}

bool checkCellBounds_Pi16_Pi16(i16 row, i16 column) {
	return (((row >= 0) && (row < 20)) && (column >= 0)) && (column < 40);
}

void setCell_Pi16_Pi16_Pu8(i16 row, i16 column, u8 cell) {
	field[rowColumnToCell_Pi16_Pi16(row, column)] = cell;
}

u8 getBombCountAround_Pi16_Pi16(i16 row, i16 column) {
	u8 count;
	i16 dr;
	i16 r;
	i16 dc;
	i16 c;
	u8 cell;

	count = 0;
	dr = -1;
	for (; dr <= 1; dr = dr + 1) {
		r = row + dr;
		dc = -1;
		for (; dc <= 1; dc = dc + 1) {
			c = column + dc;
			if (checkCellBounds_Pi16_Pi16(r, c)) {
				cell = getCell_Pi16_Pi16(r, c);
				if (isBomb_Pu8(cell)) {
					count = count + 1;
				}
			}
		}
	}
	return count;
}

u8 getSpacer_Pi16_Pi16_Pi16_Pi16(i16 row, i16 column, i16 rowCursor, i16 columnCursor) {
	if (rowCursor == row) {
		if (columnCursor == column) {
			return 91;
		}
		if (columnCursor == (column - 1)) {
			return 93;
		}
	}
	return 32;
}

void printCell_Pu8_Pi16_Pi16(u8 cell, i16 row, i16 column) {
	u8 chr;
	u8 count;

	chr = 46;
	if (isOpen_Pu8(cell)) {
		if (isBomb_Pu8(cell)) {
			chr = 42;
		}
		else {
			count = getBombCountAround_Pi16_Pi16(row, column);
			if (count > 0) {
				chr = count + 48;
			}
			else {
				chr = 32;
			}
		}
	}
	else {
		if (isFlag_Pu8(cell)) {
			chr = 35;
		}
	}
	printChar_Pu8(chr);
}

void printField_Pi16_Pi16(i16 rowCursor, i16 columnCursor) {
	i16 row;
	i16 column;
	u8 spacer;
	u8 cell;
	u8 spacer;

	setCursor_Pi16_Pi16(0, 0);
	row = 0;
	for (; row < 20; row = row + 1) {
		printChar_Pu8(124);
		column = 0;
		for (; column < 40; column = column + 1) {
			spacer = getSpacer_Pi16_Pi16_Pi16_Pi16(row, column, rowCursor, columnCursor);
			printChar_Pu8(spacer);
			cell = getCell_Pi16_Pi16(row, column);
			printCell_Pu8_Pi16_Pi16(cell, row, column);
		}
		spacer = getSpacer_Pi16_Pi16_Pi16_Pi16(row, 40, rowCursor, columnCursor);
		printChar_Pu8(spacer);
		printString_P_pu8("|\n");
	}
}

void printSpaces_Pi16(i16 i) {
	for (; i > 0; i = i - 1) {
		printChar_Pu8(48);
	}
}

u8 getDigitCount_Pi16(i16 value) {
	u8 count;

	count = 0;
	if (value < 0) {
		count = 1;
		value = -value;
	}
	while (true) {
		count = count + 1;
		value = value / 10;
		if (value == 0) {
			break;
		}
	}
	return count;
}

i16 getHiddenCount() {
	i16 count;
	i16 r;
	i16 c;
	u8 cell;

	count = 0;
	r = 0;
	for (; r < 20; r = r + 1) {
		c = 0;
		for (; c < 40; c = c + 1) {
			cell = getCell_Pi16_Pi16(r, c);
			if ((cell & 6) == 0) {
				count = count + 1;
			}
		}
	}
	return count;
}

bool printLeft() {
	i16 count;
	i16 leftDigits;
	i16 bombDigits;

	count = getHiddenCount();
	leftDigits = (getDigitCount_Pi16(count)) as i16;
	bombDigits = (getDigitCount_Pi16(40)) as i16;
	setCursor_Pi16_Pi16(20, 6);
	printSpaces_Pi16(bombDigits - leftDigits);
	printUint_Pi16(count);
	return count == 0;
}

i16 abs_Pi16(i16 a) {
	if (a < 0) {
		return -a;
	}
	return a;
}

void clearField() {
	i16 r;
	i16 c;

	r = 0;
	for (; r < 20; r = r + 1) {
		c = 0;
		for (; c < 40; c = c + 1) {
			setCell_Pi16_Pi16_Pu8(r, c, 0);
		}
	}
}

void initField_Pi16_Pi16(i16 curr_r, i16 curr_c) {
	i16 bombs;
	i16 row;
	i16 column;

	bombs = 40;
	for (; bombs > 0; bombs = bombs - 1) {
		row = (random16()) % 20;
		column = (random16()) % 40;
		if (((abs_Pi16(row - curr_r)) > 1) || ((abs_Pi16(column - curr_c)) > 1)) {
			setCell_Pi16_Pi16_Pu8(row, column, 1);
		}
	}
}

void maybeRevealAround_Pi16_Pi16(i16 row, i16 column) {
	i16 dr;
	i16 r;
	i16 dc;
	i16 c;
	u8 cell;

	if ((getBombCountAround_Pi16_Pi16(row, column)) != 0) {
		return;
	}
	dr = -1;
	for (; dr <= 1; dr = dr + 1) {
		r = row + dr;
		dc = -1;
		for (; dc <= 1; dc = dc + 1) {
			if ((dr == 0) && (dc == 0)) {
				continue;
			}
			c = column + dc;
			if (!(checkCellBounds_Pi16_Pi16(r, c))) {
				continue;
			}
			cell = getCell_Pi16_Pi16(r, c);
			if (isOpen_Pu8(cell)) {
				continue;
			}
			setCell_Pi16_Pi16_Pu8(r, c, cell | 2);
			maybeRevealAround_Pi16_Pi16(r, c);
		}
	}
}

void main() {
	bool needsInitialize;
	i16 curr_c;
	i16 curr_r;
	i16 chr;
	u8 cell;
	u8 cell;

	initRandom_Pi32(7439742);
	needsInitialize = true;
	clearField();
	curr_c = 20;
	curr_r = 10;
	setCursor_Pi16_Pi16(20, 0);
	printString_P_pu8("Left:");
	while (true) {
		printField_Pi16_Pi16(curr_r, curr_c);
		if (!needsInitialize) {
			if (printLeft()) {
				printString_P_pu8(" You've cleaned the field!");
				break;
			}
		}
		chr = getChar();
		if (chr == 27) {
			break;
		}
		if (chr == 3) {
			curr_r = ((curr_r + 20) - 1) % 20;
		}
		else {
			if (chr == 4) {
				curr_r = (curr_r + 1) % 20;
			}
			else {
				if (chr == 1) {
					curr_c = ((curr_c + 40) - 1) % 40;
				}
				else {
					if (chr == 2) {
						curr_c = (curr_c + 1) % 40;
					}
					else {
						if (chr == 32) {
							if (!needsInitialize) {
								cell = getCell_Pi16_Pi16(curr_r, curr_c);
								if (!(isOpen_Pu8(cell))) {
									cell = cell ^ 4;
									setCell_Pi16_Pi16_Pu8(curr_r, curr_c, cell);
								}
							}
						}
						else {
							if (chr == 13) {
								if (needsInitialize) {
									needsInitialize = false;
									initField_Pi16_Pi16(curr_r, curr_c);
								}
								cell = getCell_Pi16_Pi16(curr_r, curr_c);
								if (!(isOpen_Pu8(cell))) {
									setCell_Pi16_Pi16_Pu8(curr_r, curr_c, cell | 2);
								}
								if (isBomb_Pu8(cell)) {
									printField_Pi16_Pi16(curr_r, curr_c);
									printString_P_pu8("boom! you've lost");
									break;
								}
								maybeRevealAround_Pi16_Pi16(curr_r, curr_c);
							}
						}
					}
				}
			}
		}
	}
}
