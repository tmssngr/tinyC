void printChar_Pu8(u8 chr) asm {
}

void printUint_Pi16(i16 number) {
	printUint_Pi32(number as i32);
}

void printUint_Pi32(i32 number) asm {
}

void printIntLf_Pu8(u8 number) {
	printIntLf_Pi16(number as i16);
}

void printIntLf_Pi16(i16 number) {
	if (number < 0) {
		printChar_Pu8(45);
		number = -number;
	}
	printUint_Pi16(number);
	printChar_Pu8(13);
}

void initRandom_Pi32(i32 salt) asm {
}

i32 random() asm {
}

u8 randomU8() {
	return (random()) as u8;
}

void main() {
	u8 i;
	u8 r;

	initRandom_Pi32(7439742);
	i = 0;
	for (; i < 50; i = i + 1) {
		r = randomU8();
		printIntLf_Pu8(r);
	}
}
