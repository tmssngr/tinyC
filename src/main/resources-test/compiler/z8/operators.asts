void printString@@u8(u8* str) asm {
}

void printChar@u8(u8 chr) asm {
}

void printUint@i16(i16 number) {
	printUint@i32((i32)number);
}

void printUint@i32(i32 number) asm {
}

void printIntLf@bool(bool number) {
}

void printIntLf@u8(u8 number) {
}

void printIntLf@i16(i16 number) {
	if (number < 0) {
		printChar@u8(45);
		number = -number;
	}
	printUint@i16(number);
	printChar@u8(13);
}

void main() {
	i16 a;
	i16 b;
	i16 c;
	i16 d;
	bool t;
	bool f;
	u8 b10;
	u8 b6;
	u8 b1;

	printString@@u8("Bit-&:\n");
	a = 0;
	b = 1;
	c = 2;
	d = 3;
	t = true;
	f = false;
	printIntLf@i16(a & a);
	printIntLf@i16(a & b);
	printIntLf@i16(b & a);
	printIntLf@i16(b & b);
	printString@@u8("\nBit-|:\n");
	printIntLf@i16(a | a);
	printIntLf@i16(a | b);
	printIntLf@i16(b | a);
	printIntLf@i16(b | b);
	printString@@u8("\nBit-^:\n");
	printIntLf@i16(a ^ a);
	printIntLf@i16(a ^ c);
	printIntLf@i16(b ^ a);
	printIntLf@i16(b ^ c);
	printString@@u8("\nLogic-&&:\n");
	printIntLf@bool(f && f);
	printIntLf@bool(f && t);
	printIntLf@bool(t && f);
	printIntLf@bool(t && t);
	printString@@u8("\nLogic-||:\n");
	printIntLf@bool(f || f);
	printIntLf@bool(f || t);
	printIntLf@bool(t || f);
	printIntLf@bool(t || t);
	printString@@u8("\nLogic-!:\n");
	printIntLf@bool(!f);
	printIntLf@bool(!t);
	printString@@u8("\nmisc:\n");
	b10 = 10;
	b6 = 6;
	b1 = 1;
	printIntLf@u8((b10 & b6) | b1);
	printIntLf@bool((b == c) || (c < d));
	printIntLf@bool((b == c) && (c < d));
	printIntLf@i16(-1);
	printIntLf@i16(-b);
	printIntLf@u8(~b1);
}
