void printString@@u8(u8* str) asm {
}

void printChar@u8(u8 chr) asm {
}

void printUint@i16(i16 number) {
	printUint@i32((i32)number);
}

void printUint@i32(i32 number) asm {
}

void printIntLf@bool(bool number) {
}

void printIntLf@u8(u8 number) {
}

void printIntLf@i16(i16 number) {
	if (number < 0) {
		printChar@u8(45);
		number = -number;
	}
	printUint@i16(number);
	printChar@u8(13);
}

bool getTrue() {
	printString@@u8(" true");
	return true;
}

bool getFalse() {
	printString@@u8(" false");
	return false;
}

void printPass() {
	printString@@u8(" -> pass ");
}

void printError() {
	printString@@u8(" -> ERROR ");
}

void logicNot() {
	bool t;
	bool f;

	printString@@u8("\nLogic-!:\n");
	t = true;
	f = false;
	if (!(getFalse())) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf@bool(!f);
	if (!(getTrue())) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf@bool(!t);
}

void logicAnd() {
	bool t;
	bool f;

	printString@@u8("\nLogic-&&:\n");
	t = true;
	f = false;
	if ((getFalse()) && (getFalse())) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf@bool(f && f);
	if ((getFalse()) && (getTrue())) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf@bool(f && t);
	if ((getTrue()) && (getFalse())) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf@bool(t && f);
	if ((getTrue()) && (getTrue())) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf@bool(t && t);
	if (!((getFalse()) && (getFalse()))) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf@bool(!(f && f));
	if (!((getFalse()) && (getTrue()))) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf@bool(!(f && t));
	if (!((getTrue()) && (getFalse()))) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf@bool(!(t && f));
	if (!((getTrue()) && (getTrue()))) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf@bool(!(t && t));
}

void logicOr() {
	bool t;
	bool f;

	printString@@u8("\nLogic-||:\n");
	t = true;
	f = false;
	if ((getFalse()) || (getFalse())) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf@bool(f || f);
	if ((getFalse()) || (getTrue())) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf@bool(f || t);
	if ((getTrue()) || (getFalse())) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf@bool(t || f);
	if ((getTrue()) || (getTrue())) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf@bool(t || t);
}

void main() {
	i16 a;
	i16 b;
	i16 c;
	i16 d;
	bool t;
	bool f;
	u8 b10;
	u8 b6;
	u8 b1;

	printString@@u8("Bit-&:\n");
	a = 0;
	b = 1;
	c = 2;
	d = 3;
	t = true;
	f = false;
	printIntLf@i16(a & a);
	printIntLf@i16(a & b);
	printIntLf@i16(b & a);
	printIntLf@i16(b & b);
	printString@@u8("\nBit-|:\n");
	printIntLf@i16(a | a);
	printIntLf@i16(a | b);
	printIntLf@i16(b | a);
	printIntLf@i16(b | b);
	printString@@u8("\nBit-^:\n");
	printIntLf@i16(a ^ a);
	printIntLf@i16(a ^ c);
	printIntLf@i16(b ^ a);
	printIntLf@i16(b ^ c);
	logicNot();
	logicAnd();
	logicOr();
	if ((!((getTrue()) && (getTrue()))) || (!((getFalse()) && (getFalse())))) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf@bool((!(t && t)) || (!(f && f)));
	printString@@u8("\n\nmisc:\n");
	b10 = 10;
	b6 = 6;
	b1 = 1;
	printIntLf@u8((b10 & b6) | b1);
	printIntLf@bool((b == c) || (c < d));
	printIntLf@bool((b == c) && (c < d));
	printIntLf@i16(-1);
	printIntLf@i16(-b);
	printIntLf@u8(~b1);
}
