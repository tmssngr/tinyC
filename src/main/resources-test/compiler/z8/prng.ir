printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 0 pc
printIntLf@u8_ret:

initRandom@i32:
 Local variables
	arg 0: salt (i32/4)
	; 5 pc
	move __random__, salt
initRandom@i32_ret:

random:
 Local variables
	var 0: r (i32/4)
	var 1: b (i32/4)
	var 2: c (i32/4)
	var 3: d (i32/4)
	var 4: e (i32/4)
	var 5: t.5 (i32/4)
	var 6: t.6 (i32/4)
	var 7: t.7 (i32/4)
	var 8: t.8 (i32/4)
	var 9: t.9 (i32/4)
	var 10: t.10 (i32/4)
	var 11: t.11 (i32/4)
	; 75 pc
	move r, __random__
	and t.5, r, 524287
	mul b, t.5, 48271
	shiftright t.6, r, 15
	mul c, t.6, 48271
	and t.7, c, 65535
	shiftleft d, t.7, 15
	shiftright t.9, c, 16
	add t.8, t.9, b
	add e, t.8, d
	and t.10, e, 2147483647
	shiftright t.11, e, 31
	add __random__, t.10, t.11
	; 15:9 return __random__
	ret __random__
	jump random_ret
random_ret:

randomU8:
 Local variables
	var 0: t.0 (u8/1)
	var 1: t.1 (i32/4)
	; 12 pc
	; 19:10 return (u8)
	call t.1 = random[] -> i32
	cast t.0(u8), t.1(i32)
	ret t.0
	jump randomU8_ret
randomU8_ret:

main:
 Local variables
	var 0: i (u8/1)
	var 1: r (u8/1)
	; 20 pc
	; begin initialize global variables
	const __random__, 0
	; end initialize global variables
	call initRandom@i32[7439742]
	const i, 0
	; 6:2 for i < 50
for_1:
	branch i gteq 50: main_ret, for_1_body
for_1_body:
	call r = randomU8[] -> u8
	call printIntLf@u8[r]
for_1_continue:
	add i, i, 1
	jump for_1
main_ret:

Global variables
	0: __random__ (i32/4)

