@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 0 pc
@printIntLf@u8_ret:

@randomU8:
 Local variables
	var 0: t.0 (u8/1)
	var 1: t.1 (i32/4)
	; 12 pc
	; 53:10 return (u8)
	call t.1 = random[] -> i32
	cast t.0(u8), t.1(i32)
	ret t.0
	jump @randomU8_ret
@randomU8_ret:

@main:
 Local variables
	var 0: i (u8/1)
	var 1: r (u8/1)
	var 2: t.2 (i32/4)
	var 3: t.3 (bool/1)
	var 4: t.4 (u8/1)
	var 5: t.5 (u8/1)
	; 35 pc
	const t.2, 7439742
	call initRandom@i32[t.2]
	const i, 0
	; 6:2 for i < 50
@for_1:
	const t.4, 50
	lt t.3, i, t.4
	branch t.3, false, @main_ret, @for_1_body
@for_1_body:
	call r = randomU8[] -> u8
	call printIntLf@u8[r]
@for_1_continue:
	const t.5, 1
	add i, i, t.5
	jump @for_1
@main_ret:

@initRandom@i32:
	ld   %70, r0
	ld   %71, r1
	ld   %72, r2
	ld   %73, r3
	ret

@random:
	call %0836
	ld   r0, %74
	ld   r1, %75
	call %0836
	ld   r2, %74
	ld   r3, %75
	ret

