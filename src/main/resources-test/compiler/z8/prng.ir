@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 0 pc
@printIntLf@u8_ret:

@initRandom@i32:
 Local variables
	arg 0: salt (i32/4)
	; 5 pc
	move __random__, salt
@initRandom@i32_ret:

@random:
 Local variables
	var 0: r (i32/4)
	var 1: b (i32/4)
	var 2: c (i32/4)
	var 3: d (i32/4)
	var 4: e (i32/4)
	var 5: t.5 (i32/4)
	var 6: t.6 (i32/4)
	var 7: t.7 (i32/4)
	var 8: t.8 (i32/4)
	var 9: t.9 (i32/4)
	var 10: t.10 (i32/4)
	var 11: t.11 (i32/4)
	; 135 pc
	move r, __random__
	move t.5, r
	and t.5, t.5, 524287
	move b, t.5
	mul b, b, 48271
	move t.6, r
	shiftright t.6, t.6, 15
	move c, t.6
	mul c, c, 48271
	move t.7, c
	and t.7, t.7, 65535
	move d, t.7
	shiftleft d, d, 15
	move t.9, c
	shiftright t.9, t.9, 16
	move t.8, t.9
	add t.8, t.8, b
	move e, t.8
	add e, e, d
	move t.10, e
	and t.10, t.10, 2147483647
	move t.11, e
	shiftright t.11, t.11, 31
	move __random__, t.10
	add __random__, __random__, t.11
	; 15:9 return __random__
	ret __random__
	jump @random_ret
@random_ret:

@randomU8:
 Local variables
	var 0: t.0 (u8/1)
	var 1: t.1 (i32/4)
	; 12 pc
	; 19:10 return (u8)
	call t.1 = random[] -> i32
	cast t.0(u8), t.1(i32)
	ret t.0
	jump @randomU8_ret
@randomU8_ret:

@main:
 Local variables
	var 0: i (u8/1)
	var 1: r (u8/1)
	var 2: t.2 (bool/1)
	; 25 pc
	; begin initialize global variables
	const __random__, 0
	; end initialize global variables
	call initRandom@i32[7439742]
	const i, 0
	; 6:2 for i < 50
@for_1:
	lt t.2, i, 50
	branch t.2, false, @main_ret, @for_1_body
@for_1_body:
	call r = randomU8[] -> u8
	call printIntLf@u8[r]
@for_1_continue:
	add i, i, 1
	jump @for_1
@main_ret:

Global variables
	0: __random__ (i32/4)

