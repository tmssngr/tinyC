	; 0 pc
@printIntLf@u8_ret:

@initRandom@i32:
 Local variables
	arg 0: salt (i32/4)
	; 5 pc
	move __random__, salt
@initRandom@i32_ret:

@random:
 Local variables
	var 0: r (i32/4)
	var 1: b (i32/4)
	var 2: c (i32/4)
	var 3: d (i32/4)
	var 4: e (i32/4)
	var 5: t.5 (i32/4)
	var 6: t.6 (i32/4)
	var 7: t.7 (i32/4)
	var 8: t.8 (i32/4)
	var 9: t.9 (i32/4)
	var 10: t.10 (i32/4)
	var 11: t.11 (i32/4)
	var 12: t.12 (i32/4)
	var 13: t.13 (i32/4)
	var 14: t.14 (i32/4)
	var 15: t.15 (i32/4)
	var 16: t.16 (i32/4)
	var 17: t.17 (i32/4)
	var 18: t.18 (i32/4)
	var 19: t.19 (i32/4)
	var 20: t.20 (i32/4)
	; 171 pc
	move r, __random__
	const t.6, 524287
	move t.5, r
	and t.5, t.5, t.6
	const t.7, 48271
	move b, t.5
	mul b, b, t.7
	const t.9, 15
	move t.8, r
	shiftright t.8, t.8, t.9
	const t.10, 48271
	move c, t.8
	mul c, c, t.10
	const t.12, 65535
	move t.11, c
	and t.11, t.11, t.12
	const t.13, 15
	move d, t.11
	shiftleft d, d, t.13
	const t.16, 16
	move t.15, c
	shiftright t.15, t.15, t.16
	move t.14, t.15
	add t.14, t.14, b
	move e, t.14
	add e, e, d
	const t.18, 2147483647
	move t.17, e
	and t.17, t.17, t.18
	const t.20, 31
	move t.19, e
	shiftright t.19, t.19, t.20
	move __random__, t.17
	add __random__, __random__, t.19
	; 15:9 return __random__
	ret __random__
	jump @random_ret
@random_ret:

@randomU8:
 Local variables
	var 0: t.0 (u8/1)
	var 1: t.1 (i32/4)
	; 12 pc
	; 19:10 return (u8)
	call t.1 = random[] -> i32
	cast t.0(u8), t.1(i32)
	ret t.0
	jump @randomU8_ret
@randomU8_ret:

@main:
 Local variables
	var 0: i (u8/1)
	var 1: r (u8/1)
	var 2: t.2 (i32/4)
	var 3: t.3 (bool/1)
	var 4: t.4 (u8/1)
	var 5: t.5 (u8/1)
	; 37 pc
	; begin initialize global variables
	const __random__, 0
	; end initialize global variables
	const t.2, 7439742
	call initRandom@i32[t.2]
	const i, 0
	; 6:2 for i < 50
@for_1:
	const t.4, 50
	lt t.3, i, t.4
	branch t.3, false, @main_ret, @for_1_body
@for_1_body:
	call r = randomU8[] -> u8
	call printIntLf@u8[r]
@for_1_continue:
	const t.5, 1
	add i, i, t.5
	jump @for_1
@main_ret:

Global variables
	0: __random__ (i32/4)

