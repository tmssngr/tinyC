@printNibble@u8:
 Local variables
	arg 0: x (u8/1)
	var 1: t.1 (u8/1)
	var 2: t.2 (bool/1)
	var 3: t.3 (u8/1)
	var 4: t.4 (u8/1)
	var 5: t.5 (u8/1)
	; 42 pc
	const t.1, 15
	and x, x, t.1
	; 5:2 if x > 9
	const t.3, 9
	gt t.2, x, t.3
	branch t.2, false, @if_1_end, @if_1_then
@if_1_then:
	const t.4, 7
	add x, x, t.4
@if_1_end:
	const t.5, 48
	add x, x, t.5
	call printChar@u8[x]
@printNibble@u8_ret:

@printHex2@u8:
 Local variables
	arg 0: x (u8/1)
	var 1: t.1 (u8/1)
	var 2: t.2 (u8/1)
	; 20 pc
	const t.2, 4
	move t.1, x
	shiftright t.1, t.1, t.2
	call printNibble@u8[t.1]
	call printNibble@u8[x]
@printHex2@u8_ret:

@main:
 Local variables
	var 0: i (u8/1)
	var 1: i (u8/1)
	var 2: t.2 (u8*/2)
	var 3: t.3 (bool/1)
	var 4: t.4 (u8/1)
	var 5: t.5 (bool/1)
	var 6: t.6 (u8/1)
	var 7: t.7 (u8/1)
	var 8: t.8 (u8/1)
	var 9: t.9 (u8/1)
	var 10: t.10 (u8/1)
	var 11: t.11 (u8/1)
	var 12: t.12 (bool/1)
	var 13: t.13 (u8/1)
	var 14: t.14 (bool/1)
	var 15: t.15 (u8/1)
	var 16: t.16 (u8/1)
	var 17: t.17 (u8/1)
	var 18: t.18 (bool/1)
	var 19: t.19 (u8/1)
	var 20: t.20 (u8/1)
	var 21: t.21 (u8/1)
	var 22: t.22 (u8/1)
	var 23: t.23 (bool/1)
	var 24: t.24 (u8/1)
	var 25: t.25 (u8/1)
	var 26: t.26 (u8/1)
	var 27: t.27 (u8/1)
	var 28: t.28 (u8/1)
	; 187 pc
	const t.2, [string-0]
	call printString@@u8[t.2]
	const i, 0
	; 19:2 for i < 16
@for_2:
	const t.4, 16
	lt t.3, i, t.4
	branch t.3, false, @for_2_break, @for_2_body
@for_2_body:
	; 20:3 if i & 7 == 0
	const t.7, 7
	move t.6, i
	and t.6, t.6, t.7
	const t.8, 0
	equals t.5, t.6, t.8
	branch t.5, false, @if_3_end, @if_3_then
@if_3_then:
	const t.9, 32
	call printChar@u8[t.9]
@if_3_end:
	call printNibble@u8[i]
@for_2_continue:
	const t.10, 1
	add i, i, t.10
	jump @for_2
@for_2_break:
	const t.11, 10
	call printChar@u8[t.11]
	const i, 32
	; 27:2 for i < 128
@for_4:
	const t.13, 128
	lt t.12, i, t.13
	branch t.12, false, @main_ret, @for_4_body
@for_4_body:
	; 28:3 if i & 15 == 0
	const t.16, 15
	move t.15, i
	and t.15, t.15, t.16
	const t.17, 0
	equals t.14, t.15, t.17
	branch t.14, false, @if_5_end, @if_5_then
@if_5_then:
	call printHex2@u8[i]
@if_5_end:
	; 31:3 if i & 7 == 0
	const t.20, 7
	move t.19, i
	and t.19, t.19, t.20
	const t.21, 0
	equals t.18, t.19, t.21
	branch t.18, false, @if_6_end, @if_6_then
@if_6_then:
	const t.22, 32
	call printChar@u8[t.22]
@if_6_end:
	call printChar@u8[i]
	; 35:3 if i & 15 == 15
	const t.25, 15
	move t.24, i
	and t.24, t.24, t.25
	const t.26, 15
	equals t.23, t.24, t.26
	branch t.23, false, @for_4_continue, @if_7_then
@if_7_then:
	const t.27, 10
	call printChar@u8[t.27]
@for_4_continue:
	const t.28, 1
	add i, i, t.28
	jump @for_4
@main_ret:

@printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

@printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

String literals
	string lit 0 " x\0"
