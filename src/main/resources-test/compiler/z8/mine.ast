i16 rowColumnToCell_Pu8_Pu8(u8 row, u8 column) {
	i16 r;
	i16 c;

	r = row as i16;
	c = column as i16;
	return (r * 38) + c;
}

i16 columnToX_Pu8(u8 column) {
	i16 c;

	c = column as i16;
	if (true) {
		return c;
	}
	return (c + 1) * 2;
}

void printCellAt_Pu8_Pu8(u8 row, u8 column) {
	u8 cell;

	cell = field[rowColumnToCell_Pu8_Pu8(row, column)];
	printCellAt_Pu8_Pu8_Pu8(cell, row, column);
}

void printCellAt_Pu8_Pu8_Pu8(u8 cell, u8 row, u8 column) {
	i16 x;

	x = columnToX_Pu8(column);
	setCursor_Pi16_Pi16(row as i16, x);
	printCell_Pu8_Pu8_Pu8(cell, row, column);
}

void printCell_Pu8_Pu8_Pu8(u8 cell, u8 row, u8 column) {
	u8 chr;
	i16 index;
	u8 count;

	chr = 46;
	if ((cell & 32) != 0) {
		if ((cell & 128) != 0) {
			chr = 42;
		}
		else {
			index = rowColumnToCell_Pu8_Pu8(row, column);
			count = field[index] & 15;
			if (count > 0) {
				chr = 48 + count;
			}
			else {
				chr = 32;
			}
		}
	}
	else {
		if ((cell & 64) != 0) {
			chr = 35;
		}
	}
	printChar_Pu8(chr);
}

void initializeScreen() {
	printChar_Pu8(12);
	printField();
}

void printField() {
	u8 row;
	u8 column;
	u8 cell;

	setCursor_Pi16_Pi16(0, 0);
	row = 0;
	for (; row < 20; row = row + 1) {
		setCursor_Pi16_Pi16(row as i16, 0);
		if (!(true)) {
			printChar_Pu8(124);
		}
		column = 0;
		for (; column < 38; column = column + 1) {
			if (!(true)) {
				printChar_Pu8(32);
			}
			cell = field[rowColumnToCell_Pu8_Pu8(row, column)];
			printCell_Pu8_Pu8_Pu8(cell, row, column);
		}
		if (!(true)) {
			printString_P_pu8(" |");
		}
	}
}

void showCursor_Pu8_Pu8_Pbool(u8 row, u8 column, bool show) {
	i16 x;
	i16 x;
	u8 chr;

	if (true) {
		if (show) {
			x = columnToX_Pu8(column);
			setCursor_Pi16_Pi16(row as i16, x);
		}
		return;
	}
	x = columnToX_Pu8(column);
	setCursor_Pi16_Pi16(row as i16, x - 1);
	chr = 32;
	if (show) {
		chr = 91;
	}
	printChar_Pu8(chr);
	setCursor_Pi16_Pi16(row as i16, x + 1);
	if (show) {
		chr = 93;
	}
	printChar_Pu8(chr);
}

i16 abs_Pi16(i16 a) {
	if (a < 0) {
		return -a;
	}
	return a;
}

void clearField() {
	i16 index;
	i16 i;

	index = 0;
	i = (38 as i16) * (20 as i16);
	for (; i > 0; i = i - 1, index = index + 1) {
		field[index] = 0;
	}
}

i16 initField_Pu8_Pu8(u8 curr_r, u8 curr_c) {
	i16 r;
	i16 c;
	i16 bombCount;
	i16 bombs;
	i16 row;
	i16 column;

	r = curr_r as i16;
	c = curr_c as i16;
	bombCount = 0;
	bombs = 68;
	for (; bombs > 0; bombs = bombs - 1) {
		row = (random16()) % 20;
		column = (random16()) % 38;
		if (((abs_Pi16(row - r)) > 1) || ((abs_Pi16(column - c)) > 1)) {
			if (setBomb_Pu8_Pu8(row as u8, column as u8)) {
				bombCount = bombCount + 1;
			}
		}
	}
	return bombCount;
}

bool setBomb_Pu8_Pu8(u8 row, u8 column) {
	i16 index;
	u8 rowFrom;
	u8 rowTo;
	u8 colFrom;
	u8 colTo;
	u8 count;
	u8 r;
	u8 c;
	u8 cell;
	u8 count;

	index = rowColumnToCell_Pu8_Pu8(row, column);
	if (field[index] == 128) {
		return false;
	}
	field[index] = 128;
	rowFrom = row;
	if (rowFrom > 0) {
		rowFrom = rowFrom - 1;
		index = index - 38;
	}
	rowTo = row + 1;
	if (rowTo >= 20) {
		rowTo = rowTo - 1;
	}
	colFrom = column;
	if (colFrom > 0) {
		colFrom = colFrom - 1;
		index = index - 1;
	}
	colTo = column + 1;
	if (colTo >= 38) {
		colTo = colTo - 1;
	}
	count = 0;
	r = rowFrom;
	for (; r <= rowTo; r = r + 1) {
		c = colFrom;
		for (; c <= colTo; c = c + 1, index = index + 1) {
			if ((r == row) && (c == column)) {
				continue;
			}
			cell = field[index];
			if ((cell & 128) == 0) {
				count = cell & 15;
				count = count + 1;
				field[index] = count;
			}
		}
		index = (((index - (colTo as i16)) + (colFrom as i16)) + 38) - 1;
	}
	return true;
}

void maybeRevealAround_Pu8_Pu8(u8 row, u8 column) {
	i16 index;
	bool changed;
	i16 index;
	u8 r;
	u8 c;
	u8 cell;
	u8 r;
	u8 c;
	u8 cell;

	printCellAt_Pu8_Pu8(row, column);
	index = rowColumnToCell_Pu8_Pu8(row, column);
	if ((field[index] & 15) != 0) {
		return;
	}
	changed = true;
	while (changed) {
		changed = false;
		index = 0;
		r = 0;
		for (; r < 20; r = r + 1) {
			c = 0;
			for (; c < 38; c = c + 1, index = index + 1) {
				cell = field[index];
				if (((cell & 32) == 0) || ((cell & 128) != 0)) {
					continue;
				}
				if ((field[index] & 15) != 0) {
					continue;
				}
				if (revealNeighbors_Pu8_Pu8(r, c)) {
					changed = true;
				}
			}
		}
		if (!changed) {
			break;
		}
		r = 20;
		while (true) {
			if (r == 0) {
				break;
			}
			r = r - 1;
			c = 38;
			while (true) {
				if (c == 0) {
					break;
				}
				c = c - 1;
				index = index - 1;
				cell = field[index];
				if (((cell & 32) == 0) || ((cell & 128) != 0)) {
					continue;
				}
				if ((field[index] & 15) != 0) {
					continue;
				}
				if (revealNeighbors_Pu8_Pu8(r, c)) {
					changed = true;
				}
			}
		}
	}
}

bool revealNeighbors_Pu8_Pu8(u8 row, u8 column) {
	u8 rowFrom;
	u8 rowTo;
	u8 colFrom;
	u8 colTo;
	i16 index;
	bool changed;
	u8 r;
	u8 c;
	u8 cell;

	rowFrom = row;
	if (rowFrom > 0) {
		rowFrom = rowFrom - 1;
	}
	rowTo = row + 1;
	if (rowTo >= 20) {
		rowTo = rowTo - 1;
	}
	colFrom = column;
	if (colFrom > 0) {
		colFrom = colFrom - 1;
	}
	colTo = column + 1;
	if (colTo >= 38) {
		colTo = colTo - 1;
	}
	index = rowColumnToCell_Pu8_Pu8(rowFrom, colFrom);
	changed = false;
	r = rowFrom;
	for (; r <= rowTo; r = r + 1) {
		c = colFrom;
		for (; c <= colTo; c = c + 1, index = index + 1) {
			cell = field[index];
			if ((cell & 32) != 0) {
				continue;
			}
			cell = cell | 32;
			field[index] = cell;
			printCellAt_Pu8_Pu8_Pu8(cell, r, c);
			changed = true;
		}
		index = (((index - (colTo as i16)) + (colFrom as i16)) + 38) - 1;
	}
	return changed;
}

void main() {
	u8 col;
	u8 row;
	i16 bombsLeft;
	i16 chr;
	i16 index;
	u8 cell;
	i16 index;
	u8 cell;

	initRandom_Pi32(7439742);
	clearField();
	initializeScreen();
	setCursor_Pi16_Pi16(20, 0);
	col = 38 / 2;
	row = 20 / 2;
	bombsLeft = -1;
	while (true) {
		if (bombsLeft == 0) {
			printString_P_pu8(" You've cleaned the field!");
			break;
		}
		showCursor_Pu8_Pu8_Pbool(row, col, true);
		chr = getChar();
		showCursor_Pu8_Pu8_Pbool(row, col, false);
		if (chr == 27) {
			break;
		}
		if (chr == 13) {
			if (bombsLeft < 0) {
				bombsLeft = initField_Pu8_Pu8(row, col);
			}
			index = rowColumnToCell_Pu8_Pu8(row, col);
			cell = field[index];
			if ((cell & 32) == 0) {
				field[index] = cell | 32;
			}
			if ((cell & 128) != 0) {
				printCellAt_Pu8_Pu8(row, col);
				printString_P_pu8("boom! you've lost");
				break;
			}
			maybeRevealAround_Pu8_Pu8(row, col);
		}
		else {
			if (chr == 3) {
				if (row > 0) {
					row = row - 1;
				}
			}
			else {
				if (chr == 4) {
					if (row < (20 - 1)) {
						row = row + 1;
					}
				}
				else {
					if (chr == 1) {
						if (col > 0) {
							col = col - 1;
						}
					}
					else {
						if (chr == 2) {
							if (col < (38 - 1)) {
								col = col + 1;
							}
						}
						else {
							if (chr == 32) {
								if (bombsLeft >= 0) {
									index = rowColumnToCell_Pu8_Pu8(row, col);
									cell = field[index];
									if ((cell & 32) == 0) {
										cell = cell ^ 64;
										if ((cell & 128) != 0) {
											if ((cell & 64) != 0) {
												bombsLeft = bombsLeft - 1;
											}
											else {
												bombsLeft = bombsLeft + 1;
											}
										}
										field[index] = cell;
										printCellAt_Pu8_Pu8_Pu8(cell, row, col);
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
