u8* field[760];

void printString@@u8(u8* str) asm {
}

void printChar@u8(u8 chr) asm {
}

void setCursor@i16@i16(i16 row, i16 column) asm {
}

i16 getChar() asm {
}

void initRandom@i32(i32 salt) asm {
}

i16 random16() asm {
}

i16 rowColumnToCell@u8@u8(u8 row, u8 column) {
	i16 r;
	i16 c;

	r = (i16)row;
	c = (i16)column;
	return (r * 38) + c;
}

u8 getBombCountAround@u8@u8(u8 row, u8 column) {
	i16 index;

	index = rowColumnToCell@u8@u8(row, column);
	return field[index] & 15;
}

i16 columnToX@u8(u8 column) {
	i16 c;

	c = (i16)column;
	if (true) {
		return c;
	}
	return (c + 1) * 2;
}

void printCellAt@u8@u8(u8 row, u8 column) {
	u8 cell;

	cell = field[rowColumnToCell@u8@u8(row, column)];
	printCellAt@u8@u8@u8(cell, row, column);
}

void printCellAt@u8@u8@u8(u8 cell, u8 row, u8 column) {
	i16 x;

	x = columnToX@u8(column);
	setCursor@i16@i16((i16)row, x);
	printCell@u8@u8@u8(cell, row, column);
}

void printCell@u8@u8@u8(u8 cell, u8 row, u8 column) {
	u8 chr;
	u8 count;

	chr = 46;
	if ((cell & 32) != 0) {
		if ((cell & 128) != 0) {
			chr = 42;
		}
		else {
			count = getBombCountAround@u8@u8(row, column);
			if (count > 0) {
				chr = 48 + count;
			}
			else {
				chr = 32;
			}
		}
	}
	else {
		if ((cell & 64) != 0) {
			chr = 35;
		}
	}
	printChar@u8(chr);
}

void initializeScreen() {
	printChar@u8(12);
	printField();
}

void printField() {
	u8 row;
	u8 column;
	u8 cell;

	setCursor@i16@i16(0, 0);
	row = 0;
	for (; row < 20; row = row + 1) {
		setCursor@i16@i16((i16)row, 0);
		if (!(true)) {
			printChar@u8(124);
		}
		column = 0;
		for (; column < 38; column = column + 1) {
			if (!(true)) {
				printChar@u8(32);
			}
			cell = field[rowColumnToCell@u8@u8(row, column)];
			printCell@u8@u8@u8(cell, row, column);
		}
		if (!(true)) {
			printString@@u8(" |");
		}
	}
}

void showCursor@u8@u8@bool(u8 row, u8 column, bool show) {
	i16 x;
	i16 x;
	u8 chr;

	if (true) {
		if (show) {
			x = columnToX@u8(column);
			setCursor@i16@i16((i16)row, x);
		}
		return;
	}
	x = columnToX@u8(column);
	setCursor@i16@i16((i16)row, x - 1);
	chr = 32;
	if (show) {
		chr = 91;
	}
	printChar@u8(chr);
	setCursor@i16@i16((i16)row, x + 1);
	if (show) {
		chr = 93;
	}
	printChar@u8(chr);
}

i16 abs@i16(i16 a) {
	if (a < 0) {
		return -a;
	}
	return a;
}

void clearField() {
	i16 index;
	i16 i;

	index = 0;
	i = ((i16)38) * ((i16)20);
	for (; i > 0; i = i - 1, index = index + 1) {
		field[index] = 0;
	}
}

i16 initField@u8@u8(u8 curr_r, u8 curr_c) {
	i16 r;
	i16 c;
	i16 bombCount;
	i16 bombs;
	i16 row;
	i16 column;

	r = (i16)curr_r;
	c = (i16)curr_c;
	bombCount = 0;
	bombs = 68;
	for (; bombs > 0; bombs = bombs - 1) {
		row = (random16()) % 20;
		column = (random16()) % 38;
		if (((abs@i16(row - r)) > 1) || ((abs@i16(column - c)) > 1)) {
			if (setBomb@u8@u8((u8)row, (u8)column)) {
				bombCount = bombCount + 1;
			}
		}
	}
	return bombCount;
}

bool setBomb@u8@u8(u8 row, u8 column) {
	i16 index;
	u8 rowFrom;
	u8 rowTo;
	u8 colFrom;
	u8 colTo;
	u8 count;
	u8 r;
	u8 c;
	u8 cell;
	u8 count;

	index = rowColumnToCell@u8@u8(row, column);
	if (field[index] == 128) {
		return false;
	}
	field[index] = 128;
	rowFrom = row;
	if (rowFrom > 0) {
		rowFrom = row - 1;
		index = index - 38;
	}
	rowTo = row + 1;
	if (rowTo >= 20) {
		rowTo = rowTo - 1;
	}
	colFrom = column;
	if (colFrom > 0) {
		colFrom = colFrom - 1;
		index = index - 1;
	}
	colTo = column + 1;
	if (colTo >= 38) {
		colTo = colTo - 1;
	}
	count = 0;
	r = rowFrom;
	for (; r <= rowTo; r = r + 1) {
		c = colFrom;
		for (; c <= colTo; c = c + 1, index = index + 1) {
			if ((r == row) && (c == column)) {
				continue;
			}
			cell = field[index];
			if ((cell & 128) == 0) {
				count = cell & 15;
				count = count + 1;
				field[index] = count;
			}
		}
		index = (((index - ((i16)colTo)) + ((i16)colFrom)) + 38) - 1;
	}
	return true;
}

void maybeRevealAround@u8@u8(u8 row, u8 column) {
	bool changed;
	i16 index;
	u8 r;
	u8 c;
	u8 cell;
	u8 r;
	u8 c;
	u8 cell;

	printCellAt@u8@u8(row, column);
	if ((getBombCountAround@u8@u8(row, column)) != 0) {
		return;
	}
	changed = true;
	while (changed) {
		changed = false;
		index = 0;
		r = 0;
		for (; r < 20; r = r + 1) {
			c = 0;
			for (; c < 38; c = c + 1, index = index + 1) {
				cell = field[index];
				if (((cell & 32) == 0) || ((cell & 128) != 0)) {
					continue;
				}
				if ((getBombCountAround@u8@u8(r, c)) != 0) {
					continue;
				}
				if (revealNeighbors@u8@u8(r, c)) {
					changed = true;
				}
			}
		}
		if (!changed) {
			break;
		}
		r = 20;
		while (true) {
			if (r == 0) {
				break;
			}
			r = r - 1;
			c = 38;
			while (true) {
				if (c == 0) {
					break;
				}
				c = c - 1;
				index = index - 1;
				cell = field[index];
				if (((cell & 32) == 0) || ((cell & 128) != 0)) {
					continue;
				}
				if ((getBombCountAround@u8@u8(r, c)) != 0) {
					continue;
				}
				if (revealNeighbors@u8@u8(r, c)) {
					changed = true;
				}
			}
		}
	}
}

bool revealNeighbors@u8@u8(u8 row, u8 column) {
	u8 rowFrom;
	u8 rowTo;
	u8 colFrom;
	u8 colTo;
	i16 index;
	bool changed;
	u8 r;
	u8 c;
	u8 cell;

	rowFrom = row;
	if (rowFrom > 0) {
		rowFrom = rowFrom - 1;
	}
	rowTo = row + 1;
	if (rowTo >= 20) {
		rowTo = rowTo - 1;
	}
	colFrom = column;
	if (colFrom > 0) {
		colFrom = colFrom - 1;
	}
	colTo = column + 1;
	if (colTo >= 38) {
		colTo = colTo - 1;
	}
	index = rowColumnToCell@u8@u8(rowFrom, colFrom);
	changed = false;
	r = rowFrom;
	for (; r <= rowTo; r = r + 1) {
		c = colFrom;
		for (; c <= colTo; c = c + 1, index = index + 1) {
			cell = field[index];
			if ((cell & 32) != 0) {
				continue;
			}
			cell = cell | 32;
			field[index] = cell;
			printCellAt@u8@u8@u8(cell, r, c);
			changed = true;
		}
		index = (((index - ((i16)colTo)) + ((i16)colFrom)) + 38) - 1;
	}
	return changed;
}

void main() {
	u8 col;
	u8 row;
	i16 bombsLeft;
	i16 chr;
	i16 index;
	u8 cell;
	i16 index;
	u8 cell;

	initRandom@i32(7439742);
	clearField();
	initializeScreen();
	setCursor@i16@i16(20, 0);
	col = 38 / 2;
	row = 20 / 2;
	bombsLeft = -1;
	while (true) {
		if (bombsLeft == 0) {
			printString@@u8(" You've cleaned the field!");
			break;
		}
		showCursor@u8@u8@bool(row, col, true);
		chr = getChar();
		showCursor@u8@u8@bool(row, col, false);
		if (chr == 27) {
			break;
		}
		if (chr == 13) {
			if (bombsLeft < 0) {
				bombsLeft = initField@u8@u8(row, col);
			}
			index = rowColumnToCell@u8@u8(row, col);
			cell = field[index];
			if ((cell & 32) == 0) {
				field[index] = cell | 32;
			}
			if ((cell & 128) != 0) {
				printCellAt@u8@u8(row, col);
				printString@@u8("boom! you've lost");
				break;
			}
			maybeRevealAround@u8@u8(row, col);
		}
		else {
			if (chr == 3) {
				if (row > 0) {
					row = row - 1;
				}
			}
			else {
				if (chr == 4) {
					if (row < (20 - 1)) {
						row = row + 1;
					}
				}
				else {
					if (chr == 1) {
						if (col > 0) {
							col = col - 1;
						}
					}
					else {
						if (chr == 2) {
							if (col < (38 - 1)) {
								col = col + 1;
							}
						}
						else {
							if (chr == 32) {
								if (bombsLeft >= 0) {
									index = rowColumnToCell@u8@u8(row, col);
									cell = field[index];
									if ((cell & 32) == 0) {
										cell = cell ^ 64;
										if ((cell & 128) != 0) {
											if ((cell & 64) != 0) {
												bombsLeft = bombsLeft - 1;
											}
											else {
												bombsLeft = bombsLeft + 1;
											}
										}
										field[index] = cell;
										printCellAt@u8@u8@u8(cell, row, col);
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
