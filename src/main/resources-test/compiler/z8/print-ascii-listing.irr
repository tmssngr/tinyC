printNibble@u8:
 Local variables
	arg 0: x (u8/1)
	; 7 pc
	move x.1{r8}, param.x{r0}
	and x.1{r8}, 15
	branch x.1{r8} lteq 9: if_1_end
	add x.3{r8}, 7
if_1_end:
	move x.4{r0}, x.2{r8}
	add x.4{r0}, 48
	call printChar@u8[x.4{r0}]

printHex2@u8:
 Local variables
	arg 0: x (u8/1)
	; 5 pc
	move param.x{r8}, x{r0}
	shiftright t.1.1{r0}, 4
	call printNibble@u8[t.1.1{r0}]
	move param.x{r0}, param.x{r8}
	call printNibble@u8[param.x{r0}]

main:
	; 32 pc
	const t.2.1{r0}, [string-0]
	call printString@@u8[t.2.1{r0}]
	const i.1{r8}, 0
	jump for_2
for_2_body:
	move t.3.1{r9}, i.2{r8}
	and t.3.1{r9}, 7
	branch t.3.1{r9} notequals 0: if_3_end
	const arg.1.0{r0}, 32
	call printChar@u8[arg.1.0{r0}]
if_3_end:
	move i.2{r0}, i.2{r8}
	call printNibble@u8[i.2{r0}]
	add i.7{r8}, 1
for_2:
	branch i.2{r8} lt 16: for_2_body
	const arg.3.0{r0}, 10
	call printChar@u8[arg.3.0{r0}]
	const i.3{r8}, 32
	jump for_4
for_4_body:
	move t.4.1{r9}, i.4{r8}
	and t.4.1{r9}, 15
	branch t.4.1{r9} notequals 0: if_5_end
	move i.4{r0}, i.4{r8}
	call printHex2@u8[i.4{r0}]
if_5_end:
	move t.5.1{r9}, i.4{r8}
	and t.5.1{r9}, 7
	branch t.5.1{r9} notequals 0: if_6_end
	const arg.5.0{r0}, 32
	call printChar@u8[arg.5.0{r0}]
if_6_end:
	move i.4{r0}, i.4{r8}
	call printChar@u8[i.4{r0}]
	move t.6.1{r9}, i.4{r8}
	and t.6.1{r9}, 15
	branch t.6.1{r9} notequals 15: for_4_continue
	const arg.7.0{r0}, 10
	call printChar@u8[arg.7.0{r0}]
for_4_continue:
	move i.10{r0}, i.4{r8}
	add i.10{r0}, 1
	move i.4{r8}, i.10{r0}
for_4:
	branch i.4{r8} lt 128: for_4_body

printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

String literals
	string lit 0 " x\0"
