printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 0 pc
printIntLf@u8_ret:

main:
 Local variables
	var 0: i (u8/1)
	var 1: v (i16/2)
	var 2: t.2 (u8/1)
	; 24 pc
	const i, 250
	; 4:3 for i != 2
for_1:
	branch i equals 2: for_1_break, for_1_body
for_1_body:
	call printIntLf@u8[i]
for_1_continue:
	add i, i, 1
	jump for_1
for_1_break:
	const v, 260
	cast t.2(u8), v(i16)
	call printIntLf@u8[t.2]
main_ret:

