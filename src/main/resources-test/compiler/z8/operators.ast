void printString_P_pu8(u8* str) asm {
}

void printChar_Pu8(u8 chr) asm {
}

void printUint_Pi16(i16 number) {
	printUint_Pi32(number as i32);
}

void printUint_Pi32(i32 number) asm {
}

void printIntLf_Pbool(bool value) {
	u8 number;

	number = 0;
	if (value) {
		number = 1;
	}
	printIntLf_Pi16(number as i16);
}

void printIntLf_Pu8(u8 number) {
	printIntLf_Pi16(number as i16);
}

void printIntLf_Pi16(i16 number) {
	if (number < 0) {
		printChar_Pu8(45);
		number = -number;
	}
	printUint_Pi16(number);
	printChar_Pu8(13);
}

bool getTrue() {
	printString_P_pu8(" true");
	return true;
}

bool getFalse() {
	printString_P_pu8(" false");
	return false;
}

void printPass() {
	printString_P_pu8(" -> pass ");
}

void printError() {
	printString_P_pu8(" -> ERROR ");
}

void logicNot() {
	bool t;
	bool f;

	printString_P_pu8("\nLogic-!:\n");
	t = true;
	f = false;
	if (!(getFalse())) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf_Pbool(!f);
	if (!(getTrue())) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf_Pbool(!t);
}

void logicAnd() {
	bool t;
	bool f;

	printString_P_pu8("\nLogic-&&:\n");
	t = true;
	f = false;
	if ((getFalse()) && (getFalse())) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf_Pbool(f && f);
	if ((getFalse()) && (getTrue())) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf_Pbool(f && t);
	if ((getTrue()) && (getFalse())) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf_Pbool(t && f);
	if ((getTrue()) && (getTrue())) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf_Pbool(t && t);
	if (!((getFalse()) && (getFalse()))) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf_Pbool(!(f && f));
	if (!((getFalse()) && (getTrue()))) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf_Pbool(!(f && t));
	if (!((getTrue()) && (getFalse()))) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf_Pbool(!(t && f));
	if (!((getTrue()) && (getTrue()))) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf_Pbool(!(t && t));
}

void logicOr() {
	bool t;
	bool f;

	printString_P_pu8("\nLogic-||:\n");
	t = true;
	f = false;
	if ((getFalse()) || (getFalse())) {
		printError();
	}
	else {
		printPass();
	}
	printIntLf_Pbool(f || f);
	if ((getFalse()) || (getTrue())) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf_Pbool(f || t);
	if ((getTrue()) || (getFalse())) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf_Pbool(t || f);
	if ((getTrue()) || (getTrue())) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf_Pbool(t || t);
}

void main() {
	i16 a;
	i16 b;
	i16 c;
	i16 d;
	bool t;
	bool f;
	u8 b10;
	u8 b6;
	u8 b1;

	printString_P_pu8("Bit-&:\n");
	a = 0;
	b = 1;
	c = 2;
	d = 3;
	t = true;
	f = false;
	printIntLf_Pi16(a & a);
	printIntLf_Pi16(a & b);
	printIntLf_Pi16(b & a);
	printIntLf_Pi16(b & b);
	printString_P_pu8("\nBit-|:\n");
	printIntLf_Pi16(a | a);
	printIntLf_Pi16(a | b);
	printIntLf_Pi16(b | a);
	printIntLf_Pi16(b | b);
	printString_P_pu8("\nBit-^:\n");
	printIntLf_Pi16(a ^ a);
	printIntLf_Pi16(a ^ c);
	printIntLf_Pi16(b ^ a);
	printIntLf_Pi16(b ^ c);
	logicNot();
	logicAnd();
	logicOr();
	if ((!((getTrue()) && (getTrue()))) || (!((getFalse()) && (getFalse())))) {
		printPass();
	}
	else {
		printError();
	}
	printIntLf_Pbool((!(t && t)) || (!(f && f)));
	printString_P_pu8("\n\nmisc:\n");
	b10 = 10;
	b6 = 6;
	b1 = 1;
	printIntLf_Pu8((b10 & b6) | b1);
	printIntLf_Pbool((b == c) || (c < d));
	printIntLf_Pbool((b == c) && (c < d));
	printIntLf_Pi16(-1);
	printIntLf_Pi16(-b);
	printIntLf_Pu8(~b1);
}
