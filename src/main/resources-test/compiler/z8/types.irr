printIntLf@u8:
 Local variables
	arg 0: number (u8/1)

main:
	; 7 pc
	const i.1{r8}, 250
	jump for_1
for_1_body:
	move i.2{r0}, i.2{r8}
	call printIntLf@u8[i.2{r0}]
	add i.3{r8}, 1
for_1:
	branch i.2{r8} notequals 2: for_1_body
	const v.1{r8}, 260
	cast t.2.1{r0}(u8), v.1{r8}(i16)
	call printIntLf@u8[t.2.1{r0}]

