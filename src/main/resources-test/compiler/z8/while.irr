printIntLf@u8:
 Local variables
	arg 0: number (u8/1)

main:
	; 9 pc
	const i.1{r8}, 5
	jump while_1
while_1_body:
	move i.2{r0}, i.2{r8}
	call printIntLf@u8[i.2{r0}]
	sub i.4{r8}, 1
while_1:
	branch i.2{r8} gt 0: while_1_body, while_2
while_2:
	move i.3{r0}, i.3{r8}
	call printIntLf@u8[i.3{r0}]
	add i.5{r8}, 1
	branch i.5{r8} lt 5: while_2

