printIntLf@u8:
 Local variables
	arg 0: number (u8/1)

main:
	; 9 pc
	const i{r8}, 5
	; 5:2 while i > 0
	jump while_1
while_1_body:
	move i{r0}, i{r8}
	call printIntLf@u8[i{r0}]
	sub i{r8}, i{r8}, 1
while_1:
	branch i{r8} gt 0: while_1_body, while_2
while_2:
	move i{r0}, i{r8}
	call printIntLf@u8[i{r0}]
	add i{r8}, i{r8}, 1
	; 13:3 if i < 5
	branch i{r8} lt 5: while_2, main_ret

