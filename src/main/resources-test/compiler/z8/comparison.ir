printUint@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (i32/4)

	cast t.1(i32), number(i16)
	call printUint@i32[t.1]
printUint@i16_ret:

printIntLf@bool:
 Local variables
	arg 0: value (bool/1)
	var 1: number (u8/1)
	var 2: t.2 (i16/2)

	const number, 0
	branch value equals 0: if_1_end, if_1_then
if_1_then:
	const number, 1
if_1_end:
	cast t.2(i16), number(u8)
	call printIntLf@i16[t.2]
printIntLf@bool_ret:

printIntLf@i16:
 Local variables
	arg 0: number (i16/2)

	branch number gteq 0: if_2_end, if_2_then
if_2_then:
	call printChar@u8[45]
	neg number, number
if_2_end:
	call printUint@i16[number]
	call printChar@u8[13]
printIntLf@i16_ret:

main:
 Local variables
	var 0: a (i16/2)
	var 1: b (i16/2)
	var 2: c (u8/1)
	var 3: d (u8/1)
	var 4: t.4 (u8*/2)
	var 5: t.5 (bool/1)
	var 6: t.6 (bool/1)
	var 7: t.7 (u8*/2)
	var 8: t.8 (bool/1)
	var 9: t.9 (bool/1)
	var 10: t.10 (u8*/2)
	var 11: t.11 (bool/1)
	var 12: t.12 (bool/1)
	var 13: t.13 (u8*/2)
	var 14: t.14 (bool/1)
	var 15: t.15 (bool/1)
	var 16: t.16 (u8*/2)
	var 17: t.17 (bool/1)
	var 18: t.18 (bool/1)
	var 19: t.19 (u8*/2)
	var 20: t.20 (bool/1)
	var 21: t.21 (bool/1)
	var 22: t.22 (u8*/2)
	var 23: t.23 (bool/1)
	var 24: t.24 (bool/1)
	var 25: t.25 (u8*/2)
	var 26: t.26 (bool/1)
	var 27: t.27 (bool/1)
	var 28: t.28 (u8*/2)
	var 29: t.29 (bool/1)
	var 30: t.30 (bool/1)
	var 31: t.31 (u8*/2)
	var 32: t.32 (bool/1)
	var 33: t.33 (bool/1)

	const t.4, [string-0]
	call printString@@u8[t.4]
	const a, 1
	const b, 2
	lt t.5, a, b
	call printIntLf@bool[t.5]
	lt t.6, b, a
	call printIntLf@bool[t.6]
	const t.7, [string-1]
	call printString@@u8[t.7]
	const c, 0
	const d, 128
	lt t.8, c, d
	call printIntLf@bool[t.8]
	lt t.9, d, c
	call printIntLf@bool[t.9]
	const t.10, [string-2]
	call printString@@u8[t.10]
	lteq t.11, a, b
	call printIntLf@bool[t.11]
	lteq t.12, b, a
	call printIntLf@bool[t.12]
	const t.13, [string-3]
	call printString@@u8[t.13]
	lteq t.14, c, d
	call printIntLf@bool[t.14]
	lteq t.15, d, c
	call printIntLf@bool[t.15]
	const t.16, [string-4]
	call printString@@u8[t.16]
	equals t.17, a, b
	call printIntLf@bool[t.17]
	equals t.18, b, a
	call printIntLf@bool[t.18]
	const t.19, [string-5]
	call printString@@u8[t.19]
	notequals t.20, a, b
	call printIntLf@bool[t.20]
	notequals t.21, b, a
	call printIntLf@bool[t.21]
	const t.22, [string-6]
	call printString@@u8[t.22]
	gteq t.23, a, b
	call printIntLf@bool[t.23]
	gteq t.24, b, a
	call printIntLf@bool[t.24]
	const t.25, [string-7]
	call printString@@u8[t.25]
	gteq t.26, c, d
	call printIntLf@bool[t.26]
	gteq t.27, d, c
	call printIntLf@bool[t.27]
	const t.28, [string-8]
	call printString@@u8[t.28]
	gt t.29, a, b
	call printIntLf@bool[t.29]
	gt t.30, b, a
	call printIntLf@bool[t.30]
	const t.31, [string-9]
	call printString@@u8[t.31]
	gt t.32, c, d
	call printIntLf@bool[t.32]
	gt t.33, d, c
	call printIntLf@bool[t.33]
main_ret:

printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

String literals
	string lit 0 "< (signed)\n\0"
	string lit 1 "< (unsigned)\n\0"
	string lit 2 "<= (signed)\n\0"
	string lit 3 "<= (unsigned)\n\0"
	string lit 4 "==\n\0"
	string lit 5 "!=\n\0"
	string lit 6 ">= (signed)\n\0"
	string lit 7 ">= (unsigned)\n\0"
	string lit 8 "> (signed)\n\0"
	string lit 9 "> (unsigned)\n\0"
