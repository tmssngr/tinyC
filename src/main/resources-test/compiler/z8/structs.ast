void printChar@u8(u8 chr) asm {
}

void printUint@i16(i16 number) {
	printUint@i32(number as i32);
}

void printUint@i32(i32 number) asm {
}

void printIntLf@u8(u8 number) {
	printIntLf@i16(number as i16);
}

void printIntLf@i16(i16 number) {
	if (number < 0) {
		printChar@u8(45);
		number = -number;
	}
	printUint@i16(number);
	printChar@u8(13);
}

void main() {
	Pos pos;
	u8* x;

	pos.x = 1;
	pos.y = (pos.x) + 1;
	printIntLf@u8(pos.x);
	printIntLf@u8(pos.y);
	x = &(pos.x);
	printIntLf@u8(*x);
}
