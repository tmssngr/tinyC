void printIntLf_Pi16(i16 number) {
	if (number < 0) {
		printChar_Pu8(45);
		number = -number;
	}
	printUint_Pi16(number);
	printChar_Pu8(13);
}

void main() {
	i16 a;

	a = 1;
	if (a > 0) {
		printIntLf_Pi16(a);
	}
	else {
		a = -a;
		printIntLf_Pi16(a);
	}
}
