@printUint@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (i32/4)
	; 8 pc
	cast t.1(i32), number(i16)
	call printUint@i32[t.1]
@printUint@i16_ret:

@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 0 pc
@printIntLf@u8_ret:

@printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (bool/1)
	var 2: t.2 (i16/2)
	var 3: t.3 (u8/1)
	var 4: t.4 (u8/1)
	; 30 pc
	; 127:2 if number < 0
	const t.2, 0
	lt t.1, number, t.2
	branch t.1, false, @if_1_end, @if_1_then
@if_1_then:
	const t.3, 45
	call printChar@u8[t.3]
	neg number, number
@if_1_end:
	call printUint@i16[number]
	const t.4, 13
	call printChar@u8[t.4]
@printIntLf@i16_ret:

@main:
 Local variables
	var 0: second (u8*/2)
	var 1: chr (u8/1)
	var 2: t.2 (i16/2)
	; 33 pc
	; begin initialize global variables
	const text, [string-0]
	; end initialize global variables
	call printString@@u8[text]
	call printLength[]
	const t.2, 1
	move second, text
	add second, second, t.2
	call printString@@u8[second]
	load chr, [text]
	call printIntLf@u8[chr]
@main_ret:

@printLength:
 Local variables
	var 0: length (i16/2)
	var 1: ptr (u8*/2)
	var 2: t.2 (bool/1)
	var 3: t.3 (u8/1)
	var 4: t.4 (u8/1)
	var 5: t.5 (i16/2)
	var 6: t.6 (i16/2)
	; 47 pc
	const length, 0
	move ptr, text
	; 16:2 for *ptr != 0
@for_2:
	load t.3, [ptr]
	const t.4, 0
	notequals t.2, t.3, t.4
	branch t.2, false, @for_2_break, @for_2_body
@for_2_body:
	const t.5, 1
	add length, length, t.5
@for_2_continue:
	const t.6, 1
	add ptr, ptr, t.6
	jump @for_2
@for_2_break:
	call printIntLf@i16[length]
@printLength_ret:

@printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

@printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

@printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

Global variables
	0: text (u8*/2)

String literals
	string lit 0 "hello world\n\0"
