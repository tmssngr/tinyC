void printIntLf_Pi16(i16 number) {
	if (number < 0) {
		printChar_Pu8(45);
		number = -number;
	}
	printUint_Pi16(number);
	printChar_Pu8(13);
}

void main() {
	u8* second;
	u8 chr;

	printString_P_pu8(text);
	printLength();
	second = &text[1];
	printString_P_pu8(second);
	chr = *text;
	printIntLf_Pu8(chr);
}

void printLength() {
	i16 length;
	u8* ptr;

	length = 0;
	ptr = text;
	for (; (*ptr) != 0; ptr = ptr + 1) {
		length = length + 1;
	}
	printIntLf_Pi16(length);
}
