void printString_P_pu8(u8* str) asm {
}

void printChar_Pu8(u8 chr) asm {
}

void printNibble_Pu8(u8 x) {
	x = x & 15;
	if (x > 9) {
		x = x + 7;
	}
	x = x + 48;
	printChar_Pu8(x);
}

void printHex2_Pu8(u8 x) {
	printNibble_Pu8(x >> 4);
	printNibble_Pu8(x);
}

void main() {
	u8 i;
	u8 i;

	printString_P_pu8(" x");
	i = 0;
	for (; i < 16; i = i + 1) {
		if ((i & 7) == 0) {
			printChar_Pu8(32);
		}
		printNibble_Pu8(i);
	}
	printChar_Pu8(10);
	i = 32;
	for (; i < 128; i = i + 1) {
		if ((i & 15) == 0) {
			printHex2_Pu8(i);
		}
		if ((i & 7) == 0) {
			printChar_Pu8(32);
		}
		printChar_Pu8(i);
		if ((i & 15) == 15) {
			printChar_Pu8(10);
		}
	}
}
