u8 i;

void printChar@u8(u8 chr) asm {
}

void printUint@i16(i16 number) {
	printUint@i32(number as i32);
}

void printUint@i32(i32 number) asm {
}

void printIntLf@u8(u8 number) {
	printIntLf@i16(number as i16);
}

void printIntLf@i16(i16 number) {
	if (number < 0) {
		printChar@u8(45);
		number = -number;
	}
	printUint@i16(number);
	printChar@u8(13);
}

void main() {
	doPrint@u8@u8@u8@u8@u8(next(), next(), next(), next(), next());
}

u8 next() {
	i = i + 1;
	return i;
}

void doPrint@u8@u8@u8@u8@u8(u8 a, u8 b, u8 c, u8 d, u8 e) {
	printIntLf@u8(a);
	printIntLf@u8(b);
	printIntLf@u8(c);
	printIntLf@u8(d);
	printIntLf@u8(e);
}
