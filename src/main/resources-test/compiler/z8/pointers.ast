void printChar_Pu8(u8 chr) asm {
}

void printUint_Pi16(i16 number) {
	printUint_Pi32(number as i32);
}

void printUint_Pi32(i32 number) asm {
}

void printIntLf_Pu8(u8 number) {
	printIntLf_Pi16(number as i16);
}

void printIntLf_Pi16(i16 number) {
	if (number < 0) {
		printChar_Pu8(45);
		number = -number;
	}
	printUint_Pi16(number);
	printChar_Pu8(13);
}

void testIf_Pu8(u8 a) {
	u8 b;
	u8* b_ref;

	b = 1;
	b_ref = &b;
	if (a == 0) {
		printIntLf_Pu8(*b_ref);
	}
	printIntLf_Pu8(b);
}

void main() {
	i16 a;
	i16* b;
	i16 c;
	i16* d;

	a = 10;
	printIntLf_Pi16(a);
	b = &a;
	c = (*b) - 1;
	printIntLf_Pi16(c);
	d = &c;
	*d = (*d) - 1;
	printIntLf_Pi16(c);
	testIf_Pu8(1);
}
