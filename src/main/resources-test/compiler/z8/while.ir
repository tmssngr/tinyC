@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 0 pc
@printIntLf@u8_ret:

@main:
 Local variables
	var 0: i (u8/1)
	var 1: t.1 (bool/1)
	var 2: t.2 (u8/1)
	var 3: t.3 (u8/1)
	var 4: t.4 (u8/1)
	var 5: t.5 (bool/1)
	var 6: t.6 (u8/1)
	; 51 pc
	const i, 5
	; 5:2 while i > 0
@while_1:
	const t.2, 0
	gt t.1, i, t.2
	branch t.1, false, @while_1_break, @while_1_body
@while_1_body:
	call printIntLf@u8[i]
	const t.3, 1
	sub i, i, t.3
	jump @while_1
@while_1_break:
	; 10:2 while true
@while_2:
	call printIntLf@u8[i]
	const t.4, 1
	add i, i, t.4
	; 13:3 if i < 5
	const t.6, 5
	lt t.5, i, t.6
	branch t.5, true, @while_2, @while_2_break
@while_2_break:
	; 19:2 while true
@while_4:
	; 20:3 return
@main_ret:

