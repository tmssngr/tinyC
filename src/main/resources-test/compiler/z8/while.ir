@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 0 pc
@printIntLf@u8_ret:

@main:
 Local variables
	var 0: i (u8/1)
	var 1: t.1 (bool/1)
	var 2: t.2 (bool/1)
	; 35 pc
	const i, 5
	; 5:2 while i > 0
@while_1:
	gt t.1, i, 0
	branch t.1, false, @while_1_break, @while_1_body
@while_1_body:
	call printIntLf@u8[i]
	sub i, i, 1
	jump @while_1
@while_1_break:
	; 10:2 while true
@while_2:
	call printIntLf@u8[i]
	add i, i, 1
	; 13:3 if i < 5
	lt t.2, i, 5
	branch t.2, true, @while_2, @while_2_break
@while_2_break:
	; 19:2 while true
@while_4:
	; 20:3 return
@main_ret:

