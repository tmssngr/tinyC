void printChar@u8(u8 chr) asm {
}

void printUint@i16(i16 number) {
	printUint@i32((i32)number);
}

void printUint@i32(i32 number) asm {
}

void printIntLf@i16(i16 number) {
	if (number < 0) {
		printChar@u8(45);
		number = -number;
	}
	printUint@i16(number);
	printChar@u8(13);
}

void main() {
	i16 foo;
	i16 bar;
	i16 bazz;
	i16 a;
	i16 b;

	foo = 22;
	bar = foo * foo;
	foo = 1;
	printIntLf@i16(bar + foo);
	foo = 21;
	printIntLf@i16(foo);
	printIntLf@i16(bazz);
	a = 1000;
	b = 10;
	printIntLf@i16(a / b);
	printIntLf@i16(a & 255);
	a = 10;
	b = 1;
	printIntLf@i16(a >> b);
	a = 9;
	b = 2;
	printIntLf@i16(a >> b);
	a = 1;
	printIntLf@i16(a << b);
}
