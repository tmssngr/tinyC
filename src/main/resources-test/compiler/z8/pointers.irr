printUint@i16:
 Local variables
	arg 0: number (i16/2)
	; 2 pc
	cast t.1.1{r0}(i32), param.number{r0}(i16)
	call printUint@i32[t.1.1{r0}]

printIntLf@u8:
 Local variables
	arg 0: number (u8/1)

printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	; 9 pc
	move param.number{r8}, number{r0}
	branch param.number{r8} gteq 0: printIntLf@i16.no_critical_edge_4
	const arg.0.0{r0}, 45
	call printChar@u8[arg.0.0{r0}]
	neg number.2{r8}, param.number{r8}
	move number.1{r0}, number.2{r8}
	jump if_1_end
printIntLf@i16.no_critical_edge_4:
	move number.1{r0}, param.number{r8}
if_1_end:
	call printUint@i16[number.1{r0}]
	const arg.2.0{r0}, 13
	call printChar@u8[arg.2.0{r0}]

testIf@u8:
 Local variables
	arg 0: a (u8/1)
	var 1: b (u8/1)
	; 16 pc
	const t.3.1{r8}, 1
	addrof a.4.1{r10}, b
	store [a.4.1{r10}], t.3.1{r8}
	move b_ref.1{r8}, b_ref.1{r10}
	; 6:2 if a == 0
	branch param.a{r0} notequals 0: if_2_end
	load t.5.1{r0}, [b_ref.1{r8}]
	call printIntLf@u8[t.5.1{r0}]
if_2_end:
	addrof a.6.1{r8}, b
	load t.7.1{r0}, [a.6.1{r8}]
	call printIntLf@u8[t.7.1{r0}]

main:
 Local variables
	var 0: a (i16/2)
	var 1: c (i16/2)
	; 30 pc
	const t.4.1{r8}, 10
	addrof a.5.1{r10}, a
	store [a.5.1{r10}], t.4.1{r8}
	move a.6.1{r8}, a.6.1{r10}
	load t.7.1{r0}, [a.6.1{r8}]
	call printIntLf@i16[t.7.1{r0}]
	load t.9.1{r10}, [b.1{r8}]
	move t.8.1{r8}, t.9.1{r10}
	sub t.8.1{r8}, 1
	addrof a.10.1{r10}, c
	store [a.10.1{r10}], t.8.1{r8}
	move a.11.1{r8}, a.11.1{r10}
	load t.12.1{r0}, [a.11.1{r8}]
	call printIntLf@i16[t.12.1{r0}]
	load t.14.1{r10}, [d.1{r8}]
	sub t.13.1{r10}, 1
	store [d.1{r8}], t.13.1{r10}
	move t.16.1{r0}, t.16.1{r10}
	call printIntLf@i16[t.16.1{r0}]
	const arg.3.0{r0}, 1
	call testIf@u8[arg.3.0{r0}]

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

