@printUint@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (i32/4)
	; 8 pc
	cast t.1(i32), number(i16)
	call printUint@i32[t.1]
@printUint@i16_ret:

@printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (bool/1)
	var 2: t.2 (i16/2)
	var 3: t.3 (u8/1)
	var 4: t.4 (u8/1)
	; 30 pc
	; 127:2 if number < 0
	const t.2, 0
	lt t.1, number, t.2
	branch t.1, false, @if_1_end, @if_1_then
@if_1_then:
	const t.3, 45
	call printChar@u8[t.3]
	neg number, number
@if_1_end:
	call printUint@i16[number]
	const t.4, 13
	call printChar@u8[t.4]
@printIntLf@i16_ret:

@main:
 Local variables
	var 0: foo (i16/2)
	var 1: bar (i16/2)
	var 2: bazz (i16/2)
	var 3: a (i16/2)
	var 4: b (i16/2)
	var 5: t.5 (i16/2)
	var 6: t.6 (i16/2)
	var 7: t.7 (i16/2)
	var 8: t.8 (i16/2)
	var 9: t.9 (i16/2)
	var 10: t.10 (i16/2)
	var 11: t.11 (i16/2)
	; 130 pc
	const foo, 22
	move bar, foo
	mul bar, bar, foo
	const foo, 1
	move t.5, bar
	add t.5, t.5, foo
	call printIntLf@i16[t.5]
	const foo, 21
	call printIntLf@i16[foo]
	call printIntLf@i16[bazz]
	const a, 1000
	const b, 10
	move t.6, a
	div t.6, t.6, b
	call printIntLf@i16[t.6]
	const t.8, 255
	move t.7, a
	and t.7, t.7, t.8
	call printIntLf@i16[t.7]
	const a, 10
	const b, 1
	move t.9, a
	shiftright t.9, t.9, b
	call printIntLf@i16[t.9]
	const a, 9
	const b, 2
	move t.10, a
	shiftright t.10, t.10, b
	call printIntLf@i16[t.10]
	const a, 1
	move t.11, a
	shiftleft t.11, t.11, b
	call printIntLf@i16[t.11]
@main_ret:

@printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

@printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

