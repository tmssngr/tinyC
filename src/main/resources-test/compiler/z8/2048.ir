printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

setCursor@i16@i16:
	ld   %5b, r3
	ld   %5c, r1
	ret

getChar:
	call %081e
	ld   r0, #0
	ld   r1, %13
	ret

initRandom@i32:
	ld   %74, r0
	ld   %75, r1
	ld   %76, r2
	ld   %77, r3
	ld   r0, #%F7
	ld   r1, #%A8
	ld   r2, #%74
	ld   r3, #4
	.1:
	ldei @rr0, @r2
	djnz r3, .1
	ret

random16:
	call %0836
	ld   r0, %74
	ld   r1, %75
	and  r0, #%7f
	ret

Global variables
	0: tiles[] (u8*/16)
	1: score (i32/4)
	2: gameState (u8/1)

String literals
	string lit 0 "        \0"
	string lit 1 "   2    \0"
	string lit 2 "   4    \0"
	string lit 3 "   8    \0"
	string lit 4 "   16   \0"
	string lit 5 "   32   \0"
	string lit 6 "   64   \0"
	string lit 7 "  128   \0"
	string lit 8 "  256   \0"
	string lit 9 "  512   \0"
	string lit 10 "  1024  \0"
	string lit 11 "  2048  \0"
	string lit 12 "   ?    \0"
	string lit 13 "Arrows/WASD  R restart  Esc quit\0"
	string lit 14 "+--------+--------+--------+--------+\0"
	string lit 15 "|        |        |        |        |\0"
	string lit 16 "2048  Score: \0"
	string lit 17 "          \0"
	string lit 18 "                                      \0"
	string lit 19 "2048! Press R to play again.\0"
	string lit 20 "No moves left. Press R to restart.\0"
