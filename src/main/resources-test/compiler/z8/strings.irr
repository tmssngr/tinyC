printUint@i16:
 Local variables
	arg 0: number (i16/2)
	; 2 pc
	cast t.1.1{r0}(i32), param.number{r0}(i16)
	call printUint@i32[t.1.1{r0}]

printIntLf@u8:
 Local variables
	arg 0: number (u8/1)

printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	; 7 pc
	move param.number{r8}, number{r0}
	branch param.number{r8} gteq 0: if_1_end
	const arg.0.0{r0}, 45
	call printChar@u8[arg.0.0{r0}]
	neg number.2{r8}, param.number{r8}
if_1_end:
	move number.1{r0}, number.1{r8}
	call printUint@i16[number.1{r0}]
	const arg.2.0{r0}, 13
	call printChar@u8[arg.2.0{r0}]

main:
	; 21 pc
	const t.2.1{r8}, [string-0]
	addrof a.3.1{r10}, text
	store [a.3.1{r10}], t.2.1{r8}
	move a.4.1{r8}, a.4.1{r10}
	load t.5.1{r0}, [a.4.1{r8}]
	call printString@@u8[t.5.1{r0}]
	call printLength[]
	const t.6.1{r8}, 1
	load second.1{r12}, [a.7.1{r10}]
	move second.2{r0}, second.1{r12}
	add second.2{r0}, t.6.1{r8}
	call printString@@u8[second.2{r0}]
	move a.8.1{r8}, a.8.1{r10}
	move t.9.1{r10}, t.9.1{r12}
	load chr.1{r0}, [t.9.1{r10}]
	call printIntLf@u8[chr.1{r0}]

printLength:
	; 16 pc
	const length.1{r8}, 0
	addrof a.2.1{r10}, text
	load ptr.1{r12}, [a.2.1{r10}]
	move length.2{r0}, length.1{r8}
	move ptr.2{r8}, ptr.1{r12}
	jump for_2
for_2_body:
	move length.3{r10}, length.2{r0}
	add length.3{r10}, 1
	add ptr.3{r8}, 1
	move length.2{r0}, length.3{r10}
for_2:
	load t.3.1{r10}, [ptr.2{r8}]
	branch t.3.1{r10} notequals 0: for_2_body
	call printIntLf@i16[length.2{r0}]

printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

Global variables
	0: text (u8*/2)

String literals
	string lit 0 "hello world\n\0"
