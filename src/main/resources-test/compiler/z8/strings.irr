printUint_Pi16:
 Local variables
	arg 0: number (i16/2)

	cast t.1.1{r0}(i32), param.number{r0}(i16)
	call printUint_Pi32[t.1.1{r0}]

printIntLf_Pu8:
 Local variables
	arg 0: number (u8/1)

	cast t.1.1{r0}(i16), param.number{r0}(u8)
	call printIntLf_Pi16[t.1.1{r0}]

printIntLf_Pi16:
 Local variables
	arg 0: number (i16/2)

	move param.number{r8}, number{r0}
	branch param.number{r8} gteq 0: if_1_end
	const arg.0.0{r0}, 45
	call printChar_Pu8[arg.0.0{r0}]
	neg number.2{r0}, param.number{r8}
	move number.1{r8}, number.2{r0}
if_1_end:
	move number.1{r0}, number.1{r8}
	call printUint_Pi16[number.1{r0}]
	const arg.2.0{r0}, 13
	call printChar_Pu8[arg.2.0{r0}]

main:
	; begin initialize global variables
	const t.2.1{r0}, [string-0]
	addrof a.3.1{r2}, text
	store [a.3.1{r2}], t.2.1{r0}
	; end initialize global variables
	move a.4.1{r0}, a.4.1{r2}
	load t.5.1{r2}, [a.4.1{r0}]
	move t.5.1{r0}, t.5.1{r2}
	call printString_P_pu8[t.5.1{r0}]
	call printLength[]
	const t.6.1{r0}, 1
	addrof a.7.1{r2}, text
	load second.1{r4}, [a.7.1{r2}]
	move second.2{r2}, second.1{r4}
	add second.2{r2}, t.6.1{r0}
	move second.2{r0}, second.2{r2}
	call printString_P_pu8[second.2{r0}]
	addrof a.8.1{r0}, text
	load t.9.1{r2}, [a.8.1{r0}]
	load chr.1{r0}, [t.9.1{r2}]
	call printIntLf_Pu8[chr.1{r0}]

printLength:
	const length.1{r0}, 0
	addrof a.2.1{r2}, text
	load ptr.1{r4}, [a.2.1{r2}]
	; 16:2 for *ptr != 0
	move ptr.2{r2}, ptr.1{r4}
	jump for_2
for_2_body:
	add length.3{r0}, 1
	add ptr.3{r2}, 1
for_2:
	load t.3.1{r4}, [ptr.2{r2}]
	branch t.3.1{r4} notequals 0: for_2_body
	call printIntLf_Pi16[length.2{r0}]

printString_P_pu8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

printChar_Pu8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

printUint_Pi32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

Global variables
	0: text (u8*/2)

String literals
	string lit 0 "hello world\n\0"
