@printUint@i16:
 Local variables
	arg 0: number (i16/2)
	; 2 pc
	cast r0(i32), r0(i16)
	call printUint@i32[r0]

@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)

@printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	; 8 pc
	move r8, r0
	; 127:2 if number < 0
	const r10, 0
	lt r10, r8, r10
	branch r10, false, @if_1_end, @if_1_then
	const r0, 45
	call printChar@u8[r0]
	neg r8, r8
@if_1_end:
	move r0, r8
	call printUint@i16[r0]
	const r0, 13
	call printChar@u8[r0]

@main:
	; 25 pc
	; begin initialize global variables
	const r8, [string-0]
	; end initialize global variables
	addrof r14, text
	store [r14], r8
	move r0, r8
	call printString@@u8[r0]
	call printLength[]
	const r10, 1
	addrof r14, text
	load r8, [r14]
	move r0, r8
	add r0, r0, r10
	call printString@@u8[r0]
	addrof r14, text
	load r8, [r14]
	load r0, [r8]
	call printIntLf@u8[r0]

@printLength:
	; 13 pc
	const r0, 0
	addrof r14, text
	load r8, [r14]
	; 16:2 for *ptr != 0
	jump @for_2
@for_2_body:
	const r10, 1
	add r0, r0, r10
	const r10, 1
	add r8, r8, r10
@for_2:
	load r10, [r8]
	const r11, 0
	notequals r10, r10, r11
	branch r10, true, @for_2_body, @for_2_break
	call printIntLf@i16[r0]

@printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

@printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

@printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

Global variables
	0: text (u8*/2)

String literals
	string lit 0 "hello world\n\0"
