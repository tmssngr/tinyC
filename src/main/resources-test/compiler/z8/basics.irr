@printUint@u8:
 Local variables
	arg 0: number (u8/1)
	; 2 pc
	cast r0(i32), r0(u8)
	call printUint@i32[r0]

@unusedArgs@u8@bool@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (bool/1)
	arg 2: c (u8/1)
	arg 3: d (u8/1)
	; 1 pc
	; 9:10 return (i64)
	cast r0(i64), r2(u8)

@main:
	; 49 pc
	; begin initialize global variables
	const r8, 48
	const r9, 49
	const r10, 50
	const r11, 34
	; end initialize global variables
	const r0, 1
	const r1, 1
	const r2, 2
	const r3, 3
	addrof r14, zero
	store [r14], r8
	addrof r14, one
	store [r14], r9
	addrof r14, two
	store [r14], r10
	addrof r14, threeFour
	store [r14], r11
	call _ = unusedArgs@u8@bool@u8@u8[r0, r1, r2, r3] -> i64
	addrof r14, zero
	load r8, [r14]
	move r0, r8
	call printChar@u8[r0]
	addrof r8, one
	load r0, [r8]
	call printChar@u8[r0]
	addrof r8, two
	const r10, 0
	add r8, r8, r10
	load r0, [r8]
	call printChar@u8[r0]
	addrof r14, threeFour
	load r11, [r14]
	move r0, r11
	call printUint@u8[r0]
	const r0, 10
	call printChar@u8[r0]

@printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

@printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

Global variables
	0: zero (u8/1)
	1: one (u8/1)
	2: two (u8/1)
	3: threeFour (u8/1)

