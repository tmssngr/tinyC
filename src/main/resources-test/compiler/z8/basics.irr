printUint@u8:
 Local variables
	arg 0: number (u8/1)
	; 2 pc
	cast t.1{r0}(i32), param.number{r0}(u8)
	call printUint@i32[t.1{r0}]

unusedArgs@u8@bool@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (bool/1)
	arg 2: c (u8/1)
	arg 3: d (u8/1)
	; 1 pc
	; 9:10 return (i64)
	cast t.4{r0}(i64), param.c{r2}(u8)

main:
	; 47 pc
	; begin initialize global variables
	const t.zero{r8}, 48
	addrof a.zero{r10}, zero
	store [a.zero{r10}], t.zero{r8}
	const t.one{r8}, 49
	addrof a.one{r10}, one
	store [a.one{r10}], t.one{r8}
	const t.two{r8}, 50
	addrof a.two{r10}, two
	store [a.two{r10}], t.two{r8}
	const t.threeFour{r8}, 34
	addrof a.threeFour{r10}, threeFour
	store [a.threeFour{r10}], t.threeFour{r8}
	; end initialize global variables
	const t.3{r1}, 1
	const arg.0.0{r0}, 1
	const arg.0.2{r2}, 2
	const arg.0.3{r3}, 3
	call _ = unusedArgs@u8@bool@u8@u8[arg.0.0{r0}, t.3{r1}, arg.0.2{r2}, arg.0.3{r3}] -> i64
	addrof a.zero1{r8}, zero
	load t.zero1{r0}, [a.zero1{r8}]
	call printChar@u8[t.zero1{r0}]
	addrof onePtr{r8}, one
	load t.4{r0}, [onePtr{r8}]
	call printChar@u8[t.4{r0}]
	addrof twoPtr{r8}, two
	const t.7{r10}, 0
	add t.6{r8}, t.6{r8}, t.7{r10}
	load t.5{r0}, [t.6{r8}]
	call printChar@u8[t.5{r0}]
	addrof a.threeFour1{r8}, threeFour
	load t.threeFour1{r0}, [a.threeFour1{r8}]
	call printUint@u8[t.threeFour1{r0}]
	const arg.5.0{r0}, 10
	call printChar@u8[arg.5.0{r0}]

printChar@u8:
	cp    r0, #%0a
	jr    ne, .1
	ld    r0, #%0d
	.1:
	ld    %15, r0
	jp    %0818

printUint@i32:
	ld   r4, #1
	ld   r5, #%28
	ld   r6, #8
	.push:
	push @r5
	inc  r5
	djnz r6, .push
	; result
	clr     r11
	clr     r12
	clr     r13
	clr     r14
	clr     r15
	; summand (bcd-shifted power of 2)
	clr     r6
	clr     r7
	clr     r8
	clr     r9
	ld      r10, #1
	; counter
	ld      r5, #%20
	.1:
	sra     r0
	rrc     r1
	rrc     r2
	rrc     r3
	jr      nc, .2
	add     r15, r10
	da      r15
	adc     r14, r9
	da      r14
	adc     r13, r8
	da      r13
	adc     r12, r7
	da      r12
	adc     r11, r6
	da      r11
	.2:
	add     r10, r10
	da      r10
	adc     r9, r9
	da      r9
	adc     r8, r8
	da      r8
	adc     r7, r7
	da      r7
	adc     r6, r6
	da      r6
	djnz    r5, .1
	ld      r6, #%2b
	; counter
	ld      r7, #10
	.loop:
	ld      r5, @r6
	tm      r7, #1
	jr      nz, .4
	swap    r5
	.4:
	and     r5, #%0f
	or      r4, r4
	jr      z, .5
	cp      r7, #1
	jr      eq, .5
	or      r5, r5
	jr      z, .6
	clr     r4
	.5:
	ld      %15, r5
	add     %15, #'0'
	call    %0818
	.6:
	tm      r7, #1
	jr      z, .7
	inc     r6
	.7:
	djnz    r7, .loop
	ld   r5, #%2f
	ld   r6, #8
	.pop:
	pop  @r5
	dec  r5
	djnz r6, .pop
	ret

Global variables
	0: zero (u8/1)
	1: one (u8/1)
	2: two (u8/1)
	3: threeFour (u8/1)

