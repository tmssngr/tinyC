void printString_P_pu8(u8* str) asm {
}

void printChar_Pu8(u8 chr) asm {
}

void printUint_Pi16(i16 number) {
	printUint_Pi32(number as i32);
}

void printUint_Pi32(i32 number) asm {
}

void printIntLf_Pbool(bool value) {
	u8 number;

	number = 0;
	if (value) {
		number = 1;
	}
	printIntLf_Pi16(number as i16);
}

void printIntLf_Pi16(i16 number) {
	if (number < 0) {
		printChar_Pu8(45);
		number = -number;
	}
	printUint_Pi16(number);
	printChar_Pu8(13);
}

void main() {
	i16 a;
	i16 b;
	u8 c;
	u8 d;

	printString_P_pu8("< (signed)\n");
	a = 1;
	b = 2;
	printIntLf_Pbool(a < b);
	printIntLf_Pbool(b < a);
	printString_P_pu8("< (unsigned)\n");
	c = 0;
	d = 128;
	printIntLf_Pbool(c < d);
	printIntLf_Pbool(d < c);
	printString_P_pu8("<= (signed)\n");
	printIntLf_Pbool(a <= b);
	printIntLf_Pbool(b <= a);
	printString_P_pu8("<= (unsigned)\n");
	printIntLf_Pbool(c <= d);
	printIntLf_Pbool(d <= c);
	printString_P_pu8("==\n");
	printIntLf_Pbool(a == b);
	printIntLf_Pbool(b == a);
	printString_P_pu8("!=\n");
	printIntLf_Pbool(a != b);
	printIntLf_Pbool(b != a);
	printString_P_pu8(">= (signed)\n");
	printIntLf_Pbool(a >= b);
	printIntLf_Pbool(b >= a);
	printString_P_pu8(">= (unsigned)\n");
	printIntLf_Pbool(c >= d);
	printIntLf_Pbool(d >= c);
	printString_P_pu8("> (signed)\n");
	printIntLf_Pbool(a > b);
	printIntLf_Pbool(b > a);
	printString_P_pu8("> (unsigned)\n");
	printIntLf_Pbool(c > d);
	printIntLf_Pbool(d > c);
}
