void printString@@u8(u8* str) asm {
}

void printChar@u8(u8 chr) asm {
}

void printUint@i16(i16 number) {
	printUint@i32(number as i32);
}

void printUint@i32(i32 number) asm {
}

void printIntLf@bool(bool value) {
	u8 number;

	number = 0;
	if (value) {
		number = 1;
	}
	printIntLf@i16(number as i16);
}

void printIntLf@i16(i16 number) {
	if (number < 0) {
		printChar@u8(45);
		number = -number;
	}
	printUint@i16(number);
	printChar@u8(13);
}

void main() {
	i16 a;
	i16 b;
	u8 c;
	u8 d;

	printString@@u8("< (signed)\n");
	a = 1;
	b = 2;
	printIntLf@bool(a < b);
	printIntLf@bool(b < a);
	printString@@u8("< (unsigned)\n");
	c = 0;
	d = 128;
	printIntLf@bool(c < d);
	printIntLf@bool(d < c);
	printString@@u8("<= (signed)\n");
	printIntLf@bool(a <= b);
	printIntLf@bool(b <= a);
	printString@@u8("<= (unsigned)\n");
	printIntLf@bool(c <= d);
	printIntLf@bool(d <= c);
	printString@@u8("==\n");
	printIntLf@bool(a == b);
	printIntLf@bool(b == a);
	printString@@u8("!=\n");
	printIntLf@bool(a != b);
	printIntLf@bool(b != a);
	printString@@u8(">= (signed)\n");
	printIntLf@bool(a >= b);
	printIntLf@bool(b >= a);
	printString@@u8(">= (unsigned)\n");
	printIntLf@bool(c >= d);
	printIntLf@bool(d >= c);
	printString@@u8("> (signed)\n");
	printIntLf@bool(a > b);
	printIntLf@bool(b > a);
	printString@@u8("> (unsigned)\n");
	printIntLf@bool(c > d);
	printIntLf@bool(d > c);
}
