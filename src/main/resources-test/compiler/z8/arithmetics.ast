void printChar_Pu8(u8 chr) asm {
}

void printUint_Pi16(i16 number) {
	printUint_Pi32(number as i32);
}

void printUint_Pi32(i32 number) asm {
}

void printIntLf_Pi16(i16 number) {
	if (number < 0) {
		printChar_Pu8(45);
		number = -number;
	}
	printUint_Pi16(number);
	printChar_Pu8(13);
}

void main() {
	i16 foo;
	i16 bar;
	i16 bazz;
	i16 a;
	i16 b;

	foo = ((4 * 3) + (2 * 5)) as i16;
	bar = foo * foo;
	foo = 1;
	printIntLf_Pi16(bar + foo);
	foo = ((1 + 2) * (3 + 4)) as i16;
	printIntLf_Pi16(foo);
	bazz = 0;
	printIntLf_Pi16(bazz);
	a = 1000;
	b = 10;
	printIntLf_Pi16(a / b);
	printIntLf_Pi16(a % 256);
	a = 10;
	b = 1;
	printIntLf_Pi16(a >> b);
	a = 9;
	b = 2;
	printIntLf_Pi16(a >> b);
	a = 1;
	printIntLf_Pi16(a << b);
}
