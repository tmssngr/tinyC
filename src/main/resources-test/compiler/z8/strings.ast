u8* text;

void printString@@u8(u8* str) asm {
}

void printChar@u8(u8 chr) asm {
}

void printUint@i16(i16 number) {
	printUint@i32((i32)number);
}

void printUint@i32(i32 number) asm {
}

void printIntLf@u8(u8 number) {
}

void printIntLf@i16(i16 number) {
	if (number < 0) {
		printChar@u8(45);
		number = -number;
	}
	printUint@i16(number);
	printChar@u8(13);
}

void main() {
	u8* second;
	u8 chr;

	printString@@u8(text);
	printLength();
	second = &text[1];
	printString@@u8(second);
	chr = *text;
	printIntLf@u8(chr);
}

void printLength() {
	i16 length;
	u8* ptr;

	length = 0;
	ptr = text;
	for (; (*ptr) != 0; ptr = ptr + 1) {
		length = length + 1;
	}
	printIntLf@i16(length);
}
