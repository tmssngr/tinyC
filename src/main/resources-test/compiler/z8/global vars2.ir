next:
 Local variables
	var 0: copy (u8/1)
	var 1: a.1 (u8*/2)
	var 2: t.2 (u8/1)
	var 3: a.3 (u8*/2)
	var 4: t.4 (u8/1)
	var 5: a.5 (u8*/2)
	; 42 pc
	addrof a.1, global
	load copy, [a.1]
	addrof a.3, global
	load t.4, [a.3]
	add t.2, t.4, 1
	addrof a.5, global
	store [a.5], t.2
	; 8:9 return copy
	ret copy
	jump next_ret
next_ret:

main:
 Local variables
	var 0: n (u8/1)
	var 1: t.1 (u8/1)
	var 2: a.2 (u8*/2)
	var 3: t.3 (u8*/2)
	var 4: t.4 (u8*/2)
	; 35 pc
	; begin initialize global variables
	const t.1, 0
	addrof a.2, global
	store [a.2], t.1
	; end initialize global variables
	; 12:2 while true
while_1:
	const t.3, [string-0]
	call printString@@u8[t.3]
	call n = next[] -> u8
	; 15:3 if n == 3
	branch n equals 3: main_ret, if_2_end
if_2_end:
	; 19:3 if n < 2
	branch n gteq 2: while_1, if_3_then
if_3_then:
	const t.4, [string-1]
	call printString@@u8[t.4]
	jump while_1
main_ret:

printString@@u8:
	ld   r2, r0
	ld   r3, r1
	jr   .loop
	.print:
	call printChar_Pu8
	incw r2
	.loop:
	lde  r0, @rr2
	or   r0, r0
	jr   nz, .print
	ret

Global variables
	0: global (u8/1)

String literals
	string lit 0 "loop\n\0"
	string lit 1 "<2\n\0"
