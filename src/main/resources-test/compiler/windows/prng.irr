printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1 (u8*/8)
	; 8 pc
	addrof t.1, chr
	call printStringLength@@u8@u8[t.1, 1]

printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	var 2: pos (u8/1)
	var 3: remainder (i64/8)
	var 4: digit (u8/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8*/8)
	var 7: t.7 (i64/8)
	var 8: t.8 (u8*/8)
	var 9: t.9 (i64/8)
	var 10: t.10 (u8/1)
	var 11: t.11 (u8/1)
	; 99 pc
	const pos, 20
	; 28:2 while true
while_1:
	sub pos, 1
	move remainder, number
	mod remainder, 10
	div number, 10
	cast t.5(u8), remainder(i64)
	move digit, t.5
	add digit, 48
	cast t.7(i64), pos(u8)
	addrof t.6, buffer
	add t.6, t.7
	store [t.6], digit
	; 34:3 if number == 0
	branch number notequals 0: while_1, while_1_break
	cast t.9(i64), pos(u8)
	addrof t.8, buffer
	add t.8, t.9
	const t.11, 20
	move t.10, t.11
	sub t.10, pos
	call printStringLength@@u8@u8[t.8, t.10]

printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	var 1: t.1 (i64/8)
	; 8 pc
	cast t.1(i64), number(u8)
	call printIntLf@i64[t.1]

printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 13 pc
	branch number gteq 0: if_3_end, if_3_then
	call printChar@u8[45]
	neg number, number
if_3_end:
	call printUint@i64[number]
	call printChar@u8[10]

printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2 (i64/8)
	; 10 pc
	cast t.2(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2]

initRandom@i32:
 Local variables
	arg 0: salt (i32/4)
	var 1: t.1 (i32/4)
	var 2: a.2 (i32*/8)
	; 16 pc
	move t.1, salt
	addrof a.2, __random__
	store [a.2], t.1

random:
 Local variables
	var 0: r (i32/4)
	var 1: b (i32/4)
	var 2: c (i32/4)
	var 3: d (i32/4)
	var 4: e (i32/4)
	var 5: a.5 (i32*/8)
	var 6: t.6 (i32/4)
	var 7: t.7 (i32/4)
	var 8: t.8 (i32/4)
	var 9: t.9 (i32/4)
	var 10: t.10 (i32/4)
	var 11: t.11 (i32/4)
	var 12: t.12 (i32/4)
	var 13: t.13 (i32/4)
	var 14: a.14 (i32*/8)
	var 15: a.15 (i32*/8)
	var 16: t.16 (i32/4)
	; 162 pc
	addrof a.5, __random__
	load r, [a.5]
	move t.6, r
	and t.6, 524287
	move b, t.6
	mul b, 48271
	move t.7, r
	shiftright t.7, 15
	move c, t.7
	mul c, 48271
	move t.8, c
	and t.8, 65535
	move d, t.8
	shiftleft d, 15
	move t.10, c
	shiftright t.10, 16
	move t.9, t.10
	add t.9, b
	move e, t.9
	add e, d
	move t.12, e
	and t.12, 2147483647
	move t.13, e
	shiftright t.13, 31
	move t.11, t.12
	add t.11, t.13
	addrof a.14, __random__
	store [a.14], t.11
	; 15:9 return __random__
	addrof a.15, __random__
	load t.16, [a.15]
	ret t.16

randomU8:
 Local variables
	var 0: t.0 (u8/1)
	var 1: t.1 (i32/4)
	; 11 pc
	; 19:10 return (u8)
	call t.1 = random[] -> i32
	cast t.0(u8), t.1(i32)
	ret t.0

main:
 Local variables
	var 0: i (u8/1)
	var 1: r (u8/1)
	var 2: t.2 (i32/4)
	var 3: a.3 (i32*/8)
	; 31 pc
	; begin initialize global variables
	const t.2, 0
	addrof a.3, __random__
	store [a.3], t.2
	; end initialize global variables
	call initRandom@i32[7439742]
	const i, 0
	; 6:2 for i < 50
	jump for_4
for_4_body:
	call r = randomU8[] -> u8
	call printIntLf@u8[r]
	add i, 1
for_4:
	branch i lt 50: for_4_body, main_ret

printStringLength@@u8@i64:
	mov     rdi, rsp
	
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	mov     rdx, [rdi+18h]
	mov     r8, [rdi+10h]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

Global variables
	0: __random__ (i32/4)

