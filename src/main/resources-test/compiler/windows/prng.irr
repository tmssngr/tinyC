@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1 (u8*/8)
	var 2: t.2 (u8/1)
	; 12 pc
	addrof t.1, chr
	const t.2, 1
	call printStringLength@@u8@u8[t.1, t.2]

@printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	var 2: pos (u8/1)
	var 3: remainder (i64/8)
	var 4: digit (u8/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8*/8)
	var 7: t.7 (i64/8)
	var 8: t.8 (bool/1)
	var 9: t.9 (i64/8)
	var 10: t.10 (u8*/8)
	var 11: t.11 (i64/8)
	var 12: t.12 (u8/1)
	var 13: t.13 (u8/1)
	; 104 pc
	const pos, 20
	; 28:2 while true
@while_1:
	sub pos, pos, 1
	move remainder, number
	mod remainder, remainder, 10
	div number, number, 10
	cast t.5(u8), remainder(i64)
	move digit, t.5
	add digit, digit, 48
	cast t.7(i64), pos(u8)
	addrof t.6, [buffer]
	add t.6, t.6, t.7
	store [t.6], digit
	; 34:3 if number == 0
	const t.9, 0
	equals t.8, number, t.9
	branch t.8, false, @while_1, @while_1_break
	cast t.11(i64), pos(u8)
	addrof t.10, [buffer]
	add t.10, t.10, t.11
	const t.13, 20
	move t.12, t.13
	sub t.12, t.12, pos
	call printStringLength@@u8@u8[t.10, t.12]

@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	var 1: t.1 (i64/8)
	; 8 pc
	cast t.1(i64), number(u8)
	call printIntLf@i64[t.1]

@printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: t.1 (bool/1)
	var 2: t.2 (i64/8)
	var 3: t.3 (u8/1)
	var 4: t.4 (u8/1)
	; 30 pc
	; 54:2 if number < 0
	const t.2, 0
	lt t.1, number, t.2
	branch t.1, false, @if_3_end, @if_3_then
	const t.3, 45
	call printChar@u8[t.3]
	neg number, number
@if_3_end:
	call printUint@i64[number]
	const t.4, 10
	call printChar@u8[t.4]

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2 (i64/8)
	; 10 pc
	cast t.2(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2]

@initRandom@i32:
 Local variables
	arg 0: salt (i32/4)
	; 5 pc
	move __random__, salt

@random:
 Local variables
	var 0: r (i32/4)
	var 1: b (i32/4)
	var 2: c (i32/4)
	var 3: d (i32/4)
	var 4: e (i32/4)
	var 5: t.5 (i32/4)
	var 6: t.6 (i32/4)
	var 7: t.7 (i32/4)
	var 8: t.8 (i32/4)
	var 9: t.9 (i32/4)
	var 10: t.10 (i32/4)
	var 11: t.11 (i32/4)
	; 134 pc
	move r, __random__
	move t.5, r
	and t.5, t.5, 524287
	move b, t.5
	mul b, b, 48271
	move t.6, r
	shiftright t.6, t.6, 15
	move c, t.6
	mul c, c, 48271
	move t.7, c
	and t.7, t.7, 65535
	move d, t.7
	shiftleft d, d, 15
	move t.9, c
	shiftright t.9, t.9, 16
	move t.8, t.9
	add t.8, t.8, b
	move e, t.8
	add e, e, d
	move t.10, e
	and t.10, t.10, 2147483647
	move t.11, e
	shiftright t.11, t.11, 31
	move __random__, t.10
	add __random__, __random__, t.11
	; 15:9 return __random__
	ret __random__

@randomU8:
 Local variables
	var 0: t.0 (u8/1)
	var 1: t.1 (i32/4)
	; 11 pc
	; 19:10 return (u8)
	call t.1 = random[] -> i32
	cast t.0(u8), t.1(i32)
	ret t.0

@main:
 Local variables
	var 0: i (u8/1)
	var 1: r (u8/1)
	var 2: t.2 (i32/4)
	var 3: t.3 (bool/1)
	var 4: t.4 (u8/1)
	; 33 pc
	; begin initialize global variables
	const __random__, 0
	; end initialize global variables
	const t.2, 7439742
	call initRandom@i32[t.2]
	const i, 0
	; 6:2 for i < 50
	jump @for_4
@for_4_body:
	call r = randomU8[] -> u8
	call printIntLf@u8[r]
	add i, i, 1
@for_4:
	const t.4, 50
	lt t.3, i, t.4
	branch t.3, true, @for_4_body, @main_ret

@printStringLength@@u8@i64:
	mov     rdi, rsp
	
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	mov     rdx, [rdi+18h]
	mov     r8, [rdi+10h]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

Global variables
	0: __random__ (i32/4)

