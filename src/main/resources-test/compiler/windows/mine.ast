u8 getBombCountAround@u8@u8(u8 row, u8 column) {
	u8 rowFrom;
	u8 rowTo;
	u8 colFrom;
	u8 colTo;
	u8 count;
	i16 index;
	u8 r;
	u8 c;
	u8 cell;

	rowFrom = row;
	if (rowFrom > 0) {
		rowFrom = row - 1;
	}
	rowTo = row + 1;
	if (rowTo >= 20) {
		rowTo = rowTo - 1;
	}
	colFrom = column;
	if (colFrom > 0) {
		colFrom = colFrom - 1;
	}
	colTo = column + 1;
	if (colTo >= 17) {
		colTo = colTo - 1;
	}
	count = 0;
	index = rowColumnToCell@u8@u8(rowFrom, colFrom);
	r = rowFrom;
	for (; r <= rowTo; r = r + 1) {
		c = colFrom;
		for (; c <= colTo; c = c + 1, index = index + 1) {
			if ((r == row) && (c == column)) {
				continue;
			}
			cell = field[(i64)index];
			if ((cell & 1) != 0) {
				count = count + 1;
			}
		}
		index = (((index - ((i16)colTo)) + ((i16)colFrom)) + 17) - 1;
	}
	return count;
