	}
	return count;
}

bool printLeft() {
	i16 count;
	i16 leftDigits;
	i16 bombDigits;

	count = getHiddenCount();
	leftDigits = (i16)(getDigitCount@i16(count));
	bombDigits = (i16)(getDigitCount@i16(23));
	setCursor@i16@i16(20, 6);
	printSpaces@i16(bombDigits - leftDigits);
	printUint@i16(count);
	return count == 0;
}

