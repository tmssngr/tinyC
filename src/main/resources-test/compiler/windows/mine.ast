void main() {
	bool needsInitialize;
	u8 curr_c;
	u8 curr_r;
	i16 chr;
	i16 index;
	u8 cell;
	i16 index;
	u8 cell;

	initRandom@i32(7439742);
	needsInitialize = true;
	clearField();
	printField();
	setCursor@i16@i16(20, 0);
	printString@@u8("Left:");
	curr_c = 17 / 2;
