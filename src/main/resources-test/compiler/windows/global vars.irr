@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	; 9 pc
	addrof memVarAddr{r7}, chr
	store [memVarAddr{r7}], chr{r1}
	addrof t.1{r1}, chr
	const arg.0.1{r2}, 1
	call printStringLength@@u8@u8[t.1{r1}, arg.0.1{r2}]

@printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	; 24 pc
	move number{r6}, number{r1}
	const pos{r3}, 20
	; 33:2 while true
@while_1:
	sub pos{r3}, pos{r3}, 1
	move remainder{r4}, number{r6}
	move remainder{r0}, remainder{r4}
	mod remainder{r2}, remainder{r0}, 10
	move remainder{r4}, remainder{r2}
	move number{r0}, number{r6}
	div number{r0}, number{r0}, 10
	move number{r6}, number{r0}
	cast t.5{r0}(u8), remainder{r4}(i64)
	add digit{r0}, digit{r0}, 48
	cast t.7{r4}(i64), pos{r3}(u8)
	addrof t.6{r5}, [buffer]
	add t.6{r5}, t.6{r5}, t.7{r4}
	store [t.6{r5}], digit{r0}
	; 39:3 if number == 0
	equals t.8{r0}, number{r6}, 0
	branch t.8{r0}, false, @while_1, @while_1_break
	cast t.10{r6}(i64), pos{r3}(u8)
	addrof t.9{r1}, [buffer]
	add t.9{r1}, t.9{r1}, t.10{r6}
	const t.12{r6}, 20
	move t.11{r2}, t.12{r6}
	sub t.11{r2}, t.11{r2}, pos{r3}
	call printStringLength@@u8@u8[t.9{r1}, t.11{r2}]

@printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	; 2 pc
	cast t.1{r1}(i64), number{r1}(i16)
	call printIntLf@i64[t.1{r1}]

@printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 8 pc
	move number{r6}, number{r1}
	; 59:2 if number < 0
	lt t.1{r7}, number{r6}, 0
	branch t.1{r7}, false, @if_3_end, @if_3_then
	const arg.0.0{r1}, 45
	call printChar@u8[arg.0.0{r1}]
	neg number{r6}, number{r6}
@if_3_end:
	move number{r1}, number{r6}
	call printUint@i64[number{r1}]
	const arg.2.0{r1}, 10
	call printChar@u8[arg.2.0{r1}]

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	; 2 pc
	cast t.2{r2}(i64), length{r2}(u8)
	call printStringLength@@u8@i64[str{r1}, t.2{r2}]

@main:
	; 33 pc
	; begin initialize global variables
	const tmp.space{r6}, 32
	const tmp.next{r1}, 63
	addrof tmp.ptrToSpace{r0}, space
	; end initialize global variables
	addrof memVarAddr{r7}, space
	store [memVarAddr{r7}], tmp.space{r6}
	addrof memVarAddr{r7}, next
	store [memVarAddr{r7}], tmp.next{r1}
	addrof memVarAddr{r7}, ptrToSpace
	store [memVarAddr{r7}], tmp.ptrToSpace{r0}
	call printIntLf@i16[tmp.next{r1}]
	addrof memVarAddr{r7}, ptrToSpace
	load tmp.ptrToSpace{r6}, [memVarAddr{r7}]
	add tmp.ptrToSpace{r6}, tmp.ptrToSpace{r6}, 2
	addrof memVarAddr{r7}, ptrToSpace
	store [memVarAddr{r7}], tmp.ptrToSpace{r6}
	load t.0{r1}, [tmp.ptrToSpace{r6}]
	call printIntLf@i16[t.0{r1}]

@printStringLength@@u8@i64:
	mov     rdi, rsp
	
	mov     r8, rdx
	mov     rdx, rcx
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

Global variables
	0: space (i16/2)
	1: next (i16/2)
	2: ptrToSpace (i16*/8)

