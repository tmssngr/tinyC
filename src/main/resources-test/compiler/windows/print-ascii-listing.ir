@printString@@u8:
 Local variables
	arg 0: str (u8*/8)
	var 1: length (i64/8)
	; 10 pc
	call length = strlen@@u8[str] -> i64
	call printStringLength@@u8@i64[str, length]
@printString@@u8_ret:

@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1 (u8*/8)
	var 2: t.2 (u8/1)
	; 12 pc
	addrof t.1, chr
	const t.2, 1
	call printStringLength@@u8@u8[t.1, t.2]
@printChar@u8_ret:

@strlen@@u8:
 Local variables
	arg 0: str (u8*/8)
	var 1: length (i64/8)
	var 2: t.2 (bool/1)
	var 3: t.3 (u8/1)
	; 31 pc
	const length, 0
	; 64:2 for *str != 0
@for_1:
	load t.3, [str]
	notequals t.2, t.3, 0
	branch t.2, false, @for_1_break, @for_1_body
@for_1_body:
	add length, length, 1
@for_1_continue:
	add str, str, 1
	jump @for_1
@for_1_break:
	; 67:9 return length
	ret length
	jump @strlen@@u8_ret
@strlen@@u8_ret:

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2 (i64/8)
	; 10 pc
	cast t.2(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2]
@printStringLength@@u8@u8_ret:

@printNibble@u8:
 Local variables
	arg 0: x (u8/1)
	var 1: t.1 (bool/1)
	; 26 pc
	and x, x, 15
	; 5:2 if x > 9
	gt t.1, x, 9
	branch t.1, false, @if_2_end, @if_2_then
@if_2_then:
	add x, x, 7
@if_2_end:
	add x, x, 48
	call printChar@u8[x]
@printNibble@u8_ret:

@printHex2@u8:
 Local variables
	arg 0: x (u8/1)
	var 1: t.1 (u8/1)
	; 16 pc
	move t.1, x
	shiftright t.1, t.1, 4
	call printNibble@u8[t.1]
	call printNibble@u8[x]
@printHex2@u8_ret:

@main:
 Local variables
	var 0: i (u8/1)
	var 1: i (u8/1)
	var 2: t.2 (u8*/8)
	var 3: t.3 (bool/1)
	var 4: t.4 (bool/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8/1)
	var 7: t.7 (u8/1)
	var 8: t.8 (bool/1)
	var 9: t.9 (bool/1)
	var 10: t.10 (u8/1)
	var 11: t.11 (bool/1)
	var 12: t.12 (u8/1)
	var 13: t.13 (u8/1)
	var 14: t.14 (bool/1)
	var 15: t.15 (u8/1)
	var 16: t.16 (u8/1)
	; 139 pc
	const t.2, [string-0]
	call printString@@u8[t.2]
	const i, 0
	; 19:2 for i < 16
@for_3:
	lt t.3, i, 16
	branch t.3, false, @for_3_break, @for_3_body
@for_3_body:
	; 20:3 if i & 7 == 0
	move t.5, i
	and t.5, t.5, 7
	equals t.4, t.5, 0
	branch t.4, false, @if_4_end, @if_4_then
@if_4_then:
	const t.6, 32
	call printChar@u8[t.6]
@if_4_end:
	call printNibble@u8[i]
@for_3_continue:
	add i, i, 1
	jump @for_3
@for_3_break:
	const t.7, 10
	call printChar@u8[t.7]
	const i, 32
	; 27:2 for i < 128
@for_5:
	lt t.8, i, 128
	branch t.8, false, @main_ret, @for_5_body
@for_5_body:
	; 28:3 if i & 15 == 0
	move t.10, i
	and t.10, t.10, 15
	equals t.9, t.10, 0
	branch t.9, false, @if_6_end, @if_6_then
@if_6_then:
	call printHex2@u8[i]
@if_6_end:
	; 31:3 if i & 7 == 0
	move t.12, i
	and t.12, t.12, 7
	equals t.11, t.12, 0
	branch t.11, false, @if_7_end, @if_7_then
@if_7_then:
	const t.13, 32
	call printChar@u8[t.13]
@if_7_end:
	call printChar@u8[i]
	; 35:3 if i & 15 == 15
	move t.15, i
	and t.15, t.15, 15
	equals t.14, t.15, 15
	branch t.14, false, @for_5_continue, @if_8_then
@if_8_then:
	const t.16, 10
	call printChar@u8[t.16]
@for_5_continue:
	add i, i, 1
	jump @for_5
@main_ret:

@printStringLength@@u8@i64:
	mov     rdi, rsp
	
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	mov     rdx, [rdi+18h]
	mov     r8, [rdi+10h]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

String literals
	string lit 0 " x\0"
