	cast t.2.1(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2.1]

main:
 Local variables
	var 0: a (i16/2)
	var 1: c (i16/2)
	var 2: b.1 (i16*/8)
	var 3: t.4.1 (i16/2)
	var 4: d.1 (i16*/8)
	var 5: t.6.1 (i16/2)
	var 6: t.5.1 (i16/2)
	var 7: a.a (i16*/8)
	var 8: t.a (i16/2)
	var 9: a.a1 (i16*/8)
	var 10: t.a1 (i16/2)
	var 11: a.c (i16*/8)
	var 12: t.c (i16/2)
	var 13: a.c1 (i16*/8)
	var 14: t.c1 (i16/2)
	var 15: a.c2 (i16*/8)
	var 16: t.c2 (i16/2)
	; 114 pc
	const t.a, 10
	addrof a.a, a
	store [a.a], t.a
	addrof a.a1, a
	load t.a1, [a.a1]
	call printIntLf@i16[t.a1]
	addrof b.1, a
	load t.4.1, [b.1]
	move t.c, t.4.1
	sub t.c, 1
	addrof a.c, c
	store [a.c], t.c
	addrof a.c1, c
	load t.c1, [a.c1]
	call printIntLf@i16[t.c1]
	addrof d.1, c
	load t.6.1, [d.1]
	move t.5.1, t.6.1
	sub t.5.1, 1
	store [d.1], t.5.1
	addrof a.c2, c
	load t.c2, [a.c2]
	call printIntLf@i16[t.c2]

