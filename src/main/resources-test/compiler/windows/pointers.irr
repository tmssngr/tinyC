printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	; 7 pc
	addrof memVarAddr{r7}, chr
	store [memVarAddr{r7}], chr{r1}
	move t.1.1{r1}, t.1.1{r7}
	const arg.0.1{r2}, 1
	call printStringLength@@u8@u8[t.1.1{r1}, arg.0.1{r2}]

printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	; 28 pc
	const pos.1{r6}, 20
	; 33:2 while true
	move number.1{r3}, number{r1}
while_1:
	sub pos.3{r6}, 1
	move remainder.1{r4}, number.1{r3}
	move remainder.1{r0}, remainder.1{r4}
	mod remainder.1{r2}, remainder.1{r0}, 10
	move remainder.1{r4}, remainder.1{r2}
	move number.2{r0}, number.2{r3}
	div number.2{r0}, 10
	move number.2{r3}, number.2{r0}
	cast t.5.1{r0}(u8), remainder.1{r4}(i64)
	add digit.1{r0}, 48
	cast t.7.1{r4}(i64), pos.3{r6}(u8)
	addrof t.6.1{r5}, buffer
	add t.6.2{r5}, t.7.1{r4}
	store [t.6.2{r5}], digit.1{r0}
	; 39:3 if number == 0
	branch number.2{r3} notequals 0: while_1
	move t.9.1{r0}, t.9.1{r4}
	addrof t.8.1{r3}, buffer
	move t.8.2{r1}, t.8.1{r3}
	move t.8.2{r1}, t.8.2{r5}
	const t.11.1{r0}, 20
	move t.10.1{r2}, t.11.1{r0}
	sub t.10.1{r2}, pos.3{r6}
	call printStringLength@@u8@u8[t.8.2{r1}, t.10.1{r2}]

printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 2 pc
	cast t.1.1{r1}(i64), number{r1}(u8)
	call printIntLf@i64[t.1.1{r1}]

printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	; 2 pc
	cast t.1.1{r1}(i64), number{r1}(i16)
	call printIntLf@i64[t.1.1{r1}]

printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 7 pc
	move number{r6}, number{r1}
	branch number{r6} gteq 0: if_3_end
	const arg.0.0{r1}, 45
	call printChar@u8[arg.0.0{r1}]
	neg number.2{r6}, number{r6}
if_3_end:
	move number.1{r1}, number.1{r6}
	call printUint@i64[number.1{r1}]
	const arg.2.0{r1}, 10
	call printChar@u8[arg.2.0{r1}]

printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	; 2 pc
	cast t.2.1{r2}(i64), length{r2}(u8)
	call printStringLength@@u8@i64[str{r1}, t.2.1{r2}]

testIf@u8:
 Local variables
	arg 0: a (u8/1)
	var 1: b (u8/1)
	; 16 pc
	const t.3.1{r6}, 1
	addrof a.4.1{r0}, b
	store [a.4.1{r0}], t.3.1{r6}
	move b_ref.1{r6}, b_ref.1{r0}
	; 6:2 if a == 0
	branch a{r1} notequals 0: if_4_end
	load t.5.1{r1}, [b_ref.1{r6}]
	call printIntLf@u8[t.5.1{r1}]
if_4_end:
	addrof a.6.1{r6}, b
	load t.7.1{r1}, [a.6.1{r6}]
	call printIntLf@u8[t.7.1{r1}]

main:
 Local variables
	var 0: a (i16/2)
	var 1: c (i16/2)
	; 29 pc
	const t.4.1{r6}, 10
	addrof a.5.1{r0}, a
	store [a.5.1{r0}], t.4.1{r6}
	move a.6.1{r6}, a.6.1{r0}
	load t.7.1{r1}, [a.6.1{r6}]
	call printIntLf@i16[t.7.1{r1}]
	load t.9.1{r6}, [b.1{r6}]
	sub t.8.1{r6}, 1
	addrof a.10.1{r0}, c
	store [a.10.1{r0}], t.8.1{r6}
	move a.11.1{r6}, a.11.1{r0}
	load t.12.1{r1}, [a.11.1{r6}]
	call printIntLf@i16[t.12.1{r1}]
	load t.14.1{r0}, [d.1{r6}]
	sub t.13.1{r0}, 1
	store [d.1{r6}], t.13.1{r0}
	move t.16.1{r1}, t.16.1{r0}
	call printIntLf@i16[t.16.1{r1}]
	const arg.3.0{r1}, 1
	call testIf@u8[arg.3.0{r1}]

printStringLength@@u8@i64:
	mov     rdi, rsp
	
	mov     r8, rdx
	mov     rdx, rcx
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

