testIf@u8:
 Local variables
	arg 0: a (u8/1)
	var 1: b (u8/1)
	var 2: t.3.1 (u8/1)
	var 3: a.4.1 (u8*/8)
	var 4: b_ref.1 (u8*/8)
	var 5: t.5.1 (u8/1)
	var 6: a.6.1 (u8*/8)
	var 7: t.7.1 (u8/1)
	; 44 pc
	const t.3.1, 1
	addrof a.4.1, b
	store [a.4.1], t.3.1
	addrof b_ref.1, b
	; 6:2 if a == 0
	branch a notequals 0: if_4_end, if_4_then
	load t.5.1, [b_ref.1]
	call printIntLf@u8[t.5.1]
if_4_end:
	addrof a.6.1, b
	load t.7.1, [a.6.1]
	call printIntLf@u8[t.7.1]

main:
 Local variables
