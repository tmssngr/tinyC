printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1.1 (u8*/8)
	; 8 pc
	addrof t.1.1, chr
	call printStringLength@@u8@u8[t.1.1, 1]

printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	var 2: pos.1 (u8/1)
	var 3: number.1 (i64/8)
	var 4: pos.2 (u8/1)
	var 5: pos.3 (u8/1)
	var 6: remainder.1 (i64/8)
	var 7: number.2 (i64/8)
	var 8: t.5.1 (u8/1)
	var 9: digit.1 (u8/1)
	var 10: t.7.1 (i64/8)
	var 11: t.6.1 (u8*/8)
	var 12: t.6.2 (u8*/8)
	var 13: t.9.1 (i64/8)
	var 14: t.8.1 (u8*/8)
	var 15: t.8.2 (u8*/8)
	var 16: t.11.1 (u8/1)
	var 17: t.10.1 (u8/1)
	; 140 pc
	const pos.1, 20
	; 28:2 while true
	move number.1, number
	move pos.2, pos.1
	jump while_1
printUint@i64.no_critical_edge_4:
	move number.1, number.2
	move pos.2, pos.3
while_1:
	move pos.3, pos.2
	sub pos.3, 1
	move remainder.1, number.1
	mod remainder.1, 10
	move number.2, number.1
	div number.2, 10
	cast t.5.1(u8), remainder.1(i64)
	move digit.1, t.5.1
	add digit.1, 48
	cast t.7.1(i64), pos.3(u8)
	addrof t.6.1, buffer
	move t.6.2, t.6.1
	add t.6.2, t.7.1
	store [t.6.2], digit.1
	; 34:3 if number == 0
	branch number.2 notequals 0: printUint@i64.no_critical_edge_4, while_1_break
	cast t.9.1(i64), pos.3(u8)
	addrof t.8.1, buffer
	move t.8.2, t.8.1
	add t.8.2, t.9.1
	const t.11.1, 20
	move t.10.1, t.11.1
	sub t.10.1, pos.3
	call printStringLength@@u8@u8[t.8.2, t.10.1]

printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1.1 (i64/8)
	; 8 pc
	cast t.1.1(i64), number(i16)
	call printIntLf@i64[t.1.1]

printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: number.1 (i64/8)
	var 2: number.2 (i64/8)
	; 24 pc
	branch number lt 0: if_3_then, printIntLf@i64.no_critical_edge_4
	move number.1, number
	jump if_3_end
if_3_then:
	call printChar@u8[45]
	neg number.2, number
	move number.1, number.2
if_3_end:
	call printUint@i64[number.1]
	call printChar@u8[10]

printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2.1 (i64/8)
