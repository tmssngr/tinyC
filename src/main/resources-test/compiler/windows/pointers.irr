printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1 (u8*/8)
	; 8 pc
	addrof t.1, chr
	call printStringLength@@u8@u8[t.1, 1]

printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	var 2: pos (u8/1)
	var 3: remainder (i64/8)
	var 4: digit (u8/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8*/8)
	var 7: t.7 (i64/8)
	var 8: t.8 (u8*/8)
	var 9: t.9 (i64/8)
	var 10: t.10 (u8/1)
	var 11: t.11 (u8/1)
	; 99 pc
	const pos, 20
	; 28:2 while true
while_1:
	sub pos, 1
	move remainder, number
	mod remainder, 10
	div number, 10
	cast t.5(u8), remainder(i64)
	move digit, t.5
	add digit, 48
	cast t.7(i64), pos(u8)
	addrof t.6, buffer
	add t.6, t.7
	store [t.6], digit
	; 34:3 if number == 0
	branch number notequals 0: while_1, while_1_break
	cast t.9(i64), pos(u8)
	addrof t.8, buffer
	add t.8, t.9
	const t.11, 20
	move t.10, t.11
	sub t.10, pos
	call printStringLength@@u8@u8[t.8, t.10]

printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	var 1: t.1 (i64/8)
	; 8 pc
	cast t.1(i64), number(u8)
	call printIntLf@i64[t.1]

printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (i64/8)
	; 8 pc
	cast t.1(i64), number(i16)
	call printIntLf@i64[t.1]

printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 13 pc
	branch number gteq 0: if_3_end, if_3_then
	call printChar@u8[45]
	neg number, number
if_3_end:
	call printUint@i64[number]
	call printChar@u8[10]

printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2 (i64/8)
	; 10 pc
	cast t.2(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2]

testIf@u8:
 Local variables
	arg 0: a (u8/1)
	var 1: b (u8/1)
	var 2: b_ref (u8*/8)
	var 3: t.3 (u8/1)
	var 4: a.4 (u8*/8)
	var 5: t.5 (u8/1)
	var 6: a.6 (u8*/8)
	var 7: t.7 (u8/1)
	; 44 pc
	const t.3, 1
	addrof a.4, b
	store [a.4], t.3
	addrof b_ref, b
	; 6:2 if a == 0
	branch a notequals 0: if_4_end, if_4_then
	load t.5, [b_ref]
	call printIntLf@u8[t.5]
if_4_end:
	addrof a.6, b
	load t.7, [a.6]
	call printIntLf@u8[t.7]

main:
 Local variables
	var 0: a (i16/2)
	var 1: b (i16*/8)
	var 2: c (i16/2)
	var 3: d (i16*/8)
	var 4: t.4 (i16/2)
	var 5: a.5 (i16*/8)
	var 6: a.6 (i16*/8)
	var 7: t.7 (i16/2)
	var 8: t.8 (i16/2)
	var 9: t.9 (i16/2)
	var 10: a.10 (i16*/8)
	var 11: a.11 (i16*/8)
	var 12: t.12 (i16/2)
	var 13: t.13 (i16/2)
	var 14: t.14 (i16/2)
	var 15: a.15 (i16*/8)
	var 16: t.16 (i16/2)
	; 115 pc
	const t.4, 10
	addrof a.5, a
	store [a.5], t.4
	addrof a.6, a
	load t.7, [a.6]
	call printIntLf@i16[t.7]
	addrof b, a
	load t.9, [b]
	move t.8, t.9
	sub t.8, 1
	addrof a.10, c
	store [a.10], t.8
	addrof a.11, c
	load t.12, [a.11]
	call printIntLf@i16[t.12]
	addrof d, c
	load t.14, [d]
	move t.13, t.14
	sub t.13, 1
	store [d], t.13
	addrof a.15, c
	load t.16, [a.15]
	call printIntLf@i16[t.16]
	call testIf@u8[1]

printStringLength@@u8@i64:
	mov     rdi, rsp
	
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	mov     rdx, [rdi+18h]
	mov     r8, [rdi+10h]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

