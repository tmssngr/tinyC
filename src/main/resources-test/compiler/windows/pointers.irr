printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: number.1 (i64/8)
	var 2: number.2 (i64/8)
	; 24 pc
	branch number gteq 0: printIntLf@i64.no_critical_edge_4, if_3_then
	call printChar@u8[45]
	neg number.2, number
	move number.1, number.2
	jump if_3_end
printIntLf@i64.no_critical_edge_4:
	move number.1, number
if_3_end:
	call printUint@i64[number.1]
	call printChar@u8[10]

printStringLength@@u8@u8:
 Local variables
