printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1 (u8*/8)
	; 8 pc
	addrof t.1, chr
	call printStringLength@@u8@u8[t.1, 1]

printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	var 2: pos (u8/1)
	var 3: remainder (i64/8)
	var 4: digit (u8/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8*/8)
	var 7: t.7 (i64/8)
	var 8: t.8 (u8*/8)
	var 9: t.9 (i64/8)
	var 10: t.10 (u8/1)
	var 11: t.11 (u8/1)
	; 99 pc
	const pos, 20
	; 28:2 while true
while_1:
	sub pos, pos, 1
	move remainder, number
	mod remainder, remainder, 10
	div number, number, 10
	cast t.5(u8), remainder(i64)
	move digit, t.5
	add digit, digit, 48
	cast t.7(i64), pos(u8)
	addrof t.6, buffer
	add t.6, t.6, t.7
	store [t.6], digit
	; 34:3 if number == 0
	branch number notequals 0: while_1, while_1_break
	cast t.9(i64), pos(u8)
	addrof t.8, buffer
	add t.8, t.8, t.9
	const t.11, 20
	move t.10, t.11
	sub t.10, t.10, pos
	call printStringLength@@u8@u8[t.8, t.10]

printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (i64/8)
	; 8 pc
	cast t.1(i64), number(i16)
	call printIntLf@i64[t.1]

printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 13 pc
	branch number gteq 0: if_3_end, if_3_then
	call printChar@u8[45]
	neg number, number
if_3_end:
	call printUint@i64[number]
	call printChar@u8[10]

printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2 (i64/8)
	; 10 pc
	cast t.2(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2]

main:
 Local variables
	var 0: a (i16/2)
	var 1: b (i16*/8)
	var 2: c (i16/2)
	var 3: d (i16*/8)
	var 4: t.4 (i16/2)
	var 5: t.5 (i16/2)
	var 6: t.6 (i16/2)
	var 7: t.1 (i16/2)
	var 8: a.1 (i16*/8)
	var 9: a.2 (i16*/8)
	var 10: t.2 (i16/2)
	var 11: t.3 (i16/2)
	var 12: a.3 (i16*/8)
	var 13: a.4 (i16*/8)
	var 14: t.7 (i16/2)
	var 15: a.5 (i16*/8)
	var 16: t.8 (i16/2)
	; 114 pc
	const t.1, 10
	addrof a.1, a
	store [a.1], t.1
	addrof a.2, a
	load t.2, [a.2]
	call printIntLf@i16[t.2]
	addrof b, a
	load t.4, [b]
	move t.3, t.4
	sub t.3, t.3, 1
	addrof a.3, c
	store [a.3], t.3
	addrof a.4, c
	load t.7, [a.4]
	call printIntLf@i16[t.7]
	addrof d, c
	load t.6, [d]
	move t.5, t.6
	sub t.5, t.5, 1
	store [d], t.5
	addrof a.5, c
	load t.8, [a.5]
	call printIntLf@i16[t.8]

printStringLength@@u8@i64:
	mov     rdi, rsp
	
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	mov     rdx, [rdi+18h]
	mov     r8, [rdi+10h]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

