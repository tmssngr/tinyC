printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	; 7 pc
	addrof memVarAddr{r7}, chr
	store [memVarAddr{r7}], chr{r1}
	move t.1{r1}, t.1{r7}
	const arg.0.1{r2}, 1
	call printStringLength@@u8@u8[t.1{r1}, arg.0.1{r2}]

printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	; 27 pc
	move number{r6}, number{r1}
	const pos{r3}, 20
	; 33:2 while true
while_1:
	sub pos{r3}, 1
	move remainder{r4}, number{r6}
	move remainder{r0}, remainder{r4}
	mod remainder{r2}, remainder{r0}, 10
	move remainder{r4}, remainder{r2}
	move number{r0}, number{r6}
	div number{r0}, 10
	move number{r6}, number{r0}
	cast t.5{r0}(u8), remainder{r4}(i64)
	add digit{r0}, 48
	cast t.7{r4}(i64), pos{r3}(u8)
	addrof t.6{r5}, buffer
	add t.6{r5}, t.7{r4}
	store [t.6{r5}], digit{r0}
	; 39:3 if number == 0
	branch number{r6} notequals 0: while_1
	move t.9{r6}, t.9{r4}
	addrof t.8{r1}, buffer
	move t.8{r1}, t.8{r5}
	const t.11{r6}, 20
	move t.10{r2}, t.11{r6}
	sub t.10{r2}, pos{r3}
	call printStringLength@@u8@u8[t.8{r1}, t.10{r2}]

printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 2 pc
	cast t.1{r1}(i64), number{r1}(u8)
	call printIntLf@i64[t.1{r1}]

printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 7 pc
	move number{r6}, number{r1}
	; 59:2 if number < 0
	branch number{r6} gteq 0: if_3_end
	const arg.0.0{r1}, 45
	call printChar@u8[arg.0.0{r1}]
	neg number{r6}, number{r6}
if_3_end:
	move number{r1}, number{r6}
	call printUint@i64[number{r1}]
	const arg.2.0{r1}, 10
	call printChar@u8[arg.2.0{r1}]

printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	; 2 pc
	cast t.2{r2}(i64), length{r2}(u8)
	call printStringLength@@u8@i64[str{r1}, t.2{r2}]

main:
	; 39 pc
	const chr{r6}, 32
	const t.3{r0}, 0
	addrof t.2{r2}, chars
	add t.2{r2}, t.3{r0}
	store [t.2{r2}], chr{r6}
	const t.7{r6}, 0
	addrof t.6{r0}, chars
	move t.6{r0}, t.6{r2}
	load t.5{r6}, [t.6{r0}]
	add t.4{r6}, 1
	const t.9{r0}, 1
	addrof t.8{r2}, chars
	add t.8{r2}, t.9{r0}
	store [t.8{r2}], t.4{r6}
	const t.13{r6}, 1
	addrof t.12{r0}, chars
	move t.12{r0}, t.12{r2}
	load t.11{r6}, [t.12{r0}]
	add t.10{r6}, 2
	const t.15{r0}, 2
	addrof t.14{r2}, chars
	add t.14{r2}, t.15{r0}
	store [t.14{r2}], t.10{r6}
	const t.17{r6}, 2
	addrof t.16{r0}, chars
	move t.16{r0}, t.16{r2}
	load result{r1}, [t.16{r0}]
	call printIntLf@u8[result{r1}]

printStringLength@@u8@i64:
	mov     rdi, rsp
	
	mov     r8, rdx
	mov     rdx, rcx
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
