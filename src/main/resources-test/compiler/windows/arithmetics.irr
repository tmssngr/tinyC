@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1 (u8*/8)
	var 2: t.2 (u8/1)
	; 12 pc
	addrof t.1, chr
	const t.2, 1
	call printStringLength@@u8@u8[t.1, t.2]

@printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	var 2: pos (u8/1)
	var 3: remainder (i64/8)
	var 4: digit (u8/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8*/8)
	var 7: t.7 (i64/8)
	var 8: t.8 (bool/1)
	var 9: t.9 (u8*/8)
	var 10: t.10 (i64/8)
	var 11: t.11 (u8/1)
	var 12: t.12 (u8/1)
	; 100 pc
	const pos, 20
	; 28:2 while true
@while_1:
	sub pos, pos, 1
	move remainder, number
	mod remainder, remainder, 10
	div number, number, 10
	cast t.5(u8), remainder(i64)
	move digit, t.5
	add digit, digit, 48
	cast t.7(i64), pos(u8)
	addrof t.6, [buffer]
	add t.6, t.6, t.7
	store [t.6], digit
	; 34:3 if number == 0
	equals t.8, number, 0
	branch t.8, false, @while_1, @while_1_break
	cast t.10(i64), pos(u8)
	addrof t.9, [buffer]
	add t.9, t.9, t.10
	const t.12, 20
	move t.11, t.12
	sub t.11, t.11, pos
	call printStringLength@@u8@u8[t.9, t.11]

@printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (i64/8)
	; 8 pc
	cast t.1(i64), number(i16)
	call printIntLf@i64[t.1]

@printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: t.1 (bool/1)
	var 2: t.2 (u8/1)
	var 3: t.3 (u8/1)
	; 26 pc
	; 54:2 if number < 0
	lt t.1, number, 0
	branch t.1, false, @if_3_end, @if_3_then
	const t.2, 45
	call printChar@u8[t.2]
	neg number, number
@if_3_end:
	call printUint@i64[number]
	const t.3, 10
	call printChar@u8[t.3]

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2 (i64/8)
	; 10 pc
	cast t.2(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2]

@main:
 Local variables
	var 0: foo (i16/2)
	var 1: bar (i16/2)
	var 2: bazz (i16/2)
	var 3: a (i16/2)
	var 4: b (i16/2)
	var 5: t.5 (i16/2)
	var 6: t.6 (i16/2)
	var 7: t.7 (i16/2)
	var 8: t.8 (i16/2)
	var 9: t.9 (i16/2)
	var 10: t.10 (i16/2)
	; 126 pc
	const foo, 22
	move bar, foo
	mul bar, bar, foo
	const foo, 1
	move t.5, bar
	add t.5, t.5, foo
	call printIntLf@i16[t.5]
	const foo, 21
	call printIntLf@i16[foo]
	call printIntLf@i16[bazz]
	const a, 1000
	const b, 10
	move t.6, a
	div t.6, t.6, b
	call printIntLf@i16[t.6]
	move t.7, a
	and t.7, t.7, 255
	call printIntLf@i16[t.7]
	const a, 10
	const b, 1
	move t.8, a
	shiftright t.8, t.8, b
	call printIntLf@i16[t.8]
	const a, 9
	const b, 2
	move t.9, a
	shiftright t.9, t.9, b
	call printIntLf@i16[t.9]
	const a, 1
	move t.10, a
	shiftleft t.10, t.10, b
	call printIntLf@i16[t.10]

@printStringLength@@u8@i64:
	mov     rdi, rsp
	
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	mov     rdx, [rdi+18h]
	mov     r8, [rdi+10h]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

