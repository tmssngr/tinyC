printString@@u8:
 Local variables
	arg 0: str (u8*/8)
	var 1: length (i64/8)
	; 10 pc
	call length = strlen@@u8[str] -> i64
	call printStringLength@@u8@i64[str, length]

printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1 (u8*/8)
	; 8 pc
	addrof t.1, chr
	call printStringLength@@u8@u8[t.1, 1]

printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	var 2: pos (u8/1)
	var 3: remainder (i64/8)
	var 4: digit (u8/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8*/8)
	var 7: t.7 (i64/8)
	var 8: t.8 (u8*/8)
	var 9: t.9 (i64/8)
	var 10: t.10 (u8/1)
	var 11: t.11 (u8/1)
	; 95 pc
	const pos, 20
	; 28:2 while true
while_1:
	sub pos, pos, 1
	move remainder, number
	mod remainder, remainder, 10
	div number, number, 10
	cast t.5(u8), remainder(i64)
	move digit, t.5
	add digit, digit, 48
	cast t.7(i64), pos(u8)
	addrof t.6, [buffer]
	add t.6, t.6, t.7
	store [t.6], digit
	; 34:3 if number == 0
	branch number notequals 0: while_1, while_1_break
	cast t.9(i64), pos(u8)
	addrof t.8, [buffer]
	add t.8, t.8, t.9
	const t.11, 20
	move t.10, t.11
	sub t.10, t.10, pos
	call printStringLength@@u8@u8[t.8, t.10]

printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	var 1: t.1 (i64/8)
	; 8 pc
	cast t.1(i64), number(u8)
	call printIntLf@i64[t.1]

printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (i64/8)
	; 8 pc
	cast t.1(i64), number(i16)
	call printIntLf@i64[t.1]

printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 13 pc
	branch number gteq 0: if_3_end, if_3_then
	call printChar@u8[45]
	neg number, number
if_3_end:
	call printUint@i64[number]
	call printChar@u8[10]

strlen@@u8:
 Local variables
	arg 0: str (u8*/8)
	var 1: length (i64/8)
	var 2: t.2 (u8/1)
	; 25 pc
	const length, 0
	; 64:2 for *str != 0
	jump for_4
for_4_body:
	add length, length, 1
	add str, str, 1
for_4:
	load t.2, [str]
	branch t.2 notequals 0: for_4_body, for_4_break
	; 67:9 return length
	ret length

printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2 (i64/8)
	; 10 pc
	cast t.2(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2]

main:
 Local variables
	var 0: second (u8*/8)
	var 1: chr (u8/1)
	var 2: t.2 (i64/8)
	var 3: a.text (u8**/8)
	var 4: t.text (u8*/8)
	var 5: a.text1 (u8**/8)
	var 6: t.text1 (u8*/8)
	var 7: a.text2 (u8**/8)
	var 8: t.text2 (u8*/8)
	var 9: a.text3 (u8**/8)
	var 10: t.text3 (u8*/8)
	; 77 pc
	; begin initialize global variables
	const t.text, [string-0]
	addrof a.text, text
	store [a.text], t.text
	; end initialize global variables
	addrof a.text1, text
	load t.text1, [a.text1]
	call printString@@u8[t.text1]
	call printLength[]
	const t.2, 1
	addrof a.text2, text
	load t.text2, [a.text2]
	move second, t.text2
	add second, second, t.2
	call printString@@u8[second]
	addrof a.text3, text
	load t.text3, [a.text3]
	load chr, [t.text3]
	call printIntLf@u8[chr]

printLength:
 Local variables
	var 0: length (i16/2)
	var 1: ptr (u8*/8)
	var 2: t.2 (u8/1)
	var 3: a.text (u8**/8)
	var 4: t.text (u8*/8)
	; 41 pc
	const length, 0
	addrof a.text, text
	load t.text, [a.text]
	move ptr, t.text
	; 16:2 for *ptr != 0
	jump for_5
for_5_body:
	add length, length, 1
	add ptr, ptr, 1
for_5:
	load t.2, [ptr]
	branch t.2 notequals 0: for_5_body, for_5_break
	call printIntLf@i16[length]

printStringLength@@u8@i64:
	mov     rdi, rsp
	
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	mov     rdx, [rdi+18h]
	mov     r8, [rdi+10h]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

Global variables
	0: text (u8*/8)

