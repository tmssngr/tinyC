@printString@@u8:
 Local variables
	arg 0: str (u8*/8)
	; 6 pc
	move str{r6}, str{r1}
	move str{r1}, str{r6}
	call length{r0} = strlen@@u8[str{r1}] -> i64
	move str{r1}, str{r6}
	move length{r2}, length{r0}
	call printStringLength@@u8@i64[str{r1}, length{r2}]

@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	; 7 pc
	move chr, chr{r1}
	addrof t.1{r1}, chr
	const t.2{r2}, 1
	call printStringLength@@u8@u8[t.1{r1}, t.2{r2}]

@printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	; 23 pc
	const pos{r6}, 20
	; 25:2 while true
@while_1:
	const t.5{r7}, 1
	sub pos{r6}, pos{r6}, t.5{r7}
	const t.6{r7}, 10
	move remainder{r3}, number{r1}
	move remainder{r0}, remainder{r3}
	mod remainder{r2}, remainder{r0}, t.6{r7}
	move remainder{r3}, remainder{r2}
	const t.7{r7}, 10
	move number{r0}, number{r1}
	div number{r0}, number{r0}, t.7{r7}
	move number{r1}, number{r0}
	cast t.8{r7}(u8), remainder{r3}(i64)
	const t.9{r0}, 48
	add digit{r7}, digit{r7}, t.9{r0}
	cast t.11{r0}(i64), pos{r6}(u8)
	addrof t.10{r3}, [buffer]
	add t.10{r3}, t.10{r3}, t.11{r0}
	store [t.10{r3}], digit{r7}
	; 31:3 if number == 0
	const t.13{r7}, 0
	equals t.12{r7}, number{r1}, t.13{r7}
	branch t.12{r7}, false, @while_1, @while_1_break
	cast t.15{r7}(i64), pos{r6}(u8)
	addrof t.14{r1}, [buffer]
	add t.14{r1}, t.14{r1}, t.15{r7}
	const t.17{r7}, 20
	move t.16{r2}, t.17{r7}
	sub t.16{r2}, t.16{r2}, pos{r6}
	call printStringLength@@u8@u8[t.14{r1}, t.16{r2}]

@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 2 pc
	cast t.1{r1}(i64), number{r1}(u8)
	call printIntLf@i64[t.1{r1}]

@printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	; 2 pc
	cast t.1{r1}(i64), number{r1}(i16)
	call printIntLf@i64[t.1{r1}]

@printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 8 pc
	move number{r6}, number{r1}
	; 51:2 if number < 0
	const t.2{r7}, 0
	lt t.1{r7}, number{r6}, t.2{r7}
	branch t.1{r7}, false, @if_3_end, @if_3_then
	const t.3{r1}, 45
	call printChar@u8[t.3{r1}]
	neg number{r6}, number{r6}
@if_3_end:
	move number{r1}, number{r6}
	call printUint@i64[number{r1}]
	const t.4{r1}, 10
	call printChar@u8[t.4{r1}]

@strlen@@u8:
 Local variables
	arg 0: str (u8*/8)
	; 7 pc
	const length{r0}, 0
	; 61:2 for *str != 0
	jump @for_4
@for_4_body:
	const t.5{r2}, 1
	add length{r0}, length{r0}, t.5{r2}
	const t.6{r2}, 1
	add str{r1}, str{r1}, t.6{r2}
@for_4:
	load t.3{r2}, [str{r1}]
	const t.4{r3}, 0
	notequals t.2{r2}, t.3{r2}, t.4{r3}
	branch t.2{r2}, true, @for_4_body, @for_4_break
	; 64:9 return length

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	; 2 pc
	cast t.2{r2}(i64), length{r2}(u8)
	call printStringLength@@u8@i64[str{r1}, t.2{r2}]

@main:
	; 19 pc
	; begin initialize global variables
	const tmp.text{r6}, [string-0]
	; end initialize global variables
	move text, tmp.text{r6}
	move tmp.text{r1}, tmp.text{r6}
	call printString@@u8[tmp.text{r1}]
	call printLength[]
	const t.2{r7}, 1
	move tmp.text{r6}, text
	move second{r1}, tmp.text{r6}
	add second{r1}, second{r1}, t.2{r7}
	call printString@@u8[second{r1}]
	move tmp.text{r6}, text
	load chr{r1}, [tmp.text{r6}]
	call printIntLf@u8[chr{r1}]

@printLength:
	; 11 pc
	const length{r1}, 0
	move tmp.text{r6}, text
	; 16:2 for *ptr != 0
	jump @for_5
@for_5_body:
	const t.5{r7}, 1
	add length{r1}, length{r1}, t.5{r7}
	const t.6{r7}, 1
	add ptr{r6}, ptr{r6}, t.6{r7}
@for_5:
	load t.3{r7}, [ptr{r6}]
	const t.4{r0}, 0
	notequals t.2{r7}, t.3{r7}, t.4{r0}
	branch t.2{r7}, true, @for_5_body, @for_5_break
	call printIntLf@i16[length{r1}]

@printStringLength@@u8@i64:
	mov     rdi, rsp
	
	mov     r8, rdx
	mov     rdx, rcx
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

Global variables
	0: text (u8*/8)

String literals
	string lit 0 "hello world\n\0"
