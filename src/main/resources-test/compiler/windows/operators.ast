void _printStringLength@@u8@i64(u8* str, i64 length) asm {
}

void _printString@@u8(u8* str) {
	i64 length;

	length = _strlen@@u8(str);
	_printStringLength@@u8@i64(str, length);
}

void _printChar@u8(u8 chr) {
	_printStringLength@@u8@u8(&chr, 1);
}

void _printUint@i64(i64 number) {
	u8* buffer[20];
	u8 pos;
	i64 remainder;
	u8 digit;

	pos = 20;
	while (true) {
		pos = pos - 1;
		remainder = number % 10;
		number = number / 10;
		digit = (remainder as u8) + 48;
		buffer[pos as i64] = digit;
		if (number == 0) {
			break;
		}
	}
	_printStringLength@@u8@u8(&buffer[pos as i64], 20 - pos);
}

void _printIntLf@bool(bool value) {
	u8 number;

	number = 0;
	if (value) {
		number = 1;
	}
	_printIntLf@i64(number as i64);
}

void _printIntLf@u8(u8 number) {
	_printIntLf@i64(number as i64);
}

void _printIntLf@i16(i16 number) {
	_printIntLf@i64(number as i64);
}

void _printIntLf@i64(i64 number) {
	if (number < 0) {
		_printChar@u8(45);
		number = -number;
	}
	_printUint@i64(number);
	_printChar@u8(10);
}

i64 _strlen@@u8(u8* str) {
	i64 length;

	length = 0;
	for (; (*str) != 0; str = str + 1) {
		length = length + 1;
	}
	return length;
}

void _printStringLength@@u8@u8(u8* str, u8 length) {
	_printStringLength@@u8@i64(str, length as i64);
}

bool _getTrue() {
	_printString@@u8(" true");
	return true;
}

bool _getFalse() {
	_printString@@u8(" false");
	return false;
}

void _printPass() {
	_printString@@u8(" -> pass ");
}

void _printError() {
	_printString@@u8(" -> ERROR ");
}

void _logicNot() {
	bool t;
	bool f;

	_printString@@u8("\nLogic-!:\n");
	t = true;
	f = false;
	if (!(_getFalse())) {
		_printPass();
	}
	else {
		_printError();
	}
	_printIntLf@bool(!f);
	if (!(_getTrue())) {
		_printError();
	}
	else {
		_printPass();
	}
	_printIntLf@bool(!t);
}

void _logicAnd() {
	bool t;
	bool f;

	_printString@@u8("\nLogic-&&:\n");
	t = true;
	f = false;
	if ((_getFalse()) && (_getFalse())) {
		_printError();
	}
	else {
		_printPass();
	}
	_printIntLf@bool(f && f);
	if ((_getFalse()) && (_getTrue())) {
		_printError();
	}
	else {
		_printPass();
	}
	_printIntLf@bool(f && t);
	if ((_getTrue()) && (_getFalse())) {
		_printError();
	}
	else {
		_printPass();
	}
	_printIntLf@bool(t && f);
	if ((_getTrue()) && (_getTrue())) {
		_printPass();
	}
	else {
		_printError();
	}
	_printIntLf@bool(t && t);
	if (!((_getFalse()) && (_getFalse()))) {
		_printPass();
	}
	else {
		_printError();
	}
	_printIntLf@bool(!(f && f));
	if (!((_getFalse()) && (_getTrue()))) {
		_printPass();
	}
	else {
		_printError();
	}
	_printIntLf@bool(!(f && t));
	if (!((_getTrue()) && (_getFalse()))) {
		_printPass();
	}
	else {
		_printError();
	}
	_printIntLf@bool(!(t && f));
	if (!((_getTrue()) && (_getTrue()))) {
		_printError();
	}
	else {
		_printPass();
	}
	_printIntLf@bool(!(t && t));
}

void _logicOr() {
	bool t;
	bool f;

	_printString@@u8("\nLogic-||:\n");
	t = true;
	f = false;
	if ((_getFalse()) || (_getFalse())) {
		_printError();
	}
	else {
		_printPass();
	}
	_printIntLf@bool(f || f);
	if ((_getFalse()) || (_getTrue())) {
		_printPass();
	}
	else {
		_printError();
	}
	_printIntLf@bool(f || t);
	if ((_getTrue()) || (_getFalse())) {
		_printPass();
	}
	else {
		_printError();
	}
	_printIntLf@bool(t || f);
	if ((_getTrue()) || (_getTrue())) {
		_printPass();
	}
	else {
		_printError();
	}
	_printIntLf@bool(t || t);
}

void _main() {
	i16 a;
	i16 b;
	i16 c;
	i16 d;
	bool t;
	bool f;
	u8 b10;
	u8 b6;
	u8 b1;

	_printString@@u8("Bit-&:\n");
	a = 0;
	b = 1;
	c = 2;
	d = 3;
	t = true;
	f = false;
	_printIntLf@i16(a & a);
	_printIntLf@i16(a & b);
	_printIntLf@i16(b & a);
	_printIntLf@i16(b & b);
	_printString@@u8("\nBit-|:\n");
	_printIntLf@i16(a | a);
	_printIntLf@i16(a | b);
	_printIntLf@i16(b | a);
	_printIntLf@i16(b | b);
	_printString@@u8("\nBit-^:\n");
	_printIntLf@i16(a ^ a);
	_printIntLf@i16(a ^ c);
	_printIntLf@i16(b ^ a);
	_printIntLf@i16(b ^ c);
	_logicNot();
	_logicAnd();
	_logicOr();
	if ((!((_getTrue()) && (_getTrue()))) || (!((_getFalse()) && (_getFalse())))) {
		_printPass();
	}
	else {
		_printError();
	}
	_printIntLf@bool((!(t && t)) || (!(f && f)));
	_printString@@u8("\n\nmisc:\n");
	b10 = 10;
	b6 = 6;
	b1 = 1;
	_printIntLf@u8((b10 & b6) | b1);
	_printIntLf@bool((b == c) || (c < d));
	_printIntLf@bool((b == c) && (c < d));
	_printIntLf@i16(-1);
	_printIntLf@i16(-b);
	_printIntLf@u8(~b1);
}
