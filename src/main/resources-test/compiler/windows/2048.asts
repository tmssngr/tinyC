i32 __random__;
u8* tiles[16];
i32 score;
u8 gameState;

void _printStringLength@@u8@i64(u8* str, i64 length) asm {
}

i16 _getChar() asm {
}

void _setCursor@i16@i16(i16 row, i16 column) asm {
}

void _printString@@u8(u8* str) {
	i64 length;

	length = _strlen@@u8(str);
	_printStringLength@@u8@i64(str, length);
}

void _printChar@u8(u8 chr) {
	_printStringLength@@u8@u8(&chr, 1);
}

void _printUint@i32(i32 number) {
	_printUint@i64(number as i64);
}

void _printUint@i64(i64 number) {
	u8* buffer[20];
	u8 pos;
	i64 remainder;
	u8 digit;

	pos = 20;
	while (true) {
		pos = pos - 1;
		remainder = number % 10;
		number = number / 10;
		digit = (remainder as u8) + 48;
		buffer[pos as i64] = digit;
		if (number == 0) {
			break;
		}
	}
	_printStringLength@@u8@u8(&buffer[pos as i64], 20 - pos);
}

i64 _strlen@@u8(u8* str) {
	i64 length;

	length = 0;
	for (; (*str) != 0; str = str + 1) {
		length = length + 1;
	}
	return length;
}

void _printStringLength@@u8@u8(u8* str, u8 length) {
	_printStringLength@@u8@i64(str, length as i64);
}

void _initRandom@i32(i32 salt) {
	__random__ = salt;
}

i32 _random() {
	i32 r;
	i32 b;
	i32 c;
	i32 d;
	i32 e;

	r = __random__;
	b = (r & 524287) * 48271;
	c = (r >> 15) * 48271;
	d = (c & 65535) << 15;
	e = ((c >> 16) + b) + d;
	__random__ = (e & 2147483647) + (e >> 31);
	return __random__;
}

i16 _random16() {
	return ((_random()) as i16) & 32767;
}

i16 _tileValue@u8(u8 exponent) {
	i16 value;
	u8 index;

	value = 1;
	index = 0;
	for (; index < exponent; index = index + 1) {
		value = value << 1;
	}
	return value;
}

void _spawnTile() {
	u8 emptyCount;
	u8 index;
	u8 chosen;
	u8 index;
	u8 tile;

	emptyCount = 0;
	index = 0;
	for (; index < 16; index = index + 1) {
		if (tiles[index as i64] == 0) {
			emptyCount = emptyCount + 1;
		}
	}
	if (emptyCount == 0) {
		return;
	}
	chosen = ((_random16()) % (emptyCount as i16)) as u8;
	index = 0;
	for (; index < 16; index = index + 1) {
		if (tiles[index as i64] != 0) {
			continue;
		}
		if (chosen == 0) {
			tile = 1;
			if (((_random16()) % 10) == 0) {
				tile = 2;
			}
			tiles[index as i64] = tile;
			return;
		}
		chosen = chosen - 1;
	}
}

bool _slideLine@u8@u8(u8 first, u8 step) {
	u8 source;
	u8 target;
	bool previousMerged;
	bool moved;
	u8 position;
	u8* sourceTile;
	u8 tile;
	bool merged;
	u8 previous;
	u8* previousTile;
	u8 nextTile;
	i32 mergedScore;

	source = first;
	target = first;
	previousMerged = false;
	moved = false;
	position = 0;
	for (; position < 4; position = position + 1) {
		sourceTile = &tiles[source as i64];
		tile = *sourceTile;
		if (tile != 0) {
			*sourceTile = 0;
			merged = false;
			if ((target != first) && (!previousMerged)) {
				previous = target - step;
				previousTile = &tiles[previous as i64];
				if ((*previousTile) == tile) {
					nextTile = tile + 1;
					*previousTile = nextTile;
					mergedScore = (_tileValue@u8(nextTile)) as i32;
					score = score + mergedScore;
					if (nextTile == 11) {
						gameState = 1;
					}
					merged = true;
					previousMerged = true;
					moved = true;
				}
			}
			if (!merged) {
				tiles[target as i64] = tile;
				if (target != source) {
					moved = true;
				}
				target = target + step;
				previousMerged = false;
			}
		}
		source = source + step;
	}
	return moved;
}

bool _slide@u8(u8 direction) {
	bool moved;
	u8 line;
	u8 first;
	u8 step;

	moved = false;
	line = 0;
	for (; line < 4; line = line + 1) {
		first = line << 2;
		step = 1;
		if (direction == 1) {
			first = first + 3;
			step = 255;
		}
		else {
			if (direction == 2) {
				first = line;
				step = 4;
			}
			else {
				if (direction == 3) {
					first = line + 12;
					step = 252;
				}
			}
		}
		if (_slideLine@u8@u8(first, step)) {
			moved = true;
		}
	}
	return moved;
}

bool _canMove() {
	u8 index;
	u8 tile;

	index = 0;
	for (; index < 16; index = index + 1) {
		tile = tiles[index as i64];
		if (tile == 0) {
			return true;
		}
		if (((index & 3) != 3) && (tiles[(index + 1) as i64] == tile)) {
			return true;
		}
		if ((index < 12) && (tiles[(index + 4) as i64] == tile)) {
			return true;
		}
	}
	return false;
}

void _printTile@u8(u8 exponent) {
	if (exponent == 0) {
		_printString@@u8("      ");
	}
	else {
		if (exponent == 1) {
			_printString@@u8("   2  ");
		}
		else {
			if (exponent == 2) {
				_printString@@u8("   4  ");
			}
			else {
				if (exponent == 3) {
					_printString@@u8("   8  ");
				}
				else {
					if (exponent == 4) {
						_printString@@u8("  16  ");
					}
					else {
						if (exponent == 5) {
							_printString@@u8("  32  ");
						}
						else {
							if (exponent == 6) {
								_printString@@u8("  64  ");
							}
							else {
								if (exponent == 7) {
									_printString@@u8("  128 ");
								}
								else {
									if (exponent == 8) {
										_printString@@u8("  256 ");
									}
									else {
										if (exponent == 9) {
											_printString@@u8("  512 ");
										}
										else {
											if (exponent == 10) {
												_printString@@u8(" 1024 ");
											}
											else {
												if (exponent == 11) {
													_printString@@u8(" 2048 ");
												}
												else {
													_printString@@u8("  ?   ");
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

void _drawTileAt@i16@i16@u8(i16 row, i16 column, u8 exponent) {
	if (exponent == 0) {
		return;
	}
	_setCursor@i16@i16(row, column);
	_printString@@u8("+------+");
	_setCursor@i16@i16(row + 1, column);
	_printChar@u8(124);
	_printTile@u8(exponent);
	_printChar@u8(124);
	_setCursor@i16@i16(row + 2, column);
	_printString@@u8("+------+");
}

void _drawFrame() {
	if (false) {
		_printChar@u8(12);
	}
	_setCursor@i16@i16(1, 0);
	_printString@@u8("Arrows/WASD  R restart  Esc quit");
}

void _clearBoard() {
	i16 row;

	row = 0;
	for (; row < 15; row = row + 1) {
		_setCursor@i16@i16(row + 3, 1);
		_printString@@u8("                                   ");
	}
}

void _drawBoard() {
	u8 index;
	i16 row;
	u8 boardRow;
	i16 column;
	u8 boardColumn;

	_clearBoard();
	index = 0;
	row = 3;
	boardRow = 0;
	for (; boardRow < 4; boardRow = boardRow + 1) {
		column = 1;
		boardColumn = 0;
		for (; boardColumn < 4; boardColumn = boardColumn + 1) {
			_drawTileAt@i16@i16@u8(row, column, tiles[index as i64]);
			index = index + 1;
			column = column + 9;
		}
		row = row + 4;
	}
}

void _drawScore() {
	_setCursor@i16@i16(0, 0);
	_printString@@u8("2048  Score: ");
	_printUint@i32(score);
	_printString@@u8("          ");
}

void _drawStatus() {
	_setCursor@i16@i16(19, 0);
	_printString@@u8("                                      ");
	_setCursor@i16@i16(19, 0);
	if (gameState == 1) {
		_printString@@u8("2048! Press R to play again.");
	}
	else {
		if (gameState == 2) {
			_printString@@u8("No moves left. Press R to restart.");
		}
	}
}

void _newGame() {
	u8 index;

	index = 0;
	for (; index < 16; index = index + 1) {
		tiles[index as i64] = 0;
	}
	score = 0;
	_drawScore();
	gameState = 0;
	_spawnTile();
	_spawnTile();
	_drawBoard();
	_drawStatus();
	_setCursor@i16@i16(21, 0);
}

void _main() {
	i16 key;
	u8 direction;

	_initRandom@i32(7439742);
	_drawFrame();
	_newGame();
	while (true) {
		key = _getChar();
		if (key == 27) {
			break;
		}
		if ((key == 114) || (key == 82)) {
			_newGame();
			continue;
		}
		if (gameState != 0) {
			continue;
		}
		direction = 255;
		if (((key == -8117) || (key == 97)) || (key == 65)) {
			direction = 0;
		}
		else {
			if (((key == -8115) || (key == 100)) || (key == 68)) {
				direction = 1;
			}
			else {
				if (((key == -8120) || (key == 119)) || (key == 87)) {
					direction = 2;
				}
				else {
					if (((key == -8112) || (key == 115)) || (key == 83)) {
						direction = 3;
					}
					else {
						continue;
					}
				}
			}
		}
		if (!(_slide@u8(direction))) {
			continue;
		}
		_spawnTile();
		if ((gameState == 0) && (!(_canMove()))) {
			gameState = 2;
		}
		_drawBoard();
		_drawScore();
		if (gameState != 0) {
			_drawStatus();
		}
		_setCursor@i16@i16(21, 0);
	}
}
