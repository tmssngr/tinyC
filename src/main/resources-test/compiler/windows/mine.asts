void _main() {
	u8 col;
	u8 row;
	i16 bombsLeft;
	i16 chr;
	i16 index;
	u8 cell;
	i16 index;
	u8 cell;

	_initRandom@i32(7439742);
	_clearField();
	_initializeScreen();
	_setCursor@i16@i16(20, 0);
	col = 20;
	row = 10;
	bombsLeft = -1;
	while (true) {
		if (bombsLeft == 0) {
			_printString@@u8(" You've cleaned the field!");
			break;
		}
		_showCursor@u8@u8@bool(row, col, true);
		chr = _getChar();
		_showCursor@u8@u8@bool(row, col, false);
		if (chr == 27) {
			break;
		}
		if (chr == 13) {
			if (bombsLeft < 0) {
				bombsLeft = _initField@u8@u8(row, col);
			}
			index = _rowColumnToCell@u8@u8(row, col);
			cell = field[index as i64];
			if ((cell & 32) == 0) {
				field[index as i64] = cell | 32;
			}
			if ((cell & 128) != 0) {
				_printCellAt@u8@u8(row, col);
				_printString@@u8("boom! you've lost");
				break;
			}
			_maybeRevealAround@u8@u8(row, col);
		}
		else {
			if (chr == -8120) {
				if (row > 0) {
					row = row - 1;
				}
			}
			else {
				if (chr == -8112) {
					if (row < 19) {
						row = row + 1;
					}
				}
				else {
					if (chr == -8117) {
						if (col > 0) {
							col = col - 1;
						}
					}
					else {
						if (chr == -8115) {
							if (col < 39) {
								col = col + 1;
							}
						}
						else {
							if (chr == 32) {
								if (bombsLeft >= 0) {
									index = _rowColumnToCell@u8@u8(row, col);
									cell = field[index as i64];
									if ((cell & 32) == 0) {
										cell = cell ^ 64;
										if ((cell & 128) != 0) {
											if ((cell & 64) != 0) {
												bombsLeft = bombsLeft - 1;
											}
											else {
												bombsLeft = bombsLeft + 1;
											}
										}
										field[index as i64] = cell;
										_printCellAt@u8@u8@u8(cell, row, col);
									}
								}
							}
						}
					}
				}
			}
		}
	}
