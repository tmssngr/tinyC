	_printChar@u8(chr);
	_setCursor@i16@i16(row as i16, x + 1);
	if (show) {
		chr = 93;
	}
	_printChar@u8(chr);
}

i16 _abs@i16(i16 a) {
	if (a < 0) {
		return -a;
