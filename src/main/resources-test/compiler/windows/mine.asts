i16 _initField@u8@u8(u8 curr_r, u8 curr_c) {
	i16 r;
	i16 c;
	i16 bombCount;
	i16 bombs;
	i16 row;
	i16 column;

	r = curr_r as i16;
	c = curr_c as i16;
	bombCount = 0;
	bombs = 72;
	for (; bombs > 0; bombs = bombs - 1) {
		row = (_random16()) % 20;
		column = (_random16()) % 40;
		if (((_abs@i16(row - r)) > 1) || ((_abs@i16(column - c)) > 1)) {
			if (_setBomb@u8@u8(row as u8, column as u8)) {
				bombCount = bombCount + 1;
			}
		}
	}
	return bombCount;
}

bool _setBomb@u8@u8(u8 row, u8 column) {
	i16 index;
	u8 rowFrom;
	u8 rowTo;
	u8 colFrom;
	u8 colTo;
	u8 count;
	u8 r;
	u8 c;
	u8 cell;
	u8 count;

	index = _rowColumnToCell@u8@u8(row, column);
	if (field[index as i64] == 128) {
		return false;
	}
	field[index as i64] = 128;
	rowFrom = row;
	if (rowFrom > 0) {
		rowFrom = rowFrom - 1;
		index = index - 40;
	}
	rowTo = row + 1;
	if (rowTo >= 20) {
		rowTo = rowTo - 1;
	}
	colFrom = column;
	if (colFrom > 0) {
		colFrom = colFrom - 1;
		index = index - 1;
	}
	colTo = column + 1;
	if (colTo >= 40) {
		colTo = colTo - 1;
	}
	count = 0;
	r = rowFrom;
	for (; r <= rowTo; r = r + 1) {
		c = colFrom;
		for (; c <= colTo; c = c + 1, index = index + 1) {
			if ((r == row) && (c == column)) {
				continue;
			}
			cell = field[index as i64];
			if ((cell & 128) == 0) {
				count = cell & 15;
				count = count + 1;
				field[index as i64] = count;
			}
		}
		index = (((index - (colTo as i16)) + (colFrom as i16)) + 40) - 1;
	}
	return true;
}

void _maybeRevealAround@u8@u8(u8 row, u8 column) {
	i16 index;
	bool changed;
	i16 index;
	u8 r;
	u8 c;
	u8 cell;
	u8 r;
	u8 c;
	u8 cell;

	_printCellAt@u8@u8(row, column);
	index = _rowColumnToCell@u8@u8(row, column);
	if ((field[index as i64] & 15) != 0) {
		return;
	}
	changed = true;
	while (changed) {
		changed = false;
		index = 0;
		r = 0;
		for (; r < 20; r = r + 1) {
			c = 0;
			for (; c < 40; c = c + 1, index = index + 1) {
				cell = field[index as i64];
				if (((cell & 32) == 0) || ((cell & 128) != 0)) {
					continue;
				}
				if ((field[index as i64] & 15) != 0) {
					continue;
				}
				if (_revealNeighbors@u8@u8(r, c)) {
					changed = true;
