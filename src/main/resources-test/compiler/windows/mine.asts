	u8 colTo;
	i16 index;
	bool changed;
	u8 r;
	u8 c;
	u8 cell;

	rowFrom = row;
	if (rowFrom > 0) {
		rowFrom = rowFrom - 1;
	}
	rowTo = row + 1;
	if (rowTo >= 20) {
		rowTo = rowTo - 1;
	}
	colFrom = column;
	if (colFrom > 0) {
		colFrom = colFrom - 1;
	}
	colTo = column + 1;
	if (colTo >= 40) {
		colTo = colTo - 1;
	}
	index = _rowColumnToCell@u8@u8(rowFrom, colFrom);
	changed = false;
	r = rowFrom;
	for (; r <= rowTo; r = r + 1) {
		c = colFrom;
		for (; c <= colTo; c = c + 1, index = index + 1) {
			cell = field[index as i64];
			if ((cell & 32) != 0) {
				continue;
			}
			cell = cell | 32;
			field[index as i64] = cell;
			_printCellAt@u8@u8@u8(cell, r, c);
			changed = true;
		}
		index = (((index - (colTo as i16)) + (colFrom as i16)) + 40) - 1;
