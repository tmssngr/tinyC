void _initializeScreen() {
	_printField();
}

void _printField() {
	u8 row;
	u8 column;
	u8 cell;

	_setCursor@i16@i16(0, 0);
	row = 0;
	for (; row < 20; row = row + 1) {
		_setCursor@i16@i16(row as i16, 0);
		if (true) {
			_printChar@u8(124);
		}
		column = 0;
		for (; column < 40; column = column + 1) {
			if (true) {
				_printChar@u8(32);
			}
			cell = field[(_rowColumnToCell@u8@u8(row, column)) as i64];
			_printCell@u8@u8@u8(cell, row, column);
