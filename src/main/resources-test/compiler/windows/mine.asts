i32 _random() {
	i32 r;
	i32 b;
	i32 c;
	i32 d;
	i32 e;

	r = __random__;
	b = (r & 524287) * 48271;
	c = (r >> 15) * 48271;
	d = (c & 65535) << 15;
	e = ((c >> 16) + b) + d;
	__random__ = (e & 2147483647) + (e >> 31);
	return __random__;
}

i16 _random16() {
	return ((_random()) as i16) & 32767;
}

i16 _rowColumnToCell@u8@u8(u8 row, u8 column) {
