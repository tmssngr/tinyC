i32 __random__;
u8* tiles[16];
u8* moveTiles[16];
u8* moveTargets[16];
i32 score;
u8 gameState;

void printStringLength@@u8@i64(u8* str, i64 length) asm {
}

i16 getChar() asm {
}

void setCursor@i16@i16(i16 row, i16 column) asm {
}

void printString@@u8(u8* str) {
	i64 length;

	length = strlen@@u8(str);
	printStringLength@@u8@i64(str, length);
}

void printChar@u8(u8 chr) {
	printStringLength@@u8@u8(&chr, 1);
}

void printUint@i32(i32 number) {
	printUint@i64(number as i64);
}

void printUint@i64(i64 number) {
	u8* buffer[20];
	u8 pos;
	i64 remainder;
	u8 digit;

	pos = 20;
	while (true) {
		pos = pos - 1;
		remainder = number % 10;
		number = number / 10;
		digit = (remainder as u8) + 48;
		buffer[pos as i64] = digit;
		if (number == 0) {
			break;
		}
	}
	printStringLength@@u8@u8(&buffer[pos as i64], 20 - pos);
}

i64 strlen@@u8(u8* str) {
	i64 length;

	length = 0;
	for (; (*str) != 0; str = str + 1) {
		length = length + 1;
	}
	return length;
}

void printStringLength@@u8@u8(u8* str, u8 length) {
	printStringLength@@u8@i64(str, length as i64);
}

void initRandom@i32(i32 salt) {
	__random__ = salt;
}

i32 random() {
	i32 r;
	i32 b;
	i32 c;
	i32 d;
	i32 e;

	r = __random__;
	b = (r & 524287) * 48271;
	c = (r >> 15) * 48271;
	d = (c & 65535) << 15;
	e = ((c >> 16) + b) + d;
	__random__ = (e & 2147483647) + (e >> 31);
	return __random__;
}

i16 random16() {
	return ((random()) as i16) & 32767;
}

i16 tileValue@u8(u8 exponent) {
	i16 value;
	u8 index;

	value = 1;
	index = 0;
	for (; index < exponent; index = index + 1) {
		value = value << 1;
	}
	return value;
}

u8 spawnTile() {
	u8 emptyCount;
	u8 index;
	u8 chosen;
	u8 index;
	u8 tile;

	emptyCount = 0;
	index = 0;
	for (; index < 16; index = index + 1) {
		if (tiles[index as i64] == 0) {
			emptyCount = emptyCount + 1;
		}
	}
	if (emptyCount == 0) {
		return 255;
	}
	chosen = ((random16()) % (emptyCount as i16)) as u8;
	index = 0;
	for (; index < 16; index = index + 1) {
		if (tiles[index as i64] != 0) {
			continue;
		}
		if (chosen == 0) {
			tile = 1;
			if (((random16()) % 10) == 0) {
				tile = 2;
			}
			tiles[index as i64] = tile;
			return index;
		}
		chosen = chosen - 1;
	}
	return 255;
}

bool slideLine@u8@u8(u8 first, u8 step) {
	u8 source;
	u8 target;
	bool previousMerged;
	bool moved;
	u8 position;
	u8* sourceTile;
	u8 tile;
	bool merged;
	u8 previous;
	u8* previousTile;
	u8 nextTile;
	i32 mergedScore;

	source = first;
	target = first;
	previousMerged = false;
	moved = false;
	position = 0;
	for (; position < 4; position = position + 1) {
		sourceTile = &tiles[source as i64];
		tile = *sourceTile;
		if (tile != 0) {
			*sourceTile = 0;
			merged = false;
			if ((target != first) && (!previousMerged)) {
				previous = target - step;
				previousTile = &tiles[previous as i64];
				if ((*previousTile) == tile) {
					moveTargets[source as i64] = previous | 128;
					nextTile = tile + 1;
					*previousTile = nextTile;
					mergedScore = (tileValue@u8(nextTile)) as i32;
					score = score + mergedScore;
					if (nextTile == 11) {
						gameState = 1;
					}
					merged = true;
					previousMerged = true;
					moved = true;
				}
			}
			if (!merged) {
				moveTargets[source as i64] = target;
				tiles[target as i64] = tile;
				if (target != source) {
					moved = true;
				}
				target = target + step;
				previousMerged = false;
			}
		}
		source = source + step;
	}
	return moved;
}

bool slide@u8(u8 direction) {
	u8 index;
	bool moved;
	u8 line;
	u8 first;
	u8 step;

	index = 0;
	for (; index < 16; index = index + 1) {
		moveTiles[index as i64] = tiles[index as i64];
		moveTargets[index as i64] = index;
	}
	moved = false;
	line = 0;
	for (; line < 4; line = line + 1) {
		first = line << 2;
		step = 1;
		if (direction == 1) {
			first = first + 3;
			step = 255;
		}
		else {
			if (direction == 2) {
				first = line;
				step = 4;
			}
			else {
				if (direction == 3) {
					first = line + 12;
					step = 252;
				}
			}
		}
		if (slideLine@u8@u8(first, step)) {
			moved = true;
		}
	}
	return moved;
}

bool canMove() {
	u8 index;
	u8 tile;

	index = 0;
	for (; index < 16; index = index + 1) {
		tile = tiles[index as i64];
		if (tile == 0) {
			return true;
		}
		if (((index & 3) != 3) && (tiles[(index + 1) as i64] == tile)) {
			return true;
		}
		if ((index < 12) && (tiles[(index + 4) as i64] == tile)) {
			return true;
		}
	}
	return false;
}

void printTile@u8(u8 exponent) {
	if (exponent == 0) {
		printString@@u8("      ");
	}
	else {
		if (exponent == 1) {
			printString@@u8("   2  ");
		}
		else {
			if (exponent == 2) {
				printString@@u8("   4  ");
			}
			else {
				if (exponent == 3) {
					printString@@u8("   8  ");
				}
				else {
					if (exponent == 4) {
						printString@@u8("  16  ");
					}
					else {
						if (exponent == 5) {
							printString@@u8("  32  ");
						}
						else {
							if (exponent == 6) {
								printString@@u8("  64  ");
							}
							else {
								if (exponent == 7) {
									printString@@u8("  128 ");
								}
								else {
									if (exponent == 8) {
										printString@@u8("  256 ");
									}
									else {
										if (exponent == 9) {
											printString@@u8("  512 ");
										}
										else {
											if (exponent == 10) {
												printString@@u8(" 1024 ");
											}
											else {
												if (exponent == 11) {
													printString@@u8(" 2048 ");
												}
												else {
													printString@@u8("  ?   ");
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

void drawTileAt@i16@i16@u8(i16 row, i16 column, u8 exponent) {
	if (exponent == 0) {
		return;
	}
	setCursor@i16@i16(row, column);
	printString@@u8("+------+");
	setCursor@i16@i16(row + 1, column);
	printChar@u8(124);
	printTile@u8(exponent);
	printChar@u8(124);
	setCursor@i16@i16(row + 2, column);
	printString@@u8("+------+");
}

u8 tileRow@u8(u8 index) {
	return 3 + (index & 12);
}

u8 tileColumn@u8(u8 index) {
	u8 column;

	column = index & 3;
	return (1 + (column << 3)) + column;
}

void clearTileTrail@u8@u8@u8@u8(u8 row, u8 column, u8 direction, u8 distance) {
	u8 width;
	u8 height;
	u8* spaces;
	u8 line;

	width = 8;
	height = 3;
	if (direction < 2) {
		if (distance < width) {
			width = distance;
		}
		if (direction == 0) {
			column = column + (8 - width);
		}
	}
	else {
		if (distance < height) {
			height = distance;
		}
		if (direction == 2) {
			row = row + (3 - height);
		}
	}
	spaces = "        ";
	spaces = spaces + ((8 - width) as i64);
	line = 0;
	for (; line < height; line = line + 1) {
		setCursor@i16@i16(row as i16, column as i16);
		printString@@u8(spaces);
		row = row + 1;
	}
}

bool drawMoveFrame@u8@u8@u8@bool(u8 direction, u8 previous, u8 travel, bool erase) {
	bool horizontal;
	bool forward;
	bool pending;
	u8 count;
	u8 index;
	u8 exponent;
	u8 target;
	u8 distance;
	u8 oldOffset;
	u8 offset;
	u8 displacement;
	u8 row;
	u8 column;

	horizontal = direction < 2;
	forward = (direction & 1) != 0;
	pending = false;
	count = 0;
	for (; count < 16; count = count + 1) {
		index = count;
		if (!forward) {
			index = (16 - 1) - count;
		}
		exponent = moveTiles[index as i64];
		if (exponent == 0) {
			continue;
		}
		target = moveTargets[index as i64] & 15;
		distance = index - target;
		if (forward) {
			distance = target - index;
		}
		if (horizontal) {
			distance = distance + (distance << 3);
		}
		oldOffset = previous;
		if (oldOffset > distance) {
			oldOffset = distance;
		}
		offset = travel;
		if (offset >= distance) {
			offset = distance;
		}
		else {
			pending = true;
		}
		if ((oldOffset == offset) && (erase || (exponent == tiles[target as i64]))) {
			continue;
		}
		displacement = offset;
		if (erase) {
			displacement = oldOffset;
		}
		if (!forward) {
			displacement = 0 - displacement;
		}
		row = 3 + (index & 12);
		column = index & 3;
		column = column + (1 + (column << 3));
		if (horizontal) {
			column = column + displacement;
		}
		else {
			row = row + displacement;
		}
		if (erase) {
			clearTileTrail@u8@u8@u8@u8(row, column, direction, offset - oldOffset);
		}
		else {
			drawTileAt@i16@i16@u8(row as i16, column as i16, exponent);
			if (offset == distance) {
				if ((moveTargets[index as i64] & 128) != 0) {
					moveTargets[target as i64] = moveTargets[target as i64] | 64;
					moveTiles[index as i64] = 0;
				}
				else {
					if ((moveTargets[target as i64] & 64) != 0) {
						drawTileAt@i16@i16@u8((tileRow@u8(target)) as i16, (tileColumn@u8(target)) as i16, tiles[target as i64]);
						moveTiles[index as i64] = 0;
					}
				}
			}
		}
	}
	return pending;
}

void animateMove@u8(u8 direction) {
	u8 travel;
	u8 speed;
	bool pending;
	u8 previous;
	u8 index;
	u8 target;

	travel = 0;
	speed = 1;
	pending = true;
	while (pending) {
		previous = travel;
		travel = travel + speed;
		speed = speed + 1;
		drawMoveFrame@u8@u8@u8@bool(direction, previous, travel, true);
		pending = drawMoveFrame@u8@u8@u8@bool(direction, previous, travel, false);
		waitFrame();
	}
	index = 0;
	for (; index < 16; index = index + 1) {
		target = moveTargets[index as i64] & 15;
		if ((moveTiles[index as i64] != 0) && (moveTiles[index as i64] != tiles[target as i64])) {
			setCursor@i16@i16(((tileRow@u8(target)) as i16) + 1, ((tileColumn@u8(target)) as i16) + 1);
			printTile@u8(tiles[target as i64]);
		}
	}
}

void waitFrame() asm {
}

void drawFrame() {
	if (false) {
		printChar@u8(12);
	}
	setCursor@i16@i16(1, 0);
	printString@@u8("Arrows/WASD  R restart  Esc quit");
}

void clearBoard() {
	i16 row;

	row = 0;
	for (; row < 15; row = row + 1) {
		setCursor@i16@i16(row + 3, 1 as i16);
		printString@@u8("                                   ");
	}
}

void drawBoard() {
	u8 index;
	i16 row;
	u8 boardRow;
	i16 column;
	u8 boardColumn;

	clearBoard();
	index = 0;
	row = 3;
	boardRow = 0;
	for (; boardRow < 4; boardRow = boardRow + 1) {
		column = 1;
		boardColumn = 0;
		for (; boardColumn < 4; boardColumn = boardColumn + 1) {
			drawTileAt@i16@i16@u8(row, column, tiles[index as i64]);
			index = index + 1;
			column = column + 9;
		}
		row = row + 4;
	}
}

void drawScore() {
	setCursor@i16@i16(0, 0);
	printString@@u8("2048  Score: ");
	printUint@i32(score);
	printString@@u8("          ");
}

void drawStatus() {
	setCursor@i16@i16(((3 + 15) + 1) as i16, 0);
	printString@@u8("                                      ");
	setCursor@i16@i16(((3 + 15) + 1) as i16, 0);
	if (gameState == 1) {
		printString@@u8("2048! Press R to play again.");
	}
	else {
		if (gameState == 2) {
			printString@@u8("No moves left. Press R to restart.");
		}
	}
}

void newGame() {
	u8 index;

	index = 0;
	for (; index < 16; index = index + 1) {
		tiles[index as i64] = 0;
	}
	score = 0;
	drawScore();
	gameState = 0;
	spawnTile();
	spawnTile();
	drawBoard();
	drawStatus();
	setCursor@i16@i16(21, 0);
}

void main() {
	i16 key;
	u8 direction;
	u8 spawned;

	initRandom@i32(7439742);
	drawFrame();
	newGame();
	while (true) {
		key = getChar();
		if (key == 27) {
			break;
		}
		if ((key == 114) || (key == 82)) {
			newGame();
			continue;
		}
		if (gameState != 0) {
			continue;
		}
		direction = 255;
		if (((key == (57419 as i16)) || (key == 97)) || (key == 65)) {
			direction = 0;
		}
		else {
			if (((key == (57421 as i16)) || (key == 100)) || (key == 68)) {
				direction = 1;
			}
			else {
				if (((key == (57416 as i16)) || (key == 119)) || (key == 87)) {
					direction = 2;
				}
				else {
					if (((key == (57424 as i16)) || (key == 115)) || (key == 83)) {
						direction = 3;
					}
					else {
						continue;
					}
				}
			}
		}
		if (!(slide@u8(direction))) {
			continue;
		}
		animateMove@u8(direction);
		spawned = spawnTile();
		if (spawned != 255) {
			drawTileAt@i16@i16@u8((tileRow@u8(spawned)) as i16, (tileColumn@u8(spawned)) as i16, tiles[spawned as i64]);
		}
		if ((gameState == 0) && (!(canMove()))) {
			gameState = 2;
		}
		drawScore();
		if (gameState != 0) {
			drawStatus();
		}
		setCursor@i16@i16(21, 0);
	}
}
