i32 __random__;
u8* tiles[16];
u8* moveTiles[16];
u8* moveTargets[16];
u8* boardFrame[525];
u8* displayedFrame[525];
i32 score;
u8 gameState;

void printStringLength@@u8@i64(u8* str, i64 length) asm {
}

i16 getChar() asm {
}

void setCursor@i16@i16(i16 row, i16 column) asm {
}

void printString@@u8(u8* str) {
	i64 length;

	length = strlen@@u8(str);
	printStringLength@@u8@i64(str, length);
}

void printChar@u8(u8 chr) {
	printStringLength@@u8@u8(&chr, 1);
}

void printUint@i32(i32 number) {
	printUint@i64(number as i64);
}

void printUint@i64(i64 number) {
	u8* buffer[20];
	u8 pos;
	i64 remainder;
	u8 digit;

	pos = 20;
	while (true) {
		pos = pos - 1;
		remainder = number % 10;
		number = number / 10;
		digit = (remainder as u8) + 48;
		buffer[pos as i64] = digit;
		if (number == 0) {
			break;
		}
	}
	printStringLength@@u8@u8(&buffer[pos as i64], 20 - pos);
}

i64 strlen@@u8(u8* str) {
	i64 length;

	length = 0;
	for (; (*str) != 0; str = str + 1) {
		length = length + 1;
	}
	return length;
}

void printStringLength@@u8@u8(u8* str, u8 length) {
	printStringLength@@u8@i64(str, length as i64);
}

void initRandom@i32(i32 salt) {
	__random__ = salt;
}

i32 random() {
	i32 r;
	i32 b;
	i32 c;
	i32 d;
	i32 e;

	r = __random__;
	b = (r & 524287) * 48271;
	c = (r >> 15) * 48271;
	d = (c & 65535) << 15;
	e = ((c >> 16) + b) + d;
	__random__ = (e & 2147483647) + (e >> 31);
	return __random__;
}

i16 random16() {
	return ((random()) as i16) & 32767;
}

i32 tileValue@u8(u8 exponent) {
	i32 value;
	u8 index;

	value = 1;
	index = 0;
	for (; index < exponent; index = index + 1) {
		value = value << 1;
	}
	return value;
}

u8 spawnTile() {
	u8 emptyCount;
	u8 index;
	u8 chosen;
	u8 index;
	u8 tile;

	emptyCount = 0;
	index = 0;
	for (; index < 16; index = index + 1) {
		if (tiles[index as i64] == 0) {
			emptyCount = emptyCount + 1;
		}
	}
	if (emptyCount == 0) {
		return 255;
	}
	chosen = ((random16()) % (emptyCount as i16)) as u8;
	index = 0;
	for (; index < 16; index = index + 1) {
		if (tiles[index as i64] != 0) {
			continue;
		}
		if (chosen == 0) {
			tile = 1;
			if (((random16()) % 10) == 0) {
				tile = 2;
			}
			tiles[index as i64] = tile;
			return index;
		}
		chosen = chosen - 1;
	}
	return 255;
}

bool slideLine@u8@u8(u8 first, u8 step) {
	u8 source;
	u8 target;
	bool previousMerged;
	bool moved;
	u8 position;
	u8* sourceTile;
	u8 tile;
	bool merged;
	u8 previous;
	u8* previousTile;
	u8 nextTile;

	source = first;
	target = first;
	previousMerged = false;
	moved = false;
	position = 0;
	for (; position < 4; position = position + 1) {
		sourceTile = &tiles[source as i64];
		tile = *sourceTile;
		if (tile != 0) {
			*sourceTile = 0;
			merged = false;
			if ((target != first) && (!previousMerged)) {
				previous = target - step;
				previousTile = &tiles[previous as i64];
				if ((*previousTile) == tile) {
					moveTargets[source as i64] = previous;
					nextTile = tile + 1;
					*previousTile = nextTile;
					score = score + (tileValue@u8(nextTile));
					if (nextTile == 11) {
						gameState = 1;
					}
					merged = true;
					previousMerged = true;
					moved = true;
				}
			}
			if (!merged) {
				moveTargets[source as i64] = target;
				tiles[target as i64] = tile;
				if (target != source) {
					moved = true;
				}
				target = target + step;
				previousMerged = false;
			}
		}
		source = source + step;
	}
	return moved;
}

bool slide@u8(u8 direction) {
	u8 index;
	bool moved;
	u8 line;
	u8 first;
	u8 step;

	index = 0;
	for (; index < 16; index = index + 1) {
		moveTiles[index as i64] = tiles[index as i64];
		moveTargets[index as i64] = index;
	}
	moved = false;
	line = 0;
	for (; line < 4; line = line + 1) {
		first = line << 2;
		step = 1;
		if (direction == 1) {
			first = first + 3;
			step = 255;
		}
		else {
			if (direction == 2) {
				first = line;
				step = 4;
			}
			else {
				if (direction == 3) {
					first = line + 12;
					step = 252;
				}
			}
		}
		if (slideLine@u8@u8(first, step)) {
			moved = true;
		}
	}
	return moved;
}

bool canMove() {
	u8 index;
	u8 tile;

	index = 0;
	for (; index < 16; index = index + 1) {
		tile = tiles[index as i64];
		if (tile == 0) {
			return true;
		}
		if (((index & 3) != 3) && (tiles[(index + 1) as i64] == tile)) {
			return true;
		}
		if ((index < 12) && (tiles[(index + 4) as i64] == tile)) {
			return true;
		}
	}
	return false;
}

u8* tileText@u8(u8 exponent) {
	if (exponent == 0) {
		return "      ";
	}
	else {
		if (exponent == 1) {
			return "   2  ";
		}
		else {
			if (exponent == 2) {
				return "   4  ";
			}
			else {
				if (exponent == 3) {
					return "   8  ";
				}
				else {
					if (exponent == 4) {
						return "  16  ";
					}
					else {
						if (exponent == 5) {
							return "  32  ";
						}
						else {
							if (exponent == 6) {
								return "  64  ";
							}
							else {
								if (exponent == 7) {
									return "  128 ";
								}
								else {
									if (exponent == 8) {
										return "  256 ";
									}
									else {
										if (exponent == 9) {
											return "  512 ";
										}
										else {
											if (exponent == 10) {
												return " 1024 ";
											}
											else {
												if (exponent == 11) {
													return " 2048 ";
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
	return "  ?   ";
}

void drawTileRow@i16@@u8(i16 offset, u8* text) {
	u8 index;

	index = 0;
	for (; index < 8; index = index + 1) {
		boardFrame[offset as i64] = text[index as i64];
		offset = offset + 1;
	}
}

void drawTileAt@i16@i16@u8(i16 row, i16 column, u8 exponent) {
	i16 offset;
	u8* text;
	u8 index;

	if (exponent == 0) {
		return;
	}
	offset = (((row - 3) * 35) + column) - 1;
	drawTileRow@i16@@u8(offset, "+------+");
	offset = offset + 35;
	boardFrame[offset as i64] = 124;
	boardFrame[((offset + 8) - 1) as i64] = 124;
	text = tileText@u8(exponent);
	index = 0;
	for (; index < (8 - 2); index = index + 1) {
		boardFrame[((offset + (index as i16)) + 1) as i64] = text[index as i64];
	}
	drawTileRow@i16@@u8(offset + 35, "+------+");
}

void drawFrame() {
	if (false) {
		printChar@u8(12);
	}
	setCursor@i16@i16(1, 0);
	printString@@u8("Arrows/WASD  R restart  Esc quit");
}

void clearBoard() {
	i16 offset;

	offset = 0;
	for (; offset < 525; offset = offset + 1) {
		boardFrame[offset as i64] = 32;
	}
}

void presentBoard() {
	i16 offset;
	i16 row;
	bool printing;
	i16 column;
	u8 character;

	offset = 0;
	row = 0;
	for (; row < 15; row = row + 1) {
		printing = false;
		column = 0;
		for (; column < 35; column = column + 1) {
			character = boardFrame[offset as i64];
			if (character != displayedFrame[offset as i64]) {
				if (!printing) {
					setCursor@i16@i16(row + 3, column + 1);
					printing = true;
				}
				printChar@u8(character);
				displayedFrame[offset as i64] = character;
			}
			else {
				printing = false;
			}
			offset = offset + 1;
		}
	}
	setCursor@i16@i16(21, 0);
}

void drawBoard() {
	u8 index;
	i16 row;
	u8 boardRow;
	i16 column;
	u8 boardColumn;

	clearBoard();
	index = 0;
	row = 3;
	boardRow = 0;
	for (; boardRow < 4; boardRow = boardRow + 1) {
		column = 1;
		boardColumn = 0;
		for (; boardColumn < 4; boardColumn = boardColumn + 1) {
			drawTileAt@i16@i16@u8(row, column, tiles[index as i64]);
			index = index + 1;
			column = column + 9;
		}
		row = row + 4;
	}
	presentBoard();
}

void waitFrame() asm {
}

void animateSlide() {
	i16 frame;
	i16 remaining;
	u8 source;
	u8 exponent;
	u8 target;
	i16 sourceRow;
	i16 sourceColumn;
	i16 targetRow;
	i16 targetColumn;
	i16 row;
	i16 column;

	frame = 1;
	for (; frame <= 8; frame = frame + 1) {
		remaining = 8;
		remaining = remaining - frame;
		clearBoard();
		source = 0;
		for (; source < 16; source = source + 1) {
			exponent = moveTiles[source as i64];
			if (exponent == 0) {
				continue;
			}
			target = moveTargets[source as i64];
			sourceRow = ((source >> 2) as i16) * 4;
			sourceColumn = ((source & 3) as i16) * 9;
			targetRow = ((target >> 2) as i16) * 4;
			targetColumn = ((target & 3) as i16) * 9;
			row = ((sourceRow * remaining) + (targetRow * frame)) / 8;
			column = ((sourceColumn * remaining) + (targetColumn * frame)) / 8;
			drawTileAt@i16@i16@u8(row + 3, column + 1, exponent);
		}
		presentBoard();
		waitFrame();
	}
}

void drawScore() {
	setCursor@i16@i16(0, 0);
	printString@@u8("2048  Score: ");
	printUint@i32(score);
	printString@@u8("          ");
}

void drawStatus() {
	setCursor@i16@i16(((3 + 15) + 1) as i16, 0);
	printString@@u8("                                      ");
	setCursor@i16@i16(((3 + 15) + 1) as i16, 0);
	if (gameState == 1) {
		printString@@u8("2048! Press R to play again.");
	}
	else {
		if (gameState == 2) {
			printString@@u8("No moves left. Press R to restart.");
		}
	}
}

u8 newGame() {
	u8 index;
	u8 spawnedTileIndex;

	index = 0;
	for (; index < 16; index = index + 1) {
		tiles[index as i64] = 0;
	}
	score = 0;
	gameState = 0;
	spawnTile();
	spawnedTileIndex = spawnTile();
	drawBoard();
	drawScore();
	drawStatus();
	setCursor@i16@i16(21, 0);
	return spawnedTileIndex;
}

void main() {
	u8 spawnedTileIndex;
	i16 row;
	i16 column;
	i16 key;
	u8 direction;
	u8 newTileIndex;

	initRandom@i32(7439742);
	drawFrame();
	spawnedTileIndex = newGame();
	while (true) {
		row = (((spawnedTileIndex >> 2) as i16) * 4) + ((3 + (3 / 2)) as i16);
		column = (((spawnedTileIndex & 3) as i16) * 9) + ((1 + (8 / 2)) as i16);
		setCursor@i16@i16(row, column);
		key = getChar();
		if (key == 27) {
			break;
		}
		if ((key == 114) || (key == 82)) {
			spawnedTileIndex = newGame();
			continue;
		}
		if (gameState != 0) {
			continue;
		}
		direction = 255;
		if (((key == (57419 as i16)) || (key == 97)) || (key == 65)) {
			direction = 0;
		}
		else {
			if (((key == (57421 as i16)) || (key == 100)) || (key == 68)) {
				direction = 1;
			}
			else {
				if (((key == (57416 as i16)) || (key == 119)) || (key == 87)) {
					direction = 2;
				}
				else {
					if (((key == (57424 as i16)) || (key == 115)) || (key == 83)) {
						direction = 3;
					}
					else {
						continue;
					}
				}
			}
		}
		if (!(slide@u8(direction))) {
			continue;
		}
		animateSlide();
		newTileIndex = spawnTile();
		if (newTileIndex != 255) {
			spawnedTileIndex = newTileIndex;
		}
		if ((gameState == 0) && (!(canMove()))) {
			gameState = 2;
		}
		drawBoard();
		drawScore();
		if (gameState != 0) {
			drawStatus();
		}
	}
	setCursor@i16@i16(21, 0);
}
