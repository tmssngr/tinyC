@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	; 7 pc
	move chr, chr{r1}
	addrof t.1{r1}, chr
	const t.2{r2}, 1
	call printStringLength@@u8@u8[t.1{r1}, t.2{r2}]

@printUint@u8:
 Local variables
	arg 0: number (u8/1)
	; 2 pc
	cast t.1{r1}(i64), number{r1}(u8)
	call printUint@i64[t.1{r1}]

@printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	; 23 pc
	const pos{r6}, 20
	; 25:2 while true
@while_1:
	const t.5{r7}, 1
	sub pos{r6}, pos{r6}, t.5{r7}
	const t.6{r7}, 10
	move remainder{r3}, number{r1}
	move remainder{r0}, remainder{r3}
	mod remainder{r2}, remainder{r0}, t.6{r7}
	move remainder{r3}, remainder{r2}
	const t.7{r7}, 10
	move number{r0}, number{r1}
	div number{r0}, number{r0}, t.7{r7}
	move number{r1}, number{r0}
	cast t.8{r7}(u8), remainder{r3}(i64)
	const t.9{r0}, 48
	add digit{r7}, digit{r7}, t.9{r0}
	cast t.11{r0}(i64), pos{r6}(u8)
	addrof t.10{r3}, [buffer]
	add t.10{r3}, t.10{r3}, t.11{r0}
	store [t.10{r3}], digit{r7}
	; 31:3 if number == 0
	const t.13{r7}, 0
	equals t.12{r7}, number{r1}, t.13{r7}
	branch t.12{r7}, false, @while_1, @while_1_break
	cast t.15{r7}(i64), pos{r6}(u8)
	addrof t.14{r1}, [buffer]
	add t.14{r1}, t.14{r1}, t.15{r7}
	const t.17{r7}, 20
	move t.16{r2}, t.17{r7}
	sub t.16{r2}, t.16{r2}, pos{r6}
	call printStringLength@@u8@u8[t.14{r1}, t.16{r2}]

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	; 2 pc
	cast t.2{r2}(i64), length{r2}(u8)
	call printStringLength@@u8@i64[str{r1}, t.2{r2}]

@unusedArgs@u8@bool@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (bool/1)
	arg 2: c (u8/1)
	arg 3: d (u8/1)
	; 1 pc
	; 9:10 return (i64)
	cast t.4{r0}(i64), c{r3}(u8)

@main:
	; 37 pc
	; begin initialize global variables
	const tmp.zero{r6}, 48
	const tmp.one{r7}, 49
	const tmp.two{r0}, 50
	const tmp.threeFour{r1}, 34
	; end initialize global variables
	const t.3{r5}, 1
	const t.4{r2}, 1
	const t.5{r3}, 2
	const t.6{r4}, 3
	move zero, tmp.zero{r6}
	move one, tmp.one{r7}
	move two, tmp.two{r0}
	move threeFour, tmp.threeFour{r1}
	move t.3{r1}, t.3{r5}
	call _ = unusedArgs@u8@bool@u8@u8[t.3{r1}, t.4{r2}, t.5{r3}, t.6{r4}] -> i64
	move tmp.zero{r6}, zero
	move tmp.zero{r1}, tmp.zero{r6}
	call printChar@u8[tmp.zero{r1}]
	addrof onePtr{r6}, one
	load t.7{r1}, [onePtr{r6}]
	call printChar@u8[t.7{r1}]
	addrof twoPtr{r6}, two
	const t.10{r7}, 0
	add t.9{r6}, t.9{r6}, t.10{r7}
	load t.8{r1}, [t.9{r6}]
	call printChar@u8[t.8{r1}]
	move tmp.threeFour{r1}, threeFour
	call printUint@u8[tmp.threeFour{r1}]
	const t.11{r1}, 10
	call printChar@u8[t.11{r1}]

@printStringLength@@u8@i64:
	mov     rdi, rsp
	
	mov     r8, rdx
	mov     rdx, rcx
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

Global variables
	0: zero (u8/1)
	1: one (u8/1)
	2: two (u8/1)
	3: threeFour (u8/1)

