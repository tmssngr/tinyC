@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	; 7 pc
	move chr, chr{r1}
	addrof t.1{r1}, chr
	const arg.0.1{r2}, 1
	call printStringLength@@u8@u8[t.1{r1}, arg.0.1{r2}]

@printUint@u8:
 Local variables
	arg 0: number (u8/1)
	; 2 pc
	cast t.1{r1}(i64), number{r1}(u8)
	call printUint@i64[t.1{r1}]

@printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	; 24 pc
	move number{r6}, number{r1}
	const pos{r7}, 20
	; 28:2 while true
@while_1:
	sub pos{r7}, pos{r7}, 1
	move remainder{r3}, number{r6}
	move remainder{r0}, remainder{r3}
	mod remainder{r2}, remainder{r0}, 10
	move remainder{r3}, remainder{r2}
	move number{r0}, number{r6}
	div number{r0}, number{r0}, 10
	move number{r6}, number{r0}
	cast t.5{r0}(u8), remainder{r3}(i64)
	add digit{r0}, digit{r0}, 48
	cast t.7{r3}(i64), pos{r7}(u8)
	addrof t.6{r4}, [buffer]
	add t.6{r4}, t.6{r4}, t.7{r3}
	store [t.6{r4}], digit{r0}
	; 34:3 if number == 0
	equals t.8{r0}, number{r6}, 0
	branch t.8{r0}, false, @while_1, @while_1_break
	cast t.10{r6}(i64), pos{r7}(u8)
	addrof t.9{r1}, [buffer]
	add t.9{r1}, t.9{r1}, t.10{r6}
	const t.12{r6}, 20
	move t.11{r2}, t.12{r6}
	sub t.11{r2}, t.11{r2}, pos{r7}
	call printStringLength@@u8@u8[t.9{r1}, t.11{r2}]

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	; 2 pc
	cast t.2{r2}(i64), length{r2}(u8)
	call printStringLength@@u8@i64[str{r1}, t.2{r2}]

@unusedArgs@u8@bool@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (bool/1)
	arg 2: c (u8/1)
	arg 3: d (u8/1)
	; 1 pc
	; 9:10 return (i64)
	cast t.4{r0}(i64), c{r3}(u8)

@main:
	; 36 pc
	; begin initialize global variables
	const tmp.zero{r6}, 48
	const tmp.one{r7}, 49
	const tmp.two{r0}, 50
	const tmp.threeFour{r1}, 34
	; end initialize global variables
	const t.3{r2}, 1
	move zero, tmp.zero{r6}
	move one, tmp.one{r7}
	move two, tmp.two{r0}
	move threeFour, tmp.threeFour{r1}
	const arg.0.0{r1}, 1
	const arg.0.2{r3}, 2
	const arg.0.3{r4}, 3
	call _ = unusedArgs@u8@bool@u8@u8[arg.0.0{r1}, t.3{r2}, arg.0.2{r3}, arg.0.3{r4}] -> i64
	move tmp.zero{r6}, zero
	move tmp.zero{r1}, tmp.zero{r6}
	call printChar@u8[tmp.zero{r1}]
	addrof onePtr{r6}, one
	load t.4{r1}, [onePtr{r6}]
	call printChar@u8[t.4{r1}]
	addrof twoPtr{r6}, two
	const t.7{r7}, 0
	add t.6{r6}, t.6{r6}, t.7{r7}
	load t.5{r1}, [t.6{r6}]
	call printChar@u8[t.5{r1}]
	move tmp.threeFour{r1}, threeFour
	call printUint@u8[tmp.threeFour{r1}]
	const arg.5.0{r1}, 10
	call printChar@u8[arg.5.0{r1}]

@printStringLength@@u8@i64:
	mov     rdi, rsp
	
	mov     r8, rdx
	mov     rdx, rcx
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

Global variables
	0: zero (u8/1)
	1: one (u8/1)
	2: two (u8/1)
	3: threeFour (u8/1)

