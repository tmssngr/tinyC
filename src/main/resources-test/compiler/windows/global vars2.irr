printString@@u8:
 Local variables
	arg 0: str (u8*/8)
	var 1: length (i64/8)
	; 10 pc
	call length = strlen@@u8[str] -> i64
	call printStringLength@@u8@i64[str, length]

strlen@@u8:
 Local variables
	arg 0: str (u8*/8)
	var 1: length (i64/8)
	var 2: t.2 (u8/1)
	; 25 pc
	const length, 0
	; 64:2 for *str != 0
	jump for_1
for_1_body:
	add length, 1
	add str, 1
for_1:
	load t.2, [str]
	branch t.2 notequals 0: for_1_body, for_1_break
	; 67:9 return length
	ret length

next:
 Local variables
	var 0: copy (u8/1)
	var 1: a.1 (u8*/8)
	var 2: t.2 (u8/1)
	var 3: a.3 (u8*/8)
	var 4: t.4 (u8/1)
	var 5: a.5 (u8*/8)
	; 46 pc
	addrof a.1, global
	load copy, [a.1]
	addrof a.3, global
	load t.4, [a.3]
	move t.2, t.4
	add t.2, 1
	addrof a.5, global
	store [a.5], t.2
	; 8:9 return copy
	ret copy

main:
 Local variables
	var 0: n (u8/1)
	var 1: t.1 (u8/1)
	var 2: a.2 (u8*/8)
	var 3: t.3 (u8*/8)
	var 4: t.4 (u8*/8)
	; 35 pc
	; begin initialize global variables
	const t.1, 0
	addrof a.2, global
	store [a.2], t.1
	; end initialize global variables
	; 12:2 while true
	jump while_2
if_3_end:
	branch n gteq 2: while_2, if_4_then
	const t.4, [string-1]
	call printString@@u8[t.4]
while_2:
	const t.3, [string-0]
	call printString@@u8[t.3]
	call n = next[] -> u8
	; 15:3 if n == 3
	branch n notequals 3: if_3_end, main_ret

printStringLength@@u8@i64:
	mov     rdi, rsp
	
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	mov     rdx, [rdi+18h]
	mov     r8, [rdi+10h]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

Global variables
	0: global (u8/1)

String literals
	string lit 0 "loop\n\0"
	string lit 1 "<2\n\0"
