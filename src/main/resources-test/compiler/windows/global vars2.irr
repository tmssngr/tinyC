@printString@@u8:
 Local variables
	arg 0: str (u8*/8)
	; 6 pc
	move r6, r1
	move r1, r6
	call r0 = strlen@@u8[r1] -> i64
	move r1, r6
	move r2, r0
	call printStringLength@@u8@i64[r1, r2]

@strlen@@u8:
 Local variables
	arg 0: str (u8*/8)
	; 7 pc
	const r0, 0
	; 69:2 for *str != 0
	jump @for_1
@for_1_body:
	add r0, r0, 1
	add r1, r1, 1
@for_1:
	load r2, [r1]
	const r3, 0
	notequals r2, r2, r3
	branch r2, true, @for_1_body, @for_1_break
	; 72:9 return length

@next:
	; 12 pc
	addrof r7, global
	load r1, [r7]
	move r0, r1
	add r1, r1, 1
	; 8:9 return copy
	addrof r7, global
	store [r7], r1

@main:
	; 16 pc
	; begin initialize global variables
	const r6, 0
	; end initialize global variables
	; 12:2 while true
	addrof r7, global
	store [r7], r6
	jump @while_2
@if_3_end:
	; 19:3 if n < 2
	const r0, 2
	lt r6, r6, r0
	branch r6, false, @while_2, @if_4_then
	const r1, [string-1]
	call printString@@u8[r1]
@while_2:
	const r1, [string-0]
	call printString@@u8[r1]
	call r0 = next[] -> u8
	move r6, r0
	; 15:3 if n == 3
	const r0, 3
	equals r0, r6, r0
	branch r0, false, @if_3_end, @main_ret

@printStringLength@@u8@i64:
	mov     rdi, rsp
	
	mov     r8, rdx
	mov     rdx, rcx
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

Global variables
	0: global (u8/1)

String literals
	string lit 0 "loop\n\0"
	string lit 1 "<2\n\0"
