@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	; 7 pc
	move chr, chr{r1}
	addrof t.1{r1}, chr
	const arg.0.1{r2}, 1
	call printStringLength@@u8@u8[t.1{r1}, arg.0.1{r2}]

@printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	; 24 pc
	move number{r6}, number{r1}
	const pos{r7}, 20
	; 28:2 while true
@while_1:
	sub pos{r7}, pos{r7}, 1
	move remainder{r3}, number{r6}
	move remainder{r0}, remainder{r3}
	mod remainder{r2}, remainder{r0}, 10
	move remainder{r3}, remainder{r2}
	move number{r0}, number{r6}
	div number{r0}, number{r0}, 10
	move number{r6}, number{r0}
	cast t.5{r0}(u8), remainder{r3}(i64)
	add digit{r0}, digit{r0}, 48
	cast t.7{r3}(i64), pos{r7}(u8)
	addrof t.6{r4}, [buffer]
	add t.6{r4}, t.6{r4}, t.7{r3}
	store [t.6{r4}], digit{r0}
	; 34:3 if number == 0
	equals t.8{r0}, number{r6}, 0
	branch t.8{r0}, false, @while_1, @while_1_break
	cast t.10{r6}(i64), pos{r7}(u8)
	addrof t.9{r1}, [buffer]
	add t.9{r1}, t.9{r1}, t.10{r6}
	const t.12{r6}, 20
	move t.11{r2}, t.12{r6}
	sub t.11{r2}, t.11{r2}, pos{r7}
	call printStringLength@@u8@u8[t.9{r1}, t.11{r2}]

@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 2 pc
	cast t.1{r1}(i64), number{r1}(u8)
	call printIntLf@i64[t.1{r1}]

@printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 8 pc
	move number{r6}, number{r1}
	; 54:2 if number < 0
	lt t.1{r7}, number{r6}, 0
	branch t.1{r7}, false, @if_3_end, @if_3_then
	const arg.0.0{r1}, 45
	call printChar@u8[arg.0.0{r1}]
	neg number{r6}, number{r6}
@if_3_end:
	move number{r1}, number{r6}
	call printUint@i64[number{r1}]
	const arg.2.0{r1}, 10
	call printChar@u8[arg.2.0{r1}]

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	; 2 pc
	cast t.2{r2}(i64), length{r2}(u8)
	call printStringLength@@u8@i64[str{r1}, t.2{r2}]

@main:
 Local variables
	var 0: t.2 (u8/1)
	var 1: t.3 (u8/1)
	var 2: arg.5.4 (u8/1)
	; 30 pc
	; begin initialize global variables
	const tmp.i{r6}, 0
	; end initialize global variables
	move i, tmp.i{r6}
	call t.0{r0} = next[] -> u8
	move t.0{r6}, t.0{r0}
	call t.1{r0} = next[] -> u8
	move t.1{r7}, t.1{r0}
	call t.2{r0} = next[] -> u8
	move t.2, t.2{r0}
	call t.3{r0} = next[] -> u8
	move t.3, t.3{r0}
	call t.4{r0} = next[] -> u8
	move arg.5.4, t.4{r0}
	move t.0{r1}, t.0{r6}
	move t.1{r2}, t.1{r7}
	move t.2{r3}, t.2
	move t.3{r4}, t.3
	call doPrint@u8@u8@u8@u8@u8[t.0{r1}, t.1{r2}, t.2{r3}, t.3{r4}, arg.5.4]

@next:
	; 7 pc
	move tmp.i{r0}, i
	add tmp.i{r0}, tmp.i{r0}, 1
	; 11:9 return i
	move i, tmp.i{r0}

@doPrint@u8@u8@u8@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)
	arg 2: c (u8/1)
	arg 3: d (u8/1)
	arg 4: e (u8/1)
	; 23 pc
	move e{r6}, e
	move b{r7}, b{r2}
	move c, c{r3}
	move d, d{r4}
	call printIntLf@u8[a{r1}]
	move b{r1}, b{r7}
	call printIntLf@u8[b{r1}]
	move c{r1}, c
	call printIntLf@u8[c{r1}]
	move d{r1}, d
	call printIntLf@u8[d{r1}]
	move e{r1}, e{r6}
	call printIntLf@u8[e{r1}]

@printStringLength@@u8@i64:
	mov     rdi, rsp
	
	mov     r8, rdx
	mov     rdx, rcx
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

Global variables
	0: i (u8/1)

