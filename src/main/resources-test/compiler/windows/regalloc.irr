@simple:
	; 2 pc
	const four{r1}, 4
	const three{r2}, 3
	move one{r0}, four{r1}
	sub one{r0}, one{r0}, three{r2}
	; 5:9 return one

@registerHint@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)
	; 2 pc
	; 9:11 return a + b
	move t.2{r0}, a{r1}
	add t.2{r0}, t.2{r0}, b{r2}

@max@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)
	; 5 pc
	; 13:2 if a < b
	lt t.2{r3}, a{r1}, b{r2}
	branch t.2{r3}, true, @if_1_then, @if_1_end
	; 16:9 return a
	move a{r0}, a{r1}
	jump @max@u8@u8_ret
@if_1_then:
	; 14:10 return b
	move b{r0}, b{r2}
@max@u8@u8_ret:

@fibonacci@u8:
 Local variables
	arg 0: i (u8/1)
	; 8 pc
	const a{r0}, 0
	const b{r2}, 1
	; 22:2 while i > 0
	jump @while_2
@while_2_body:
	const t.6{r3}, 1
	sub i{r1}, i{r1}, t.6{r3}
	move c{r3}, a{r0}
	add c{r3}, c{r3}, b{r2}
	move a{r0}, b{r2}
	move b{r2}, c{r3}
@while_2:
	const t.5{r3}, 0
	gt t.4{r3}, i{r1}, t.5{r3}
	branch t.4{r3}, true, @while_2_body, @while_2_break
	; 28:9 return a

@main:
	; 9 pc
	call one{r0} = simple[] -> u8
	move one{r6}, one{r0}
	const two{r7}, 2
	move one{r1}, one{r6}
	move two{r2}, two{r7}
	call _ = registerHint@u8@u8[one{r1}, two{r2}] -> u8
	move one{r1}, one{r6}
	move two{r2}, two{r7}
	call _ = max@u8@u8[one{r1}, two{r2}] -> u8
	const t.4{r1}, 5
	call _ = fibonacci@u8[t.4{r1}] -> i16

