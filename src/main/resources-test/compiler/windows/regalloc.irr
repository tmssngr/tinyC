simple:
	; 2 pc
	const four.1{r1}, 4
	const three.1{r2}, 3
	move one.1{r0}, four.1{r1}
	sub one.1{r0}, one.1{r0}, three.1{r2}
	; 5:9 return one

registerHint@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)
	; 2 pc
	; 9:11 return a + b
	move t.2.1{r0}, a{r1}
	add t.2.1{r0}, t.2.1{r0}, b{r2}

max@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)
	; 4 pc
	branch a{r1} lt b{r2}: if_1_then, if_1_end
	; 16:9 return a
	move a{r0}, a{r1}
	jump max@u8@u8_ret
if_1_then:
	; 14:10 return b
	move b{r0}, b{r2}
max@u8@u8_ret:

fibonacci@u8:
 Local variables
	arg 0: i (u8/1)
	; 9 pc
	const a.1{r2}, 0
	const b.1{r3}, 1
	; 22:2 while i > 0
	move a.2{r0}, a.1{r2}
	move b.2{r2}, b.1{r3}
	jump while_2
while_2_body:
	sub i.2{r1}, i.2{r1}, 1
	move c.1{r3}, a.2{r0}
	add c.1{r3}, c.1{r3}, b.2{r2}
	move a.2{r0}, a.3{r2}
	move b.2{r2}, b.3{r3}
while_2:
	branch i.1{r1} gt 0: while_2_body, while_2_break
	; 28:9 return a

main:
	; 9 pc
	call one.1{r0} = simple[] -> u8
	move one.1{r6}, one.1{r0}
	const two.1{r7}, 2
	move one.1{r1}, one.1{r6}
	move two.1{r2}, two.1{r7}
	call _ = registerHint@u8@u8[one.1{r1}, two.1{r2}] -> u8
	move one.1{r1}, one.1{r6}
	move two.1{r2}, two.1{r7}
	call _ = max@u8@u8[one.1{r1}, two.1{r2}] -> u8
	const arg.3.0{r1}, 5
	call _ = fibonacci@u8[arg.3.0{r1}] -> i16

