simple:
 Local variables
	var 0: four.1 (u8/1)
	var 1: three.1 (u8/1)
	var 2: one.1 (u8/1)
	; 19 pc
	const four.1, 4
	const three.1, 3
	move one.1, four.1
	sub one.1, one.1, three.1
	; 5:9 return one
	ret one.1

registerHint@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)
	var 2: t.2.1 (u8/1)
	; 15 pc
	; 9:11 return a + b
	move t.2.1, a
	add t.2.1, t.2.1, b
	ret t.2.1

max@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)
	; 12 pc
	branch a lt b: if_1_then, if_1_end
	; 16:9 return a
	ret a
	jump max@u8@u8_ret
if_1_then:
	; 14:10 return b
	ret b
max@u8@u8_ret:

fibonacci@u8:
 Local variables
	arg 0: i (u8/1)
	var 1: a.1 (i16/2)
	var 2: b.1 (i16/2)
	var 3: i.1 (u8/1)
	var 4: a.2 (i16/2)
	var 5: b.2 (i16/2)
	var 6: i.2 (u8/1)
	var 7: c.1 (i16/2)
	var 8: a.3 (i16/2)
	var 9: b.3 (i16/2)
	; 73 pc
	const a.1, 0
	const b.1, 1
	; 22:2 while i > 0
	move i.1, i
	move a.2, a.1
	move b.2, b.1
	jump while_2
while_2_body:
	move i.2, i.1
	sub i.2, i.2, 1
	move c.1, a.2
	add c.1, c.1, b.2
	move a.3, b.2
	move b.3, c.1
	move i.1, i.2
	move a.2, a.3
	move b.2, b.3
while_2:
	branch i.1 gt 0: while_2_body, while_2_break
	; 28:9 return a
	ret a.2

main:
 Local variables
	var 0: one.1 (u8/1)
	var 1: two.1 (u8/1)
	var 2: oneOrTwo.1 (u8/1)
	var 3: f5.1 (i16/2)
	; 16 pc
	call one.1 = simple[] -> u8
	const two.1, 2
	call _ = registerHint@u8@u8[one.1, two.1] -> u8
	call _ = max@u8@u8[one.1, two.1] -> u8
	call _ = fibonacci@u8[5] -> i16

