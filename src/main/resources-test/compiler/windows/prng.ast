i32 __random__;

void _printStringLength@@u8@i64(u8* str, i64 length) asm {
}

void _printChar@u8(u8 chr) {
	_printStringLength@@u8@u8(&chr, 1);
}

void _printUint@i64(i64 number) {
	u8* buffer[20];
	u8 pos;
	i64 remainder;
	u8 digit;

	pos = 20;
	while (true) {
		pos = pos - 1;
		remainder = number % 10;
		number = number / 10;
		digit = (remainder as u8) + 48;
		buffer[pos as i64] = digit;
		if (number == 0) {
			break;
		}
	}
	_printStringLength@@u8@u8(&buffer[pos as i64], 20 - pos);
}

void _printIntLf@u8(u8 number) {
	_printIntLf@i64(number as i64);
}

void _printIntLf@i64(i64 number) {
	if (number < 0) {
		_printChar@u8(45);
		number = -number;
	}
	_printUint@i64(number);
	_printChar@u8(10);
}

void _printStringLength@@u8@u8(u8* str, u8 length) {
	_printStringLength@@u8@i64(str, length as i64);
}

void _initRandom@i32(i32 salt) {
	__random__ = salt;
}

i32 _random() {
	i32 r;
	i32 b;
	i32 c;
	i32 d;
	i32 e;

	r = __random__;
	b = (r & 524287) * 48271;
	c = (r >> 15) * 48271;
	d = (c & 65535) << 15;
	e = ((c >> 16) + b) + d;
	__random__ = (e & 2147483647) + (e >> 31);
	return __random__;
}

u8 _randomU8() {
	return (_random()) as u8;
}

void _main() {
	u8 i;
	u8 r;

	_initRandom@i32(7439742);
	i = 0;
	for (; i < 50; i = i + 1) {
		r = _randomU8();
		_printIntLf@u8(r);
	}
}
