void _printStringLength@@u8@i64(u8* str, i64 length) asm {
}

void _printChar@u8(u8 chr) {
	_printStringLength@@u8@u8(&chr, 1);
}

void _printUint@i64(i64 number) {
	u8* buffer[20];
	u8 pos;
	i64 remainder;
	u8 digit;

	pos = 20;
	while (true) {
		pos = pos - 1;
		remainder = number % 10;
		number = number / 10;
		digit = (remainder as u8) + 48;
		buffer[pos as i64] = digit;
		if (number == 0) {
			break;
		}
	}
	_printStringLength@@u8@u8(&buffer[pos as i64], 20 - pos);
}

void _printIntLf@i16(i16 number) {
	_printIntLf@i64(number as i64);
}

void _printIntLf@i64(i64 number) {
	if (number < 0) {
		_printChar@u8(45);
		number = -number;
	}
	_printUint@i64(number);
	_printChar@u8(10);
}

void _printStringLength@@u8@u8(u8* str, u8 length) {
	_printStringLength@@u8@i64(str, length as i64);
}

void _main() {
	i16 foo;
	i16 bar;
	i16 bazz;
	i16 a;
	i16 b;

	foo = ((4 * 3) + (2 * 5)) as i16;
	bar = foo * foo;
	foo = 1;
	_printIntLf@i16(bar + foo);
	foo = ((1 + 2) * (3 + 4)) as i16;
	_printIntLf@i16(foo);
	bazz = 0;
	_printIntLf@i16(bazz);
	a = 1000;
	b = 10;
	_printIntLf@i16(a / b);
	_printIntLf@i16(a % 256);
	a = 10;
	b = 1;
	_printIntLf@i16(a >> b);
	a = 9;
	b = 2;
	_printIntLf@i16(a >> b);
	a = 1;
	_printIntLf@i16(a << b);
}
