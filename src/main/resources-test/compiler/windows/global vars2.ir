_printString@@u8:
 Local variables
	arg 0: str (u8*/8)
	var 1: length (i64/8)

	call length = _strlen@@u8[str] -> i64
	call _printStringLength@@u8@i64[str, length]
_printString@@u8_ret:

_strlen@@u8:
 Local variables
	arg 0: str (u8*/8)
	var 1: length (i64/8)
	var 2: t.2 (u8/1)

	const length, 0
	; 73:2 for *str != 0
for_1:
	load t.2, [str]
	branch t.2 equals 0: for_1_break, for_1_body
for_1_body:
	add length, 1
for_1_continue:
	add str, 1
	jump for_1
for_1_break:
	; 76:9 return length
	ret length
	jump _strlen@@u8_ret
_strlen@@u8_ret:

_next:
 Local variables
	var 0: copy (u8/1)
	var 1: a.1 (u8*/8)
	var 2: t.2 (u8/1)
	var 3: a.3 (u8*/8)
	var 4: t.4 (u8/1)
	var 5: a.5 (u8*/8)

	addrof a.1, global
	load copy, [a.1]
	addrof a.3, global
	load t.4, [a.3]
	add t.2, t.4, 1
	addrof a.5, global
	store [a.5], t.2
	; 8:9 return copy
	ret copy
	jump _next_ret
_next_ret:

_main:
 Local variables
	var 0: n (u8/1)
	var 1: t.1 (u8/1)
	var 2: a.2 (u8*/8)
	var 3: t.3 (u8*/8)
	var 4: t.4 (u8*/8)

	; begin initialize global variables
	const t.1, 0
	addrof a.2, global
	store [a.2], t.1
	; end initialize global variables
	; 12:2 while true
while_2:
	const t.3, [string-0]
	call _printString@@u8[t.3]
	call n = _next[] -> u8
	; 15:3 if n == 3
	branch n equals 3: _main_ret, if_3_end
if_3_end:
	; 19:3 if n < 2
	branch n gteq 2: while_2, if_4_then
if_4_then:
	const t.4, [string-1]
	call _printString@@u8[t.4]
	jump while_2
_main_ret:

_printStringLength@@u8@i64:
	mov     rdi, rsp
	
	mov     r8, rdx
	mov     rdx, rcx
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

Global variables
	0: global (u8/1)

String literals
	string lit 0 "loop\n\0"
	string lit 1 "<2\n\0"
