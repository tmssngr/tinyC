u8 zero;
u8 one;
u8 two;
u8 threeFour;

void _printStringLength@@u8@i64(u8* str, i64 length) asm {
}

void _printChar@u8(u8 chr) {
	_printStringLength@@u8@u8(&chr, 1);
}

void _printUint@u8(u8 number) {
	_printUint@i64(number as i64);
}

void _printUint@i64(i64 number) {
	u8* buffer[20];
	u8 pos;
	i64 remainder;
	u8 digit;

	pos = 20;
	while (true) {
		pos = pos - 1;
		remainder = number % 10;
		number = number / 10;
		digit = (remainder as u8) + 48;
		buffer[pos as i64] = digit;
		if (number == 0) {
			break;
		}
	}
	_printStringLength@@u8@u8(&buffer[pos as i64], 20 - pos);
}

void _printStringLength@@u8@u8(u8* str, u8 length) {
	_printStringLength@@u8@i64(str, length as i64);
}

i64 _unusedArgs@u8@bool@u8@u8(u8 a, bool b, u8 c, u8 d) {
	return c as i64;
}

void _main() {
	i64 c;
	u8* onePtr;
	u8* twoPtr;

	c = _unusedArgs@u8@bool@u8@u8(1, true, 2, 3);
	_printChar@u8(zero);
	onePtr = &one;
	_printChar@u8(*onePtr);
	twoPtr = &two;
	_printChar@u8(twoPtr[0]);
	_printUint@u8(threeFour);
	_printChar@u8(10);
}
