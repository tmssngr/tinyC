printString@@u8:
 Local variables
	arg 0: str (u8*/8)
	var 1: length.1 (i64/8)
	; 10 pc
	call length.1 = strlen@@u8[str] -> i64
	call printStringLength@@u8@i64[str, length.1]

printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1.1 (u8*/8)
	; 8 pc
	addrof t.1.1, chr
	call printStringLength@@u8@u8[t.1.1, 1]

strlen@@u8:
 Local variables
	arg 0: str (u8*/8)
	var 1: length.1 (i64/8)
	var 2: str.1 (u8*/8)
	var 3: length.2 (i64/8)
	var 4: t.2.1 (u8/1)
	var 5: length.3 (i64/8)
	var 6: str.2 (u8*/8)
	; 55 pc
	const length.1, 0
	; 64:2 for *str != 0
	move str.1, str
	move length.2, length.1
	jump for_1
for_1_body:
	move length.3, length.2
	add length.3, length.3, 1
	move str.2, str.1
	add str.2, str.2, 1
	move str.1, str.2
	move length.2, length.3
for_1:
	load t.2.1, [str.1]
	branch t.2.1 notequals 0: for_1_body, for_1_break
	; 67:9 return length
	ret length.2

printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2.1 (i64/8)
	; 10 pc
	cast t.2.1(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2.1]

printNibble@u8:
 Local variables
	arg 0: x (u8/1)
	var 1: x.1 (u8/1)
	var 2: x.2 (u8/1)
	var 3: x.3 (u8/1)
	var 4: x.4 (u8/1)
	; 47 pc
	move x.1, x
	and x.1, x.1, 15
	; 5:2 if x > 9
	branch x.1 gt 9: if_2_then, printNibble@u8.no_critical_edge_4
	move x.2, x.1
	jump if_2_end
if_2_then:
	move x.3, x.1
	add x.3, x.3, 7
	move x.2, x.3
if_2_end:
	move x.4, x.2
	add x.4, x.4, 48
	call printChar@u8[x.4]

printHex2@u8:
 Local variables
	arg 0: x (u8/1)
	var 1: t.1.1 (u8/1)
	; 16 pc
	move t.1.1, x
	shiftright t.1.1, t.1.1, 4
	call printNibble@u8[t.1.1]
	call printNibble@u8[x]

main:
 Local variables
	var 0: t.2.1 (u8*/8)
	var 1: i.1 (u8/1)
	var 2: i.2 (u8/1)
	var 3: i.3 (u8/1)
	var 4: i.4 (u8/1)
	var 5: t.3.1 (u8/1)
	var 6: t.4.1 (u8/1)
	var 7: i.7 (u8/1)
	var 8: t.5.1 (u8/1)
	var 9: t.6.1 (u8/1)
	var 10: i.10 (u8/1)
	; 123 pc
	const t.2.1, [string-0]
	call printString@@u8[t.2.1]
	const i.1, 0
	; 19:2 for i < 16
	move i.2, i.1
	jump for_3
for_3_body:
	; 20:3 if i & 7 == 0
	move t.3.1, i.2
	and t.3.1, t.3.1, 7
	branch t.3.1 notequals 0: if_4_end, if_4_then
	call printChar@u8[32]
if_4_end:
	call printNibble@u8[i.2]
	move i.7, i.2
	add i.7, i.7, 1
	move i.2, i.7
for_3:
	branch i.2 lt 16: for_3_body, for_3_break
	call printChar@u8[10]
	const i.3, 32
	; 27:2 for i < 128
	move i.4, i.3
	jump for_5
for_5_body:
	; 28:3 if i & 15 == 0
	move t.4.1, i.4
	and t.4.1, t.4.1, 15
	branch t.4.1 notequals 0: if_6_end, if_6_then
	call printHex2@u8[i.4]
if_6_end:
	; 31:3 if i & 7 == 0
	move t.5.1, i.4
	and t.5.1, t.5.1, 7
	branch t.5.1 notequals 0: if_7_end, if_7_then
	call printChar@u8[32]
if_7_end:
	call printChar@u8[i.4]
	; 35:3 if i & 15 == 15
	move t.6.1, i.4
	and t.6.1, t.6.1, 15
	branch t.6.1 notequals 15: for_5_continue, if_8_then
	call printChar@u8[10]
for_5_continue:
	move i.10, i.4
	add i.10, i.10, 1
	move i.4, i.10
for_5:
	branch i.4 lt 128: for_5_body, main_ret

printStringLength@@u8@i64:
	mov     rdi, rsp
	
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	mov     rdx, [rdi+18h]
	mov     r8, [rdi+10h]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

