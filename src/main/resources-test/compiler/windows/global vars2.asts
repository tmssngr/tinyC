i32 __random__;
u8 global;

void printString@@u8(u8* str) {
	i64 length;

	length = strlen@@u8(str);
	printStringLength@@u8@i64(str, length);
}

i64 strlen@@u8(u8* str) {
	i64 length;

	length = 0;
	for (; (*str) != 0; str = str + 1) {
		length = length + 1;
	}
	return length;
}

void printStringLength@@u8@i64(u8* str, i64 length) asm {
}

u8 next() {
	u8 copy;

	copy = global;
	global = global + 1;
	return copy;
}

void main() {
	u8 n;

	while (true) {
		printString@@u8("loop\n");
		n = next();
		if (n == 3) {
