@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1 (u8*/8)
	; 8 pc
	addrof t.1, chr
	call printStringLength@@u8@u8[t.1, 1]
@printChar@u8_ret:

@printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	var 2: pos (u8/1)
	var 3: remainder (i64/8)
	var 4: digit (u8/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8*/8)
	var 7: t.7 (i64/8)
	var 8: t.8 (bool/1)
	var 9: t.9 (u8*/8)
	var 10: t.10 (i64/8)
	var 11: t.11 (u8/1)
	var 12: t.12 (u8/1)
	; 100 pc
	const pos, 20
	; 33:2 while true
@while_1:
	sub pos, pos, 1
	move remainder, number
	mod remainder, remainder, 10
	div number, number, 10
	cast t.5(u8), remainder(i64)
	move digit, t.5
	add digit, digit, 48
	cast t.7(i64), pos(u8)
	addrof t.6, [buffer]
	add t.6, t.6, t.7
	store [t.6], digit
	; 39:3 if number == 0
	equals t.8, number, 0
	branch t.8, false, @while_1, @while_1_break
@while_1_break:
	cast t.10(i64), pos(u8)
	addrof t.9, [buffer]
	add t.9, t.9, t.10
	const t.12, 20
	move t.11, t.12
	sub t.11, t.11, pos
	call printStringLength@@u8@u8[t.9, t.11]
@printUint@i64_ret:

@printIntLf@i16:
 Local variables
	arg 0: number (i16/2)
	var 1: t.1 (i64/8)
	; 8 pc
	cast t.1(i64), number(i16)
	call printIntLf@i64[t.1]
@printIntLf@i16_ret:

@printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: t.1 (bool/1)
	; 18 pc
	; 59:2 if number < 0
	lt t.1, number, 0
	branch t.1, false, @if_3_end, @if_3_then
@if_3_then:
	call printChar@u8[45]
	neg number, number
@if_3_end:
	call printUint@i64[number]
	call printChar@u8[10]
@printIntLf@i64_ret:

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2 (i64/8)
	; 10 pc
	cast t.2(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2]
@printStringLength@@u8@u8_ret:

@main:
 Local variables
	var 0: a (i16/2)
	var 1: b (i16*/8)
	var 2: c (i16/2)
	var 3: d (i16*/8)
	var 4: t.4 (i16/2)
	var 5: t.5 (i16/2)
	var 6: t.6 (i16/2)
	; 59 pc
	const a, 10
	call printIntLf@i16[a]
	addrof b, a
	load t.4, [b]
	move c, t.4
	sub c, c, 1
	call printIntLf@i16[c]
	addrof d, c
	load t.6, [d]
	move t.5, t.6
	sub t.5, t.5, 1
	store [d], t.5
	call printIntLf@i16[c]
@main_ret:

@printStringLength@@u8@i64:
	mov     rdi, rsp
	
	mov     r8, rdx
	mov     rdx, rcx
	lea     rcx, [hStdOut]
	mov     rcx, [rcx]
	xor     r9, r9
	push    0
	sub     rsp, 20h
	  call    [WriteFile]
	mov     rsp, rdi
	ret

