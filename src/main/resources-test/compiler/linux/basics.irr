	const arg.0.3{r4}, 3
	call _ = unusedArgs@u8@bool@u8@u8[arg.0.0{r1}, t.3{r2}, arg.0.2{r3}, arg.0.3{r4}] -> i64
	addrof memVarAddr{r9}, zero
	load tmp.zero{r8}, [memVarAddr{r9}]
	move tmp.zero{r1}, tmp.zero{r8}
	call printChar@u8[tmp.zero{r1}]
	addrof onePtr{r8}, one
	load t.4{r1}, [onePtr{r8}]
	call printChar@u8[t.4{r1}]
	addrof twoPtr{r8}, two
	const t.7{r0}, 0
	add t.6{r8}, t.6{r8}, t.7{r0}
	load t.5{r1}, [t.6{r8}]
