u8* chars[256];

void printStringLength@@u8@i64(u8* str, i64 length) asm {
}

void printChar@u8(u8 chr) {
	printStringLength@@u8@u8(&chr, 1);
}

void printUint@i64(i64 number) {
	u8* buffer[20];
	u8 pos;
	i64 remainder;
	u8 digit;

	pos = 20;
	while (true) {
		pos = pos - 1;
		remainder = number % 10;
		number = number / 10;
		digit = (remainder as u8) + 48;
		buffer[pos as i64] = digit;
		if (number == 0) {
			break;
		}
	}
	printStringLength@@u8@u8(&buffer[pos as i64], 20 - pos);
}

void printIntLf@u8(u8 number) {
	printIntLf@i64(number as i64);
}

void printIntLf@i64(i64 number) {
	if (number < 0) {
		printChar@u8(45);
		number = -number;
	}
	printUint@i64(number);
	printChar@u8(10);
}

void printStringLength@@u8@u8(u8* str, u8 length) {
	printStringLength@@u8@i64(str, length as i64);
}

void main() {
	u8 chr;
	u8 result;

	chr = 32;
	chars[0] = chr;
	chars[1] = chars[0] + 1;
	chars[2] = chars[1] + 2;
	result = chars[2];
	printIntLf@u8(result);
}
