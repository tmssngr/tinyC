u8 global;

void _printStringLength@@u8@i64(u8* str, i64 length) asm {
}

void _printString@@u8(u8* str) {
	i64 length;

	length = _strlen@@u8(str);
	_printStringLength@@u8@i64(str, length);
}

i64 _strlen@@u8(u8* str) {
	i64 length;

	length = 0;
	for (; (*str) != 0; str = str + 1) {
		length = length + 1;
	}
	return length;
}

u8 _next() {
	u8 copy;

	copy = global;
	global = global + 1;
	return copy;
}

void _main() {
	u8 n;

	while (true) {
		_printString@@u8("loop\n");
		n = _next();
		if (n == 3) {
			break;
		}
		if (n < 2) {
			_printString@@u8("<2\n");
		}
	}
}
