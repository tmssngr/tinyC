@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	; 9 pc
	addrof memVarAddr{r9}, chr
	store [memVarAddr{r9}], chr{r1}
	addrof t.1{r1}, chr
	const arg.0.1{r2}, 1
	call printStringLength@@u8@u8[t.1{r1}, arg.0.1{r2}]

@printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	; 23 pc
	const pos{r8}, 20
	; 33:2 while true
@while_1:
	sub pos{r8}, pos{r8}, 1
	move remainder{r5}, number{r1}
	move remainder{r0}, remainder{r5}
	mod remainder{r3}, remainder{r0}, 10
	move remainder{r5}, remainder{r3}
	move number{r0}, number{r1}
	div number{r0}, number{r0}, 10
	move number{r1}, number{r0}
	cast t.5{r0}(u8), remainder{r5}(i64)
	add digit{r0}, digit{r0}, 48
	cast t.7{r3}(i64), pos{r8}(u8)
	addrof t.6{r4}, [buffer]
	add t.6{r4}, t.6{r4}, t.7{r3}
	store [t.6{r4}], digit{r0}
	; 39:3 if number == 0
	equals t.8{r0}, number{r1}, 0
	branch t.8{r0}, false, @while_1, @while_1_break
	cast t.10{r0}(i64), pos{r8}(u8)
	addrof t.9{r1}, [buffer]
	add t.9{r1}, t.9{r1}, t.10{r0}
	const t.12{r0}, 20
	move t.11{r2}, t.12{r0}
	sub t.11{r2}, t.11{r2}, pos{r8}
	call printStringLength@@u8@u8[t.9{r1}, t.11{r2}]

@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 2 pc
	cast t.1{r1}(i64), number{r1}(u8)
	call printIntLf@i64[t.1{r1}]

@printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 8 pc
	move number{r8}, number{r1}
	; 59:2 if number < 0
	lt t.1{r9}, number{r8}, 0
	branch t.1{r9}, false, @if_3_end, @if_3_then
	const arg.0.0{r1}, 45
	call printChar@u8[arg.0.0{r1}]
	neg number{r8}, number{r8}
@if_3_end:
	move number{r1}, number{r8}
	call printUint@i64[number{r1}]
	const arg.2.0{r1}, 10
	call printChar@u8[arg.2.0{r1}]

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	; 2 pc
	cast t.2{r2}(i64), length{r2}(u8)
	call printStringLength@@u8@i64[str{r1}, t.2{r2}]

@main:
 Local variables
	var 0: pos (u8/2)
	; 36 pc
	const t.2{r8}, 1
	; 9:6 ExprVarAccess[varName=pos, index=0, scope=function, type=Pos, varIsArray=false, location=9:2].x
	addrof t.3{r9}, pos
	store [t.3{r9}], t.2{r8}
	; 10:14 ExprVarAccess[varName=pos, index=0, scope=function, type=Pos, varIsArray=false, location=10:10].x
	addrof t.6{r8}, pos
	load t.5{r8}, [t.6{r8}]
	add t.4{r8}, t.4{r8}, 1
	; 10:6 ExprVarAccess[varName=pos, index=0, scope=function, type=Pos, varIsArray=false, location=10:2].y
	addrof t.7{r9}, pos
	add t.7{r9}, t.7{r9}, 1
	store [t.7{r9}], t.4{r8}
	; 11:17 ExprVarAccess[varName=pos, index=0, scope=function, type=Pos, varIsArray=false, location=11:13].x
	addrof t.9{r8}, pos
	load t.8{r1}, [t.9{r8}]
	call printIntLf@u8[t.8{r1}]
	; 12:17 ExprVarAccess[varName=pos, index=0, scope=function, type=Pos, varIsArray=false, location=12:13].y
	addrof t.11{r8}, pos
	add t.11{r8}, t.11{r8}, 1
	load t.10{r1}, [t.11{r8}]
	call printIntLf@u8[t.10{r1}]
	; 13:15 ExprVarAccess[varName=pos, index=0, scope=function, type=Pos, varIsArray=false, location=13:11].x
	addrof x{r8}, pos
	load t.12{r1}, [x{r8}]
	call printIntLf@u8[t.12{r1}]

@printStringLength@@u8@i64:
	mov rdx, rsi
	mov rsi, rdi
	mov rdi, 1
	mov rax, 1
	syscall
	ret

