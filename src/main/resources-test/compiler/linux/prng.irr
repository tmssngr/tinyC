	addrof t.8{r1}, buffer
	move t.8{r1}, t.8{r4}
	const t.11{r0}, 20
	move t.10{r2}, t.11{r0}
	sub t.10{r2}, pos{r8}
	call printStringLength@@u8@u8[t.8{r1}, t.10{r2}]

printIntLf@u8:
