void _printStringLength@@u8@i64(u8* str, i64 length) asm {
}

void _printString@@u8(u8* str) {
	i64 length;

	length = _strlen@@u8(str);
	_printStringLength@@u8@i64(str, length);
}

void _printChar@u8(u8 chr) {
	_printStringLength@@u8@u8(&chr, 1);
}

i64 _strlen@@u8(u8* str) {
	i64 length;

	length = 0;
	for (; (*str) != 0; str = str + 1) {
		length = length + 1;
	}
	return length;
}

void _printStringLength@@u8@u8(u8* str, u8 length) {
	_printStringLength@@u8@i64(str, length as i64);
}

void _printNibble@u8(u8 x) {
	x = x & 15;
	if (x > 9) {
		x = x + 7;
	}
	x = x + 48;
	_printChar@u8(x);
}

void _printHex2@u8(u8 x) {
	_printNibble@u8(x >> 4);
	_printNibble@u8(x);
}

void _main() {
	u8 i;
	u8 i;

	_printString@@u8(" x");
	i = 0;
	for (; i < 16; i = i + 1) {
		if ((i & 7) == 0) {
			_printChar@u8(32);
		}
		_printNibble@u8(i);
	}
	_printChar@u8(10);
	i = 32;
	for (; i < 128; i = i + 1) {
		if ((i & 15) == 0) {
			_printHex2@u8(i);
		}
		if ((i & 7) == 0) {
			_printChar@u8(32);
		}
		_printChar@u8(i);
		if ((i & 15) == 15) {
			_printChar@u8(10);
		}
	}
}
