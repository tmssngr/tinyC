_simple:
 Local variables
	var 0: four (u8/1)
	var 1: three (u8/1)
	var 2: one (u8/1)

	const four, 4
	const three, 3
	sub one, four, three
	; 5:9 return one
	ret one
	jump _simple_ret
_simple_ret:

_registerHint@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)
	var 2: t.2 (u8/1)

	; 9:11 return a + b
	add t.2, a, b
	ret t.2
	jump _registerHint@u8@u8_ret
_registerHint@u8@u8_ret:

_max@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)

	; 13:2 if a < b
	branch a gteq b: if_1_end, if_1_then
if_1_then:
	; 14:10 return b
	ret b
	jump _max@u8@u8_ret
if_1_end:
	; 16:9 return a
	ret a
	jump _max@u8@u8_ret
_max@u8@u8_ret:

_fibonacci@u8:
 Local variables
	arg 0: i (u8/1)
	var 1: a (i16/2)
	var 2: b (i16/2)
	var 3: c (i16/2)

	const a, 0
	const b, 1
	; 22:2 while i > 0
while_2:
	branch i lteq 0: while_2_break, while_2_body
while_2_body:
	sub i, 1
	add c, a, b
	move a, b
	move b, c
	jump while_2
while_2_break:
	; 28:9 return a
	ret a
	jump _fibonacci@u8_ret
_fibonacci@u8_ret:

_main:
 Local variables
	var 0: one (u8/1)
	var 1: two (u8/1)
	var 2: oneOrTwo (u8/1)
	var 3: f5 (i16/2)

	call one = _simple[] -> u8
	const two, 2
	call _ = _registerHint@u8@u8[one, two] -> u8
	call oneOrTwo = _max@u8@u8[one, two] -> u8
	call f5 = _fibonacci@u8[5] -> i16
_main_ret:

