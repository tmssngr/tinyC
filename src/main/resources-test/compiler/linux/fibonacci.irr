while_4_body:
	add b.3{r0}, a.2{r8}
	move a.3{r1}, b.3{r0}
	addrof memVarAddr{r9}, b.3
	store [memVarAddr{r9}], b.3{r0}
	sub a.3{r1}, a.2{r8}
	addrof memVarAddr{r9}, a.3
