	store [memVarAddr{r9}], chr{r1}
	move t.1.1{r1}, t.1.1{r9}
	const arg.0.1{r2}, 1
	call printStringLength@@u8@u8[t.1.1{r1}, arg.0.1{r2}]

printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	; 28 pc
	const pos.1{r8}, 20
	; 33:2 while true
	move number.1{r5}, number{r1}
while_1:
	sub pos.3{r8}, 1
	move remainder.1{r6}, number.1{r5}
	move remainder.1{r0}, remainder.1{r6}
