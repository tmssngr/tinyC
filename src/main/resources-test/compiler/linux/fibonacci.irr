	load a.3{r1}, [memVarAddr{r9}]
	move a.2{r8}, a.3{r1}
	addrof memVarAddr{r9}, b.3
	load b.3{r0}, [memVarAddr{r9}]
while_4:
	branch b.2{r0} lt 1000: while_4_body

