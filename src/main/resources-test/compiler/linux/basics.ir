@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1 (u8*/8)
	; 8 pc
	addrof t.1, chr
	call printStringLength@@u8@u8[t.1, 1]
@printChar@u8_ret:

@printUint@u8:
 Local variables
	arg 0: number (u8/1)
	var 1: t.1 (i64/8)
	; 8 pc
	cast t.1(i64), number(u8)
	call printUint@i64[t.1]
@printUint@u8_ret:

@printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	var 2: pos (u8/1)
	var 3: remainder (i64/8)
	var 4: digit (u8/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8*/8)
	var 7: t.7 (i64/8)
	var 8: t.8 (bool/1)
	var 9: t.9 (u8*/8)
	var 10: t.10 (i64/8)
	var 11: t.11 (u8/1)
	var 12: t.12 (u8/1)
	; 100 pc
	const pos, 20
	; 33:2 while true
@while_1:
	sub pos, pos, 1
	move remainder, number
	mod remainder, remainder, 10
	div number, number, 10
	cast t.5(u8), remainder(i64)
	move digit, t.5
	add digit, digit, 48
	cast t.7(i64), pos(u8)
	addrof t.6, [buffer]
	add t.6, t.6, t.7
	store [t.6], digit
	; 39:3 if number == 0
	equals t.8, number, 0
	branch t.8, false, @while_1, @while_1_break
@while_1_break:
	cast t.10(i64), pos(u8)
	addrof t.9, [buffer]
	add t.9, t.9, t.10
	const t.12, 20
	move t.11, t.12
	sub t.11, t.11, pos
	call printStringLength@@u8@u8[t.9, t.11]
@printUint@i64_ret:

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2 (i64/8)
	; 10 pc
	cast t.2(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2]
@printStringLength@@u8@u8_ret:

@unusedArgs@u8@bool@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (bool/1)
	arg 2: c (u8/1)
	arg 3: d (u8/1)
	var 4: t.4 (i64/8)
	; 9 pc
	; 9:10 return (i64)
	cast t.4(i64), c(u8)
	ret t.4
	jump @unusedArgs@u8@bool@u8@u8_ret
@unusedArgs@u8@bool@u8@u8_ret:

@main:
 Local variables
	var 0: c (i64/8)
	var 1: onePtr (u8*/8)
	var 2: twoPtr (u8*/8)
	var 3: t.3 (bool/1)
	var 4: t.4 (u8/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8*/8)
	var 7: t.7 (i64/8)
	; 64 pc
	; begin initialize global variables
	const zero, 48
	const one, 49
	const two, 50
	const threeFour, 34
	; end initialize global variables
	const t.3, 1
	call c = unusedArgs@u8@bool@u8@u8[1, t.3, 2, 3] -> i64
	call printChar@u8[zero]
	addrof onePtr, one
	load t.4, [onePtr]
	call printChar@u8[t.4]
	addrof twoPtr, two
	const t.7, 0
	move t.6, twoPtr
	add t.6, t.6, t.7
	load t.5, [t.6]
	call printChar@u8[t.5]
	call printUint@u8[threeFour]
	call printChar@u8[10]
@main_ret:

@printStringLength@@u8@i64:
	mov rdx, rsi
	mov rsi, rdi
	mov rdi, 1
	mov rax, 1
	syscall
	ret

Global variables
	0: zero (u8/1)
	1: one (u8/1)
	2: two (u8/1)
	3: threeFour (u8/1)

