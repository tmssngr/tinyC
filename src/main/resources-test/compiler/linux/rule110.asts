u8* board[30];

void _printStringLength@@u8@i64(u8* str, i64 length) asm {
}

void _printString@@u8(u8* str) {
	i64 length;

	length = _strlen@@u8(str);
	_printStringLength@@u8@i64(str, length);
}

void _printChar@u8(u8 chr) {
	_printStringLength@@u8@u8(&chr, 1);
}

i64 _strlen@@u8(u8* str) {
	i64 length;

	length = 0;
	for (; (*str) != 0; str = str + 1) {
		length = length + 1;
	}
	return length;
}

void _printStringLength@@u8@u8(u8* str, u8 length) {
	_printStringLength@@u8@i64(str, length as i64);
}

void _printBoard() {
	u8 i;

	_printChar@u8(124);
	i = 0;
	for (; i < 30; i = i + 1) {
		if (board[i as i64] == 0) {
			_printChar@u8(32);
		}
		else {
			_printChar@u8(42);
		}
	}
	_printString@@u8("|\n");
}

void _main() {
	u8 i;
	u8 i;
	u8 pattern;
	u8 j;

	i = 0;
	for (; i < 30; i = i + 1) {
		board[i as i64] = 0;
	}
	board[29] = 1;
	_printBoard();
	i = 0;
	for (; i < 28; i = i + 1) {
		pattern = (board[0] << 1) | board[1];
		j = 1;
		for (; j < 29; j = j + 1) {
			pattern = ((pattern << 1) & 7) | board[(j + 1) as i64];
			board[j as i64] = (110 >> pattern) & 1;
		}
		_printBoard();
	}
}
