	mov    rdx, rsp
	syscall
	mov    eax, r10d
	add    rsp, 48
	ret

waitFrame:
	sub  rsp, 10h
	mov  qword [rsp], 0
	mov  qword [rsp+8], 25000000
	mov  rdi, rsp
	xor  esi, esi
	mov  eax, 35
	syscall
	add  rsp, 10h
	ret

Global variables
	0: __random__ (i32/4)
	1: tiles[] (u8*/16)
	2: moveTiles[] (u8*/16)
	3: moveTargets[] (u8*/16)
	4: score (i32/4)
	5: gameState (u8/1)

