@printString@@u8:
 Local variables
	arg 0: str (u8*/8)
	; 6 pc
	move str{r8}, str{r1}
	move str{r1}, str{r8}
	call length{r0} = strlen@@u8[str{r1}] -> i64
	move str{r1}, str{r8}
	move length{r2}, length{r0}
	call printStringLength@@u8@i64[str{r1}, length{r2}]

@strlen@@u8:
 Local variables
	arg 0: str (u8*/8)
	; 7 pc
	const length{r0}, 0
	; 69:2 for *str != 0
	jump @for_1
@for_1_body:
	add length{r0}, length{r0}, 1
	add str{r1}, str{r1}, 1
@for_1:
	load t.3{r2}, [str{r1}]
	notequals t.2{r2}, t.3{r2}, 0
	branch t.2{r2}, true, @for_1_body, @for_1_break
	; 72:9 return length

@next:
	; 12 pc
	addrof memVarAddr{r9}, global
	load tmp.global{r1}, [memVarAddr{r9}]
	move copy{r0}, tmp.global{r1}
	add tmp.global{r1}, tmp.global{r1}, 1
	; 8:9 return copy
	addrof memVarAddr{r9}, global
	store [memVarAddr{r9}], tmp.global{r1}

@main:
	; 16 pc
	; begin initialize global variables
	const tmp.global{r8}, 0
	; end initialize global variables
	; 12:2 while true
	addrof memVarAddr{r9}, global
	store [memVarAddr{r9}], tmp.global{r8}
	jump @while_2
@if_3_end:
	; 19:3 if n < 2
	lt t.3{r8}, n{r8}, 2
	branch t.3{r8}, false, @while_2, @if_4_then
	const t.4{r1}, [string-1]
	call printString@@u8[t.4{r1}]
@while_2:
	const t.1{r1}, [string-0]
	call printString@@u8[t.1{r1}]
	call n{r0} = next[] -> u8
	move n{r8}, n{r0}
	; 15:3 if n == 3
	equals t.2{r0}, n{r8}, 3
	branch t.2{r0}, false, @if_3_end, @main_ret

@printStringLength@@u8@i64:
	mov rdx, rsi
	mov rsi, rdi
	mov rdi, 1
	mov rax, 1
	syscall
	ret

Global variables
	0: global (u8/1)

String literals
	string lit 0 "loop\n\0"
	string lit 1 "<2\n\0"
