printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	var 1: t.1 (u8*/8)
	; 8 pc
	addrof t.1, chr
	call printStringLength@@u8@u8[t.1, 1]
printChar@u8_ret:

printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	var 2: pos (u8/1)
	var 3: remainder (i64/8)
	var 4: digit (u8/1)
	var 5: t.5 (u8/1)
	var 6: t.6 (u8*/8)
	var 7: t.7 (i64/8)
	var 8: t.8 (u8*/8)
	var 9: t.9 (i64/8)
	var 10: t.10 (u8/1)
	var 11: t.11 (u8/1)
	; 84 pc
	const pos, 20
	; 33:2 while true
while_1:
	sub pos, 1
	mod remainder, number, 10
	div number, 10
	cast t.5(u8), remainder(i64)
	add digit, t.5, 48
	cast t.7(i64), pos(u8)
	addrof t.6, buffer
	add t.6, t.7
	store [t.6], digit
	; 39:3 if number == 0
	branch number notequals 0: while_1, while_1_break
while_1_break:
	cast t.9(i64), pos(u8)
	addrof t.8, buffer
	add t.8, t.9
	const t.11, 20
	sub t.10, t.11, pos
	call printStringLength@@u8@u8[t.8, t.10]
printUint@i64_ret:

printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	var 1: t.1 (i64/8)
	; 8 pc
	cast t.1(i64), number(u8)
	call printIntLf@i64[t.1]
printIntLf@u8_ret:

printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 13 pc
	; 59:2 if number < 0
	branch number gteq 0: if_3_end, if_3_then
if_3_then:
	call printChar@u8[45]
	neg number, number
if_3_end:
	call printUint@i64[number]
	call printChar@u8[10]
printIntLf@i64_ret:

printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	var 2: t.2 (i64/8)
	; 10 pc
	cast t.2(i64), length(u8)
	call printStringLength@@u8@i64[str, t.2]
printStringLength@@u8@u8_ret:

initRandom@i32:
 Local variables
	arg 0: salt (i32/4)
	var 1: t.1 (i32/4)
	var 2: a.2 (i32*/8)
	; 16 pc
	move t.1, salt
	addrof a.2, __random__
	store [a.2], t.1
initRandom@i32_ret:

random:
 Local variables
	var 0: r (i32/4)
	var 1: b (i32/4)
	var 2: c (i32/4)
	var 3: d (i32/4)
	var 4: e (i32/4)
	var 5: a.5 (i32*/8)
	var 6: t.6 (i32/4)
	var 7: t.7 (i32/4)
	var 8: t.8 (i32/4)
	var 9: t.9 (i32/4)
	var 10: t.10 (i32/4)
	var 11: t.11 (i32/4)
	var 12: t.12 (i32/4)
	var 13: t.13 (i32/4)
	var 14: a.14 (i32*/8)
	var 15: a.15 (i32*/8)
	var 16: t.16 (i32/4)
	; 103 pc
	addrof a.5, __random__
	load r, [a.5]
	and t.6, r, 524287
	mul b, t.6, 48271
	shiftright t.7, r, 15
	mul c, t.7, 48271
	and t.8, c, 65535
	shiftleft d, t.8, 15
	shiftright t.10, c, 16
	add t.9, t.10, b
	add e, t.9, d
	and t.12, e, 2147483647
	shiftright t.13, e, 31
	add t.11, t.12, t.13
	addrof a.14, __random__
	store [a.14], t.11
	; 15:9 return __random__
	addrof a.15, __random__
	load t.16, [a.15]
	ret t.16
	jump random_ret
random_ret:

randomU8:
 Local variables
	var 0: t.0 (u8/1)
	var 1: t.1 (i32/4)
	; 12 pc
	; 19:10 return (u8)
	call t.1 = random[] -> i32
	cast t.0(u8), t.1(i32)
	ret t.0
	jump randomU8_ret
randomU8_ret:

main:
 Local variables
	var 0: i (u8/1)
	var 1: r (u8/1)
	var 2: t.2 (i32/4)
	var 3: a.3 (i32*/8)
	; 31 pc
	; begin initialize global variables
	const t.2, 0
	addrof a.3, __random__
	store [a.3], t.2
	; end initialize global variables
	call initRandom@i32[7439742]
	const i, 0
	; 6:2 for i < 50
for_4:
	branch i gteq 50: main_ret, for_4_body
for_4_body:
	call r = randomU8[] -> u8
	call printIntLf@u8[r]
for_4_continue:
	add i, 1
	jump for_4
main_ret:

printStringLength@@u8@i64:
	mov rdx, rsi
	mov rsi, rdi
	mov rdi, 1
	mov rax, 1
	syscall
	ret

Global variables
	0: __random__ (i32/4)

