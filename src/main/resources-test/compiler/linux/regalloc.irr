_simple:
	const four.1{r0}, 4
	const three.1{r1}, 3
	sub one.1{r0}, three.1{r1}

_registerHint@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)

	move t.2.1{r0}, a{r1}
	add t.2.1{r0}, b{r2}

_max@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)

	branch a{r1} lt b{r2}: if_1_then
	move a{r0}, a{r1}
	jump _max@u8@u8_ret
if_1_then:
	move b{r0}, b{r2}
_max@u8@u8_ret:

_fibonacci@u8:
 Local variables
	arg 0: i (u8/1)

	const a.1{r0}, 0
	const b.1{r2}, 1
	jump while_2
while_2_body:
	sub i.2{r1}, 1
	add c.1{r0}, b.2{r2}
	move b.3{r3}, c.1{r0}
	move a.2{r0}, a.3{r2}
	move b.2{r2}, b.3{r3}
while_2:
	branch i.1{r1} gt 0: while_2_body

_main:
	call one.1{r0} = _simple[] -> u8
	move one.1{r8}, one.1{r0}
	const two.1{r9}, 2
	move one.1{r1}, one.1{r8}
	move two.1{r2}, two.1{r9}
	call _ = _registerHint@u8@u8[one.1{r1}, two.1{r2}] -> u8
	move one.1{r1}, one.1{r8}
	move two.1{r2}, two.1{r9}
	call _ = _max@u8@u8[one.1{r1}, two.1{r2}] -> u8
	const arg.3.0{r1}, 5
	call _ = _fibonacci@u8[arg.3.0{r1}] -> i16

