void _printStringLength@@u8@i64(u8* str, i64 length) asm {
}

void _printChar@u8(u8 chr) {
	_printStringLength@@u8@u8(&chr, 1);
}

void _printUint@i64(i64 number) {
	u8* buffer[20];
	u8 pos;
	i64 remainder;
	u8 digit;

	pos = 20;
	while (true) {
		pos = pos - 1;
		remainder = number % 10;
		number = number / 10;
		digit = (remainder as u8) + 48;
		buffer[pos as i64] = digit;
		if (number == 0) {
			break;
		}
	}
	_printStringLength@@u8@u8(&buffer[pos as i64], 20 - pos);
}

void _printIntLf@i16(i16 number) {
	_printIntLf@i64(number as i64);
}

void _printIntLf@i64(i64 number) {
	if (number < 0) {
		_printChar@u8(45);
		number = -number;
	}
	_printUint@i64(number);
	_printChar@u8(10);
}

void _printStringLength@@u8@u8(u8* str, u8 length) {
	_printStringLength@@u8@i64(str, length as i64);
}

i16 _printAndSum@i16@i16@i16@i16@i16@i16@i16@i16(i16 a, i16 b, i16 c, i16 d, i16 e, i16 f, i16 g, i16 h) {
	_printIntLf@i16(a);
	_printIntLf@i16(b);
	_printIntLf@i16(c);
	_printIntLf@i16(d);
	_printIntLf@i16(e);
	_printIntLf@i16(f);
	_printIntLf@i16(g);
	_printIntLf@i16(h);
	return ((((((a + b) + c) + d) + e) + f) + g) + h;
}

void _main() {
	i16 sum;

	sum = _printAndSum@i16@i16@i16@i16@i16@i16@i16@i16(1, 2, 3, 4, 5, 6, 7, 8);
	_printIntLf@i16(sum);
}
