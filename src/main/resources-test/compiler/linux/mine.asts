bool _isBomb@u8(u8 cell) {
	return (cell & 1) != 0;
}

bool _isOpen@u8(u8 cell) {
	return (cell & 2) != 0;
}

bool _isFlag@u8(u8 cell) {
	return (cell & 4) != 0;
}

bool _checkCellBounds@i16@i16(i16 row, i16 column) {
	return (((row >= 0) && (row < 20)) && (column >= 0)) && (column < 40);
