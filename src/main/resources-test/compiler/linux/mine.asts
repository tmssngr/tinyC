	}
	return 32;
}

void _printCell@u8@i16@i16(u8 cell, i16 row, i16 column) {
	u8 chr;
	u8 count;

	chr = 46;
	if (_isOpen@u8(cell)) {
		if (_isBomb@u8(cell)) {
			chr = 42;
		}
		else {
			count = _getBombCountAround@i16@i16(row, column);
			if (count > 0) {
				chr = count + 48;
			}
			else {
				chr = 32;
