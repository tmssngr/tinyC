void _printField@i16@i16(i16 rowCursor, i16 columnCursor) {
	i16 row;
	i16 column;
	u8 spacer;
	u8 cell;
	u8 spacer;

	_setCursor@i16@i16(0, 0);
	row = 0;
	for (; row < 20; row = row + 1) {
		_printChar@u8(124);
		column = 0;
		for (; column < 40; column = column + 1) {
			spacer = _getSpacer@i16@i16@i16@i16(row, column, rowCursor, columnCursor);
			_printChar@u8(spacer);
			cell = _getCell@i16@i16(row, column);
			_printCell@u8@i16@i16(cell, row, column);
		}
		spacer = _getSpacer@i16@i16@i16@i16(row, 40, rowCursor, columnCursor);
		_printChar@u8(spacer);
		_printString@@u8("|\n");
	}
}

void _printSpaces@i16(i16 i) {
	for (; i > 0; i = i - 1) {
		_printChar@u8(48);
	}
}

u8 _getDigitCount@i16(i16 value) {
	u8 count;

	count = 0;
	if (value < 0) {
		count = 1;
		value = -value;
	}
	while (true) {
		count = count + 1;
		value = value / 10;
		if (value == 0) {
			break;
		}
	}
	return count;
}

i16 _getHiddenCount() {
	i16 count;
	i16 r;
	i16 c;
	u8 cell;

	count = 0;
	r = 0;
	for (; r < 20; r = r + 1) {
		c = 0;
		for (; c < 40; c = c + 1) {
			cell = _getCell@i16@i16(r, c);
			if ((cell & 6) == 0) {
