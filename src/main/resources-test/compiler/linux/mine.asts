u8 _getBombCountAround@i16@i16(i16 row, i16 column) {
	u8 count;
	i16 dr;
	i16 r;
	i16 dc;
	i16 c;
	u8 cell;

	count = 0;
	dr = -1;
	for (; dr <= 1; dr = dr + 1) {
		r = row + dr;
		dc = -1;
		for (; dc <= 1; dc = dc + 1) {
			c = column + dc;
			if (_checkCellBounds@i16@i16(r, c)) {
				cell = _getCell@i16@i16(r, c);
				if (_isBomb@u8(cell)) {
					count = count + 1;
				}
			}
		}
	}
	return count;
}

u8 _getSpacer@i16@i16@i16@i16(i16 row, i16 column, i16 rowCursor, i16 columnCursor) {
	if (rowCursor == row) {
		if (columnCursor == column) {
			return 91;
		}
		if (columnCursor == (column - 1)) {
