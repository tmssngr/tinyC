@printChar@u8:
 Local variables
	arg 0: chr (u8/1)
	; 9 pc
	addrof memVarAddr{r9}, chr
	store [memVarAddr{r9}], chr{r1}
	addrof t.1{r1}, chr
	const arg.0.1{r2}, 1
	call printStringLength@@u8@u8[t.1{r1}, arg.0.1{r2}]

@printUint@i64:
 Local variables
	arg 0: number (i64/8)
	var 1: buffer[] (u8*/20)
	; 23 pc
	const pos{r8}, 20
	; 33:2 while true
@while_1:
	sub pos{r8}, pos{r8}, 1
	move remainder{r5}, number{r1}
	move remainder{r0}, remainder{r5}
	mod remainder{r3}, remainder{r0}, 10
	move remainder{r5}, remainder{r3}
	move number{r0}, number{r1}
	div number{r0}, number{r0}, 10
	move number{r1}, number{r0}
	cast t.5{r0}(u8), remainder{r5}(i64)
	add digit{r0}, digit{r0}, 48
	cast t.7{r3}(i64), pos{r8}(u8)
	addrof t.6{r4}, [buffer]
	add t.6{r4}, t.6{r4}, t.7{r3}
	store [t.6{r4}], digit{r0}
	; 39:3 if number == 0
	equals t.8{r0}, number{r1}, 0
	branch t.8{r0}, false, @while_1, @while_1_break
	cast t.10{r0}(i64), pos{r8}(u8)
	addrof t.9{r1}, [buffer]
	add t.9{r1}, t.9{r1}, t.10{r0}
	const t.12{r0}, 20
	move t.11{r2}, t.12{r0}
	sub t.11{r2}, t.11{r2}, pos{r8}
	call printStringLength@@u8@u8[t.9{r1}, t.11{r2}]

@printIntLf@u8:
 Local variables
	arg 0: number (u8/1)
	; 2 pc
	cast t.1{r1}(i64), number{r1}(u8)
	call printIntLf@i64[t.1{r1}]

@printIntLf@i64:
 Local variables
	arg 0: number (i64/8)
	; 8 pc
	move number{r8}, number{r1}
	; 59:2 if number < 0
	lt t.1{r9}, number{r8}, 0
	branch t.1{r9}, false, @if_3_end, @if_3_then
	const arg.0.0{r1}, 45
	call printChar@u8[arg.0.0{r1}]
	neg number{r8}, number{r8}
@if_3_end:
	move number{r1}, number{r8}
	call printUint@i64[number{r1}]
	const arg.2.0{r1}, 10
	call printChar@u8[arg.2.0{r1}]

@printStringLength@@u8@u8:
 Local variables
	arg 0: str (u8*/8)
	arg 1: length (u8/1)
	; 2 pc
	cast t.2{r2}(i64), length{r2}(u8)
	call printStringLength@@u8@i64[str{r1}, t.2{r2}]

@main:
 Local variables
	var 0: t.1 (u8/1)
	var 1: t.2 (u8/1)
	var 2: t.3 (u8/1)
	; 44 pc
	; begin initialize global variables
	const tmp.i{r8}, 0
	; end initialize global variables
	addrof memVarAddr{r9}, i
	store [memVarAddr{r9}], tmp.i{r8}
	call t.0{r0} = next[] -> u8
	move t.0{r8}, t.0{r0}
	call t.1{r0} = next[] -> u8
	addrof memVarAddr{r9}, t.1
	store [memVarAddr{r9}], t.1{r0}
	call t.2{r0} = next[] -> u8
	addrof memVarAddr{r9}, t.2
	store [memVarAddr{r9}], t.2{r0}
	call t.3{r0} = next[] -> u8
	addrof memVarAddr{r9}, t.3
	store [memVarAddr{r9}], t.3{r0}
	call t.4{r0} = next[] -> u8
	move t.0{r1}, t.0{r8}
	addrof memVarAddr{r9}, t.1
	load t.1{r2}, [memVarAddr{r9}]
	addrof memVarAddr{r9}, t.2
	load t.2{r3}, [memVarAddr{r9}]
	addrof memVarAddr{r9}, t.3
	load t.3{r4}, [memVarAddr{r9}]
	move t.4{r5}, t.4{r0}
	call doPrint@u8@u8@u8@u8@u8[t.0{r1}, t.1{r2}, t.2{r3}, t.3{r4}, t.4{r5}]

@next:
	; 11 pc
	addrof memVarAddr{r9}, i
	load tmp.i{r0}, [memVarAddr{r9}]
	add tmp.i{r0}, tmp.i{r0}, 1
	; 11:9 return i
	addrof memVarAddr{r9}, i
	store [memVarAddr{r9}], tmp.i{r0}

@doPrint@u8@u8@u8@u8@u8:
 Local variables
	arg 0: a (u8/1)
	arg 1: b (u8/1)
	arg 2: c (u8/1)
	arg 3: d (u8/1)
	arg 4: e (u8/1)
	; 40 pc
	move b{r8}, b{r2}
	addrof memVarAddr{r9}, c
	store [memVarAddr{r9}], c{r3}
	addrof memVarAddr{r9}, d
	store [memVarAddr{r9}], d{r4}
	addrof memVarAddr{r9}, e
	store [memVarAddr{r9}], e{r5}
	call printIntLf@u8[a{r1}]
	move b{r1}, b{r8}
	call printIntLf@u8[b{r1}]
	addrof memVarAddr{r9}, c
	load c{r3}, [memVarAddr{r9}]
	move c{r1}, c{r3}
	call printIntLf@u8[c{r1}]
	addrof memVarAddr{r9}, d
	load d{r4}, [memVarAddr{r9}]
	move d{r1}, d{r4}
	call printIntLf@u8[d{r1}]
	addrof memVarAddr{r9}, e
	load e{r5}, [memVarAddr{r9}]
	move e{r1}, e{r5}
	call printIntLf@u8[e{r1}]

@printStringLength@@u8@i64:
	mov rdx, rsi
	mov rsi, rdi
	mov rdi, 1
	mov rax, 1
	syscall
	ret

Global variables
	0: i (u8/1)

