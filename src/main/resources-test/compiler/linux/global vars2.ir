	store [a.2], t.1
while_2:
	const t.3, [string-0]
	call printString@@u8[t.3]
	call n = next[] -> u8
	branch n equals 3: main_ret, if_3_end
if_3_end:
	branch n gteq 2: while_2, if_4_then
if_4_then:
	const t.4, [string-1]
	call printString@@u8[t.4]
	jump while_2
