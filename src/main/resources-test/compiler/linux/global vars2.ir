	add t.2, t.4, 1
	addrof a.5, global
	store [a.5], t.2
	ret copy
	jump next_ret
next_ret:

main:
 Local variables
	var 0: n (u8/1)
	var 1: t.1 (u8/1)
	var 2: a.2 (u8*/8)
	var 3: t.3 (u8*/8)
	var 4: t.4 (u8*/8)
	; 35 pc
