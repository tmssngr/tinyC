for_1_body:
	add length, 1
for_1_continue:
	add str, 1
	jump for_1
for_1_break:
	ret length
	jump strlen@@u8_ret
strlen@@u8_ret:

next:
 Local variables
	var 0: copy (u8/1)
	var 1: a.1 (u8*/8)
	var 2: t.2 (u8/1)
	var 3: a.3 (u8*/8)
