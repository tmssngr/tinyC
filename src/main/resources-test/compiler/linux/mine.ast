	if (revealStackSize != 255) {
		return;
	}
	changed = true;
	while (changed) {
		changed = false;
		index = 0;
		r = 0;
		for (; r < 20; r = r + 1) {
			c = 0;
			for (; c < 40; c = c + 1, index = index + 1) {
				cell = field[index as i64];
				if (((cell & 32) == 0) || ((cell & 128) != 0)) {
