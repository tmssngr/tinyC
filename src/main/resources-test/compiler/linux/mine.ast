	revealStackRows[stackSize as i64] = row;
	revealStackColumns[stackSize as i64] = column;
	*revealStackIndexTop = index;
	revealStackIndexTop = revealStackIndexTop + (1 * 2);
	revealStackSize = stackSize + 1;
