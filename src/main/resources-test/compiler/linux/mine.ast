bool revealNeighbors@u8@u8@i16(u8 row, u8 column, i16 index) {
	u8 rowFrom;
	u8 rowTo;
	u8 colFrom;
	u8 colTo;
	bool changed;
	u8 r;
	u8 c;
	u8 cell;

	rowFrom = row;
