	bombsLeft = -1;
	while (true) {
		if (bombsLeft == 0) {
			printString@@u8(" You've cleaned the field!");
			break;
		}
		showCursor@u8@u8@bool(row, col, true);
		chr = getChar();
		showCursor@u8@u8@bool(row, col, false);
