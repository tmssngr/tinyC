i16 initField@u8@u8(u8 curr_r, u8 curr_c) {
	i16 r;
	i16 c;
	i16 bombCount;
	i16 bombs;
	i16 row;
	i16 column;

	r = curr_r as i16;
	c = curr_c as i16;
	bombCount = 0;
	bombs = 72;
	for (; bombs > 0; bombs = bombs - 1) {
		row = (random16()) % 20;
		column = (random16()) % 40;
		if (((abs@i16(row - r)) > 1) || ((abs@i16(column - c)) > 1)) {
			if (setBomb@u8@u8(row as u8, column as u8)) {
				bombCount = bombCount + 1;
