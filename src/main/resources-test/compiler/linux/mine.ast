bool setBomb@u8@u8(u8 row, u8 column) {
	i16 index;
	u8 rowFrom;
	u8 rowTo;
	u8 colFrom;
	u8 colTo;
	u8 count;
	u8 r;
	u8 c;
	u8 cell;
	u8 count;

	index = rowColumnToCell@u8@u8(row, column);
	if (field[index as i64] == 128) {
		return false;
	}
	field[index as i64] = 128;
	rowFrom = row;
	if (rowFrom > 0) {
		rowFrom = rowFrom - 1;
		index = index - 40;
	}
	rowTo = row + 1;
	if (rowTo >= 20) {
		rowTo = rowTo - 1;
	}
	colFrom = column;
	if (colFrom > 0) {
		colFrom = colFrom - 1;
		index = index - 1;
	}
	colTo = column + 1;
	if (colTo >= 40) {
		colTo = colTo - 1;
	}
	count = 0;
	r = rowFrom;
	for (; r <= rowTo; r = r + 1) {
		c = colFrom;
		for (; c <= colTo; c = c + 1, index = index + 1) {
			if ((r == row) && (c == column)) {
				continue;
			}
			cell = field[index as i64];
			if ((cell & 128) == 0) {
				count = cell & 15;
				count = count + 1;
				field[index as i64] = count;
			}
		}
		index = (((index - (colTo as i16)) + (colFrom as i16)) + 40) - 1;
	}
	return true;
}

void maybeRevealAround@u8@u8(u8 row, u8 column) {
	i16 index;
	u8 stackSize;
	i16* stackIndex;
	bool changed;
	u8 r;
	u8 c;
	u8 cell;
	u8 r;
	u8 c;
	u8 cell;

	printCellAt@u8@u8(row, column);
	index = rowColumnToCell@u8@u8(row, column);
	if ((field[index as i64] & 15) != 0) {
		return;
	}
	revealStackRows[0] = row;
	revealStackColumns[0] = column;
	*revealStackIndices = index;
	revealStackIndexTop = revealStackIndices + (1 * 2);
	revealStackSize = 1;
	while (revealStackSize > 0) {
		stackSize = revealStackSize - 1;
		revealStackSize = stackSize;
		row = revealStackRows[stackSize as i64];
		column = revealStackColumns[stackSize as i64];
		stackIndex = revealStackIndexTop + (-1 * 2);
		revealStackIndexTop = stackIndex;
		index = *stackIndex;
		revealNeighbors@u8@u8@i16(row, column, index);
		if (revealStackSize == 255) {
			break;
		}
