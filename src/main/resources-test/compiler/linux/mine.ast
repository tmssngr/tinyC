		}
		column = 0;
		for (; column < 40; column = column + 1) {
			if (!(false)) {
				printChar@u8(32);
			}
			cell = field[(rowColumnToCell@u8@u8(row, column)) as i64];
			printCell@u8@u8@u8(cell, row, column);
		}
		if (!(false)) {
			printString@@u8(" |");
