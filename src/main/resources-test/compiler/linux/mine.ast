			}
			index = rowColumnToCell@u8@u8(row, col);
			cell = field[index as i64];
			if ((cell & 32) == 0) {
				field[index as i64] = cell | 32;
			}
			if ((cell & 128) != 0) {
				printCellAt@u8@u8(row, col);
				printString@@u8("boom! you've lost");
				break;
			}
			maybeRevealAround@u8@u8(row, col);
		}
		else {
			if (chr == (57416 as i16)) {
				if (row > 0) {
					row = row - 1;
				}
			}
			else {
				if (chr == (57424 as i16)) {
					if (row < (20 - 1)) {
						row = row + 1;
					}
