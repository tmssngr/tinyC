}

void initializeScreen() {
	printField();
}

void printField() {
	u8 row;
	u8 column;
	u8 cell;

	setCursor@i16@i16(0, 0);
	row = 0;
	for (; row < 20; row = row + 1) {
		setCursor@i16@i16(row as i16, 0);
		if (!(false)) {
