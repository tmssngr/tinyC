	changed = false;
	r = rowFrom;
	for (; r <= rowTo; r = r + 1) {
		c = colFrom;
		for (; c <= colTo; c = c + 1, index = index + 1) {
			cell = field[index as i64];
			if ((cell & 32) != 0) {
				continue;
			}
			cell = cell | 32;
			field[index as i64] = cell;
			printCellAt@u8@u8@u8(cell, r, c);
			changed = true;
			if (((cell & (128 | 15)) == 0) && (revealStackSize != 255)) {
				pushReveal@u8@u8@i16(r, c, index);
			}
		}
		index = (((index - (colTo as i16)) + (colFrom as i16)) + 40) - 1;
	}
	return changed;
}

void main() {
	u8 col;
	u8 row;
	i16 bombsLeft;
	i16 chr;
	i16 index;
	u8 cell;
	i16 index;
	u8 cell;

	initRandom@i32(7439742);
	clearField();
	initializeScreen();
	setCursor@i16@i16(20, 0);
	col = 40 / 2;
